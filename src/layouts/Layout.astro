---
import '../styles/global.css';
import HeroScene from '../components/three/HeroScene';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  theme?: 'dark' | 'light';
  showScene?: boolean;
}

const { title = 'Ralvie AI', description = 'Transform your workflow with intelligent automation.', image = '/og-image.png', theme = 'dark', showScene = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="theme-color" content={theme === 'light' ? '#f8f9ff' : '#101415'} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Hanken+Grotesk:wght@500;600&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>

  <body class:list={["min-h-screen text-on-background", theme === 'light' && 'theme-light']}>
    {showScene && <div class="atmosphere-bg pointer-events-none fixed inset-0 -z-10"><HeroScene client:load /></div>}

    <slot />
  </body>
</html>

<style>
  :global(html),
  :global(body) {
    margin: 0;
    padding: 0;
    width: 100%;
  }
</style>
