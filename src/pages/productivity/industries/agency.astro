---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Icon from '../../../components/Icon.astro';
import ProductivityFinalCta from '../../../components/ProductivityFinalCta.astro';
import { Image } from 'astro:assets';
import agencyHeroImage from '../../../assets/agency hero section image.jpg';
import ralvieLogoIcon from '../../../assets/Ralvie-logo-icon.svg';
import '../../../styles/agency-industry.css';

const title = 'AI Productivity & Time Tracking Software for Agencies | Ralvie AI';
const description = 'Help agency teams understand where time and effort go with automatic activity capture, client project mapping, AI timesheets, workload analytics, and work summaries.';
const faqs = [
  ['What is Ralvie AI Productivity for agencies?', 'Ralvie helps agencies capture relevant workplace activity, connect time with clients, projects and tasks, create AI-assisted timesheets and summaries, and understand workload and project effort.'],
  ['Does my team need to start and stop timers?', 'Ralvie is designed to reduce dependence on manual timers through configured automatic activity capture.'],
  ['Can work be connected to client projects?', 'Yes. AI-assisted workflows can help associate relevant activity with clients, projects, and tasks.'],
  ['Can Ralvie generate weekly project summaries?', 'Ralvie Summary Agent can help create daily, weekly, and custom-period summaries from relevant work context.'],
  ['Can Ralvie help with project estimates?', 'Historical project and task effort can provide useful context for estimating similar work in the future.'],
  ['Can Ralvie help understand team capacity?', 'Workload and allocation views help managers understand where capacity is committed and where room may exist.'],
  ['Does Ralvie calculate project profitability?', 'Ralvie provides time and effort context that can support profitability analysis, but it should not be treated as a financial accounting system.'],
  ['Is Ralvie designed to monitor creative employees?', 'No. Ralvie is positioned as productivity and work intelligence. Data should be interpreted with role, complexity, quality, workload, and outcomes.'],
];
const schema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---
<Layout title={title} description={description} theme="light" showScene={false}>
  <Header title="Ralvie AI" theme="light"/><script type="application/ld+json" is:inline set:html={JSON.stringify(schema)}/>
  <main class="agency-page pt-(--header-height)">
    <section class="agency-hero agency-mesh"><div class="agency-shell hero-grid">
      <div class="hero-copy"><span class="agency-pill">RALVIE AI PRODUCTIVITY FOR AGENCIES</span><h1 class="industry-title-lines"><span>Know Where Your Agency&#8217;s</span><span>Time Goes—and Make</span><span><em>Every Project Count.</em></span></h1><p class="industry-description-lines"><span>Automatically capture relevant work activity and connect it</span><span>with client projects and tasks. Give agency leaders clearer</span><span>visibility into project effort and team capacity.</span></p><div class="agency-actions"><a href="https://me.ralvie.ai/auth/login" target="_blank" rel="noopener noreferrer" class="agency-primary">Start your free trial <Icon name="arrow-right"/></a><a href="#get-started" class="agency-secondary"><Icon name="calendar"/> Book a demo</a></div><small>Automatic tracking · Client visibility · AI timesheets · Team workload · Project intelligence</small></div>
      <div class="agency-hero-visual"><Image src={agencyHeroImage} alt="Agency professionals collaborating on client work" class="agency-hero-image" widths={[640,960,1280]} sizes="(max-width:920px) 100vw, 53vw" loading="eager"/>
        <div class="hero-mini"><span><Icon name="briefcase"/></span><div><small>ACTIVE CLIENTS</small><strong>24</strong><em>+3 this month</em></div></div>
        <div class="hero-report"><header><div><small>PROJECT PERFORMANCE</small><strong>Northline Website Redesign</strong></div><span>This month⌄</span></header><div class="report-stats"><div><small>Tracked effort</small><b>184h</b></div><div><small>Budget used</small><b>72%</b></div><div><small>Project health</small><b class="good">On track</b></div></div><div class="report-bars"><span><i style="--w:72%"></i></span><footer><small>Delivery progress</small><b>72 / 100%</b></footer></div></div>
      </div>
    </div></section>

    <section class="section agency-intro"><div class="agency-shell intro-grid"><div><span class="eyebrow">AGENCY WORK INTELLIGENCE</span><h2>Client work happens everywhere. <em>Ralvie helps connect it.</em></h2><p>A single workday moves between client meetings, creative production, campaign management, research, reporting, email, and multiple accounts.</p></div><div class="client-orbit"><div class="orbit-core"><img src={ralvieLogoIcon.src} alt="Ralvie AI" /><b>Work context</b></div>{[['megaphone','Campaigns'],['sparkles','Creative'],['monitor','Development'],['document','Reporting'],['chat','Client comms'],['users','Meetings']].map(([i,n],x)=><article class={`orbit-${x}`}><Icon name={i}/><span>{n}</span></article>)}</div></div></section>

    <section class="section auto-section"><div class="agency-shell split"><div class="copy"><span class="eyebrow">AUTOMATIC ACTIVITY TRACKING</span><h2>Let your team focus on client work—<em>not the clock.</em></h2><p>Ralvie Sundial captures configured workplace context while creative, strategy, account, and delivery teams continue working in their existing tools.</p><div class="capture-grid">{[['monitor','Applications'],['document','Documents & windows'],['clock','Work sessions'],['bolt','Active time'],['refresh','Offline activity'],['shield-check','Privacy controls']].map(([i,n],x)=><span class={`capture-${x}`}><Icon name={i}/>{n}</span>)}</div></div><div class="day-stream agency-glass"><header><div><small>WORKDAY STREAM</small><h3>Tuesday · Client delivery</h3></div><b>7h 36m</b></header>{[['09:00','Northline Hotels','Campaign review','1h 18m'],['10:30','Brightpath Health','Design production','2h 12m'],['13:30','Internal','Creative planning','46m'],['14:16','Aster Finance','Website build','2h 34m']].map(([t,c,n,h],x)=><article><time>{t}</time><span class={`stream-${x}`}></span><div><small>{c}</small><b>{n}</b></div><strong>{h}</strong></article>)}</div></div></section>

    <section class="section timesheet"><div class="agency-shell"><div class="section-head centered"><span class="eyebrow">AI TIMESHEETS</span><h2>Turn work that already happened into <em>better time records.</em></h2><p>Reduce end-of-week reconstruction for people working across several clients in one day.</p></div><div class="timesheet-flow">{[['bolt','Activity captured','Work happens normally'],['sparkles','AI adds context','Relevant work is understood'],['briefcase','Client mapping','Activity connects to accounts'],['list-check','Task mapping','Specific delivery context'],['check','Employee review','A clear record is ready']].map(([i,n,p],x)=><article class={`step-${x}`}><span><Icon name={i}/></span><small>0{x+1}</small><h3>{n}</h3><p>{p}</p></article>)}</div></div></section>

    <section class="section clients-dark"><div class="agency-shell split"><div class="client-board dark-glass"><header><div><small>CLIENT PORTFOLIO</small><h3>Effort by account</h3></div><span>624h total</span></header>{[['Northline Hotels','Website redesign','184h','92%'],['Brightpath Health','Brand campaign','142h','71%'],['Aster Finance','Content program','118h','59%'],['Living Water','Paid media','96h','48%'],['Morrow Labs','Research','84h','42%']].map(([c,p,h,w],x)=><article><span>{x+1}</span><div><b>{c}</b><small>{p}</small><i><em style={`--w:${w}`}></em></i></div><strong>{h}</strong></article>)}<footer><Icon name="sparkles"/><p>Northline Hotels consumed 18% more delivery effort than planned, concentrated in revision cycles.</p></footer></div><div class="copy light"><span class="eyebrow">CLIENT & PROJECT VISIBILITY</span><h2>Understand which accounts are consuming <em>your team’s effort.</em></h2><p>Give every hour meaningful client, project, and task context. See the work behind each account before margins are squeezed.</p><ul><li>Compare project effort with expectations</li><li>Identify expanding revision cycles</li><li>Support clearer client reporting</li><li>Build better future estimates</li></ul></div></div></section>

    <section class="section"><div class="agency-shell"><div class="section-head"><span class="eyebrow">PROJECT INTELLIGENCE</span><h2>See when project effort <em>starts to drift.</em></h2></div><div class="project-cards"><article class="project-feature agency-glass"><header><div><small>CLIENT WEBSITE PROJECT</small><h3>Planned vs actual effort</h3></div><span class="risk">Needs attention</span></header><div class="effort-comparison"><div><small>Planned</small><strong>120h</strong><span><i style="--w:63%"></i></span></div><div><small>Actual context</small><strong>168h</strong><span><i style="--w:88%"></i></span></div></div><footer><b>+48h</b><p>Additional effort across feedback, revisions, and responsive QA.</p></footer></article><div class="task-stack">{[['Design revisions','38h','+14h'],['Responsive development','44h','+8h'],['QA & testing','26h','+11h']].map(([n,h,d],x)=><article class={`task-${x}`}><span><Icon name={x===0?'sparkles':x===1?'monitor':'check'}/></span><div><h3>{n}</h3><small>Actual task effort</small></div><strong>{h}<em>{d}</em></strong></article>)}</div></div></div></section>

    <section class="section capacity-mesh"><div class="agency-shell split"><div class="copy"><span class="eyebrow">CAPACITY VISIBILITY</span><h2>Know whether your team can handle <em>the next client.</em></h2><p>Understand current client allocation, internal overhead, competing priorities, and the specialists spread across too many accounts.</p><div class="allocation-chips">{['Hire','Reallocate','Adjust scope','Change timing'].map(x=><span>{x}</span>)}</div></div><div class="capacity-card agency-glass"><header><div><small>TEAM CAPACITY</small><h3>Delivery allocation</h3></div><span>Current week⌄</span></header>{[['Creative','88%','High'],['Development','79%','Balanced'],['Strategy','92%','High'],['Accounts','68%','Balanced'],['Operations','52%','Available']].map(([n,v,s],x)=><article><div><b>{n}</b><small>{s}</small></div><span><i class={`cap-${x}`} style={`--w:${v}`}></i></span><strong>{v}</strong></article>)}<footer><Icon name="sparkles"/><p>Operations has capacity; strategy is supporting six concurrent accounts.</p></footer></div></div></section>

    <section class="section summary"><div class="agency-shell summary-grid"><div class="summary-panel agency-glass"><header><span><Icon name="sparkles"/></span><div><small>RALVIE SUMMARY AGENT</small><h3>Weekly Client Update</h3></div><button>Share</button></header><p>The team completed the homepage design system and began responsive development. Client feedback added a new comparison section, while QA preparation moved ahead of schedule.</p><div class="summary-metrics"><span><small>Tasks completed</small><b>18</b></span><span><small>Delivery time</small><b>42h</b></span><span><small>Revision effort</small><b>8h</b></span></div></div><div class="copy"><span class="eyebrow">AI WORK SUMMARIES</span><h2>Let project activity help <em>write the update.</em></h2><p>Create daily, weekly, or custom-period summaries so internal updates and client conversations begin with useful context.</p></div></div></section>

    <section class="section role-section"><div class="agency-shell"><div class="section-head centered"><span class="eyebrow">THE RIGHT VIEW FOR EVERY ROLE</span><h2>One productivity layer. <em>Different agency decisions.</em></h2></div><div class="role-grid">{[['briefcase','Agency owners','Portfolio effort, utilization, capacity, and growth context.'],['chart-bar','Operations leads','Work distribution, overhead, and resource planning.'],['folder','Project managers','Project drift, task effort, and delivery progress.'],['chat','Account managers','Client activity, updates, and scope context.'],['user','Employees','Personal workday, timesheets, and summaries.']].map(([i,n,p],x)=><article class={`role-${x}`}><span><Icon name={i}/></span><h3>{n}</h3><p>{p}</p></article>)}</div></div></section>

    <section class="section responsible"><div class="agency-shell"><div class="responsible-card"><div><span class="eyebrow">RESPONSIBLE WORK VISIBILITY</span><h2>Better data should reduce interruptions—<em>not create more monitoring.</em></h2><p>Use productivity context to improve workload, planning, focus, and client delivery—not to judge creative talent by isolated activity metrics.</p></div><div class="principles">{[['shield-check','Configurable policies'],['heart','Employee context'],['users','Role-based visibility'],['sparkles','Creative work respected']].map(([i,n],x)=><span class={`principle-${x}`}><Icon name={i}/>{n}</span>)}</div></div></div></section>

    <section class="section faq"><div class="agency-shell faq-grid"><div class="section-head"><span class="eyebrow">FREQUENTLY ASKED QUESTIONS</span><h2>Agency productivity, <em>explained.</em></h2><p>Clearer work context without another spreadsheet.</p></div><div class="faq-list">{faqs.map(([q,a],x)=><details open={x===0}><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></div></section>
    <ProductivityFinalCta />
  </main><Footer theme="light"/>
  <style>.orbit-core>img{display:block;width:52px;height:52px;object-fit:contain}.client-orbit{background:transparent}</style>
</Layout>
