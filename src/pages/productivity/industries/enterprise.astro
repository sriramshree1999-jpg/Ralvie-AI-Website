---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Icon from '../../../components/Icon.astro';
import ProductivityFinalCta from '../../../components/ProductivityFinalCta.astro';
import { Image } from 'astro:assets';
import enterpriseHeroImage from '../../../assets/enterprise hero section image.jpg';
import '../../../styles/enterprise.css';

const title = 'Enterprise Workforce Productivity & Analytics Platform | Ralvie AI';
const description = 'Give enterprise leaders clearer visibility into workforce activity, time, projects, tasks, workload, and productivity with Ralvie AI Productivity.';
const faqs = [
  ['What is Ralvie AI Productivity for Enterprise?', 'A workforce productivity and work-intelligence platform that connects relevant workplace activity with time, projects, tasks, AI-assisted timesheets, summaries, and organization-wide reporting.'],
  ['Can Ralvie support large organizations?', 'Ralvie is designed for organizational productivity workflows. Specific scale, architecture, security, and deployment requirements are evaluated with the Ralvie enterprise team.'],
  ['Does Ralvie automatically track employee activity?', 'Ralvie Sundial can automatically capture applicable workplace activity according to your organization’s configured settings.'],
  ['Can activity be mapped to projects and tasks?', 'Yes. AI-assisted workflows can help associate relevant activity with projects and tasks.'],
  ['Can managers understand team workload?', 'Role-aware dashboards can provide context around workload, project allocation, time distribution, and productivity patterns.'],
  ['Can Ralvie help with capacity planning?', 'Workload, allocation, and time-distribution data provide useful evidence for workforce capacity and resource decisions.'],
  ['Does Ralvie support remote and hybrid employees?', 'Yes. Ralvie can support remote, hybrid, office-based, and distributed working environments.'],
  ['How does Ralvie protect employee privacy?', 'Configurable tracking and workplace settings support responsible workflows aligned with internal policy, permissions, and applicable privacy requirements.'],
];
const schema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
const levels = [['user','Individual','Personal activity and time distribution'],['users','Team','Workload, patterns, and contribution'],['folder','Project','Effort across initiatives and tasks'],['building','Department','Compare allocation across functions'],['globe','Organization','See where workforce capacity is invested']];
const features = [['monitor','Automatic activity','Capture supported applications, work windows, sessions, and offline activity.'],['clock','AI timesheets','Turn workplace context into structured time records that are easier to review.'],['folder','Project intelligence','Connect everyday effort with projects, tasks, and strategic initiatives.'],['users','Workload visibility','Understand workload concentration, capacity, and competing priorities.'],['sparkles','AI summaries','Create daily, weekly, and custom-period updates without status chasing.'],['chart-bar','Enterprise reporting','Explore organization, department, project, team, and employee views.']];
---
<Layout title={title} description={description} theme="light" showScene={false}>
  <Header title="Ralvie AI" theme="light"/><script type="application/ld+json" is:inline set:html={JSON.stringify(schema)}/>
  <main class="enterprise-page pt-(--header-height)">
    <section class="enterprise-hero"><div class="enterprise-shell hero-grid">
      <div class="hero-copy"><span class="eyebrow">RALVIE AI PRODUCTIVITY FOR ENTERPRISE</span><h1 class="industry-title-lines"><span>Turn Workforce</span><span>Activity Into</span><span><em>Enterprise Intelligence.</em></span></h1><p class="industry-description-lines"><span>Understand how work happens across teams, projects,</span><span>departments, and locations—without adding more</span><span>manual reporting for employees.</span></p><div class="hero-actions"><a href="https://me.ralvie.ai/auth/login" target="_blank" rel="noopener noreferrer" class="primary-btn">Start your free trial <Icon name="arrow-right"/></a><a href="#get-started" class="secondary-btn"><Icon name="calendar"/> Book a demo</a></div><small>Workforce analytics · AI timesheets · Workload visibility · Project intelligence</small></div>
      <div class="hero-visual">
        <Image src={enterpriseHeroImage} alt="Enterprise team collaborating with Ralvie AI Productivity" class="hero-image" widths={[640,960,1280]} sizes="(max-width: 900px) 100vw, 52vw" loading="eager"/>
        <div class="floating-screen floating-small"><span><Icon name="users"/></span><div><small>ACTIVE EMPLOYEES</small><strong>1,248</strong><em>+3.2%</em></div></div>
        <div class="floating-screen floating-medium"><header><div><small>WORKFORCE ALLOCATION</small><strong>Enterprise overview</strong></div><span>30 days⌄</span></header><div class="mini-kpis"><div><small>Tracked time</small><b>42,680h</b></div><div><small>Projects</small><b>186</b></div><div><small>Completed</small><b>4,824</b></div></div><div class="mini-chart">{[44,61,53,76,65,88,72,92].map(h=><i style={`--h:${h}%`}></i>)}</div><footer><span>Workforce activity</span><b>+8.4%</b></footer></div>
      </div>
    </div></section>

    <section class="enterprise-intro"><div class="enterprise-shell intro-grid"><span class="eyebrow">ENTERPRISE WORKFORCE VISIBILITY</span><div><h2>Enterprise productivity needs more than <em>timesheets.</em></h2><p>At enterprise scale, the real challenge is understanding where thousands of work hours go, how workload is distributed, which projects consume resources, and whether effort aligns with business priorities.</p></div></div><div class="enterprise-shell levels">{levels.map(([icon,name,text],i)=><><article><span><Icon name={icon}/></span><b>{name}</b><p>{text}</p></article>{i<4&&<i>→</i>}</>)}</div></section>

    <section class="section soft"><div class="enterprise-shell"><div class="section-head"><span class="eyebrow">CONNECTED PRODUCTIVITY INTELLIGENCE</span><h2>One activity layer. <em>Multiple levels of visibility.</em></h2><p>Bring everyday work signals together and give every level of the organization the context it needs.</p></div><div class="feature-grid">{features.map(([icon,name,text])=><article><span><Icon name={icon}/></span><h3>{name}</h3><p>{text}</p></article>)}</div></div></section>

    <section class="section"><div class="enterprise-shell split"><div class="copy"><span class="eyebrow">CAPACITY & WORKLOAD VISIBILITY</span><h2>Understand the capacity you already have <em>before adding headcount.</em></h2><p>See workload imbalances hidden inside departments, projects competing for specialists, and teams with room to support new priorities.</p><ul><li>Compare allocation by team and department</li><li>Spot sustained workload pressure</li><li>See initiatives consuming more effort than expected</li><li>Support hiring and reallocation with real context</li></ul></div><div class="enterprise-screen capacity-screen"><header><div><small>CAPACITY OVERVIEW</small><h3>Department workload</h3></div><span>This month⌄</span></header>{[['Engineering','Higher workload','88%'],['Implementation','Higher workload','82%'],['Customer success','Balanced','68%'],['Operations','Available capacity','52%'],['Finance','Balanced','61%']].map(([team,status,value],i)=><div class="capacity-row"><div><b>{team}</b><small class={`s-${i}`}>{status}</small></div><span><i style={`--w:${value}`}></i></span><strong>{value}</strong></div>)}<div class="capacity-note"><Icon name="sparkles"/><p><b>Capacity signal</b> Operations may have capacity to support the systems migration program.</p></div></div></div></section>

    <section class="section strategy"><div class="enterprise-shell"><div class="section-head centered"><span class="eyebrow">STRATEGIC ALIGNMENT</span><h2>See where the organization is <em>actually investing time.</em></h2><p>Compare leadership priorities with the workforce effort being spent today.</p></div><div class="strategy-grid"><div class="enterprise-screen initiative-screen"><header><div><small>TOP INITIATIVES BY EFFORT</small><h3>Portfolio allocation</h3></div><span>Q2 2026⌄</span></header>{[['Platform modernization','12,840h','84%'],['Customer experience program','8,620h','66%'],['AI automation','6,480h','51%'],['International expansion','4,910h','39%']].map(([n,h,w],i)=><div class="initiative"><span>{i+1}</span><div><b>{n}</b><i><em style={`--w:${w}`}></em></i></div><strong>{h}</strong></div>)}</div><div class="question-card"><span class="eyebrow">ASK BETTER QUESTIONS</span><h3>Turn operational data into planning context.</h3>{['Which initiatives received the most effort?','Where is workload concentrated?','Which projects exceeded estimates?','Are resources aligned with priorities?'].map(x=><p><Icon name="check"/>{x}</p>)}</div></div></div></section>

    <section class="section roles"><div class="enterprise-shell"><div class="section-head centered"><span class="eyebrow">INTELLIGENCE FOR EVERY ROLE</span><h2>Different dashboard. <em>Different decision.</em></h2></div><div class="role-grid">{[['briefcase','Executives','Organization trends, strategic allocation, and capacity.'],['users','Managers','Team workload, work distribution, and progress.'],['target','Project leaders','Project effort, contributors, tasks, and delivery context.'],['monitor','Employees','Personal activity, workday review, and clearer timesheets.']].map(([icon,n,p])=><article><span><Icon name={icon}/></span><h3>{n}</h3><p>{p}</p><a href="#demo">Explore view <Icon name="arrow-right"/></a></article>)}</div></div></section>

    <section class="section dark-section"><div class="enterprise-shell"><div class="section-head centered"><span class="eyebrow">HOW IT WORKS</span><h2>From everyday activity to <em>enterprise-level intelligence.</em></h2></div><div class="steps">{[['01','Understand your organization'],['02','Deploy Ralvie Sundial'],['03','Work continues normally'],['04','Activity becomes context'],['05','AI reduces reporting'],['06','Leaders see broader trends']].map(([n,t])=><article><span>{n}</span><b>{t}</b></article>)}</div><div class="security"><Icon name="shield-check"/><div><h3>Built around responsible workforce data.</h3><p>Configure access controls, role-based visibility, workplace policies, data handling, privacy, and governance around your organization’s requirements.</p></div><a href="#demo">Discuss requirements →</a></div></div></section>

    <section class="section faq"><div class="enterprise-shell faq-layout"><div class="section-head"><span class="eyebrow">FREQUENTLY ASKED QUESTIONS</span><h2>Enterprise productivity, <em>explained.</em></h2><p>Talk with our team about your scale, systems, security, and deployment requirements.</p></div><div class="faq-list">{faqs.map(([q,a],i)=><details open={i===0}><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></div></section>

    <ProductivityFinalCta id="demo" />
  </main><Footer theme="light"/>
</Layout>
