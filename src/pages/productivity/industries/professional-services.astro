---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Icon from '../../../components/Icon.astro';
import ProductivityFinalCta from '../../../components/ProductivityFinalCta.astro';
import { Image } from 'astro:assets';
import professionalImage from '../../../assets/Professional services.jpg';
import '../../../styles/professional-services-industry.css';

const title = 'AI Productivity & Time Tracking for Professional Services | Ralvie AI';
const description = 'Help professional services teams understand where client and project time goes with automatic activity capture, AI timesheets, workload analytics, summaries, and productivity reports.';
const faqs = [
  ['What is Ralvie AI Productivity for professional services?', 'Ralvie helps professional services organizations capture relevant workplace activity, connect work with clients, projects and tasks, create AI-assisted timesheets and summaries, and understand workload and project effort.'],
  ['Do employees still need to start timers?', 'Ralvie is designed to reduce dependence on manual timers through configured automatic workplace activity capture.'],
  ['Can work be associated with clients and projects?', 'Yes. Relevant activity can be associated with clients, projects, and tasks using AI-assisted workflows.'],
  ['Can Ralvie generate daily or weekly summaries?', 'Ralvie Summary Agent can create daily, weekly, and custom-period summaries from relevant work context.'],
  ['Can managers understand project effort?', 'Role-aware dashboards can provide project effort, task, workload, time, and activity context.'],
  ['Can Ralvie help with capacity planning?', 'Workload and project-allocation data provides useful evidence when evaluating team capacity and new work.'],
  ['Does Ralvie calculate billing rates or revenue?', 'Ralvie provides work and time context that can support analysis, but it is not a financial accounting system.'],
  ['Is Ralvie employee surveillance software?', 'Ralvie is designed as productivity and work intelligence. Organizations should deploy it transparently and interpret data with role, complexity, quality, workload, and outcomes.'],
];
const schema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---
<Layout title={title} description={description} theme="light" showScene={false}>
  <Header title="Ralvie AI" theme="light"/><script type="application/ld+json" is:inline set:html={JSON.stringify(schema)}/>
  <main class="pro-page pt-(--header-height)">
    <section class="pro-hero pro-mesh"><div class="pro-shell hero-grid"><div class="hero-copy"><span class="pro-pill">RALVIE AI PRODUCTIVITY FOR PROFESSIONAL SERVICES</span><h1 class="industry-title-lines"><span>Make Every Hour of</span><span>Professional Work Easier</span><span><em>to Understand.</em></span></h1><p class="industry-description-lines"><span>Your professionals should spend time delivering expertise—not</span><span>reconstructing their week. Ralvie connects relevant activity</span><span>with clients, projects, tasks, time records, and summaries.</span></p><div class="pro-actions"><a href="https://me.ralvie.ai/auth/login" target="_blank" rel="noopener noreferrer" class="pro-primary">Start your free trial <Icon name="arrow-right"/></a><a href="#get-started" class="pro-secondary"><Icon name="calendar"/> Book a demo</a></div><small>Automatic tracking · AI timesheets · Project visibility · Workload analytics · AI summaries</small></div>
      <div class="pro-visual"><Image src={professionalImage} alt="Professional services team discussing client work" class="pro-image" widths={[640,960,1280]} sizes="(max-width:920px) 100vw, 53vw" loading="eager"/><div class="delivery-screen"><header><div><small>DELIVERY COCKPIT</small><strong>Client Portfolio</strong></div><span>Live</span></header><div class="delivery-kpis"><div><small>Active projects</small><b>32</b></div><div><small>Tracked effort</small><b>1,482h</b></div><div><small>On schedule</small><b class="good">87%</b></div></div><div class="delivery-chart">{[48,64,57,78,68,88,73,91].map((h,x)=><i class={`bar-${x}`} style={`--h:${h}%`}></i>)}</div><footer><span>Weekly delivery effort</span><b>+9.2%</b></footer></div><div class="util-card"><span><Icon name="chart-bar"/></span><div><small>CLIENT UTILIZATION</small><strong>76%</strong><em>+4.8%</em></div></div></div>
    </div></section>

    <section class="section expertise"><div class="pro-shell expertise-grid"><div><span class="eyebrow">WORK INTELLIGENCE FOR EXPERT TEAMS</span><h2>Your expertise creates the value. <em>Ralvie makes the work visible.</em></h2><p>Bring client meetings, research, documents, analysis, business applications, internal collaboration, and administrative work into a clearer productivity view.</p></div><div class="signal-cloud">{[['users','Client meetings'],['document','Documents'],['chart-bar','Analysis'],['mail','Email'],['folder','Project work'],['briefcase','Business apps'],['sparkles','Expertise'],['clock','Time context']].map(([i,n],x)=><span class={`sig-${x}`}><Icon name={i}/>{n}</span>)}</div></div></section>

    <section class="section workday-mesh"><div class="pro-shell split"><div class="copy"><span class="eyebrow">AUTOMATIC ACTIVITY TRACKING</span><h2>Stop losing work between <em>the calendar and the timesheet.</em></h2><p>Let the workday create the context across applications, documents, active work windows, sessions, and applicable offline activity.</p><div class="value-list">{[['monitor','Works with existing tools'],['clock','Captures work sessions'],['refresh','Supports offline context'],['shield-check','Follows configured settings']].map(([i,n],x)=><span class={`value-${x}`}><Icon name={i}/>{n}</span>)}</div></div><div class="workday-panel pro-glass"><header><div><small>WORK CONTEXT</small><h3>Today · 7h 52m</h3></div><button>Review activity</button></header><div class="workday-track">{[['08:45','Client advisory call','Matter: Northbridge','1h 05m'],['09:50','Contract analysis','Matter: Northbridge','1h 42m'],['11:32','Financial modelling','Project: Atlas','2h 16m'],['14:28','Research & drafting','Project: Meridian','1h 34m'],['16:02','Internal operations','Practice administration','55m']].map(([t,n,p,h],x)=><article><time>{t}</time><span class={`dot-${x}`}></span><div><b>{n}</b><small>{p}</small></div><strong>{h}</strong></article>)}</div></div></div></section>

    <section class="section"><div class="pro-shell"><div class="section-head centered"><span class="eyebrow">AI TIMESHEETS</span><h2>Turn time tracking from <em>reconstruction into review.</em></h2></div><div class="review-flow">{[['bolt','Work happens','Professionals use normal tools'],['monitor','Context captured','Relevant activity is organized'],['sparkles','AI adds context','Clients and tasks are suggested'],['user','Employee reviews','Records are validated'],['check','Time record ready','A structured record is created']].map(([i,n,p],x)=><article class={`review-${x}`}><span><Icon name={i}/></span><small>0{x+1}</small><h3>{n}</h3><p>{p}</p></article>)}</div></div></section>

    <section class="section project-dark"><div class="pro-shell split"><div class="project-screen dark-glass"><header><div><small>PROJECT EFFORT</small><h3>Planned vs actual</h3></div><span>Quarter to date</span></header>{[['Northbridge Advisory','240h','268h','+12%'],['Atlas Implementation','180h','174h','−3%'],['Meridian Review','120h','151h','+26%'],['Cedar Compliance','96h','92h','−4%']].map(([n,p,a,d],x)=><article><div><b>{n}</b><small>Planned {p}</small></div><span><i class={`project-${x}`} style={`--w:${Math.min(100,parseInt(a)/3)}%`}></i></span><strong>{a}<em class={d.startsWith('+')?'over':'under'}>{d}</em></strong></article>)}<footer><Icon name="sparkles"/><p>Meridian Review shows expanding research and stakeholder coordination effort.</p></footer></div><div class="copy light"><span class="eyebrow">PROJECT INTELLIGENCE</span><h2>Know when an engagement is taking <em>more work than expected.</em></h2><p>See the full effort behind client delivery, understand planned versus actual context, and use completed work to improve future estimates.</p><ul><li>Identify effort drift earlier</li><li>Understand task-level complexity</li><li>Support scope conversations</li><li>Plan the next engagement with history</li></ul></div></div></section>

    <section class="section distribution"><div class="pro-shell"><div class="section-head"><span class="eyebrow">WORK DISTRIBUTION</span><h2>Know where professional capacity <em>actually goes.</em></h2></div><div class="distribution-grid"><div class="donut-card pro-glass"><div class="donut"><span><strong>76%</strong>client work</span></div><div class="legend">{[['Client delivery','76%'],['Internal work','11%'],['Business development','8%'],['Administration','5%']].map(([n,v],x)=><p><i class={`leg-${x}`}></i>{n}<b>{v}</b></p>)}</div></div><div class="service-cards">{[['briefcase','Legal & advisory','Client matters, research, drafting, and reviews.'],['currency-coin','Accounting & finance','Analysis, reporting, compliance, and advisory work.'],['wrench','Technical services','Engineering, architecture, implementation, and QA.'],['home','Property services','Transactions, documentation, clients, and operations.']].map(([i,n,p],x)=><article class={`service-${x}`}><span><Icon name={i}/></span><h3>{n}</h3><p>{p}</p></article>)}</div></div></div></section>

    <section class="section capacity-mesh"><div class="pro-shell split"><div class="copy"><span class="eyebrow">RESOURCE PLANNING</span><h2>Know what your team can <em>realistically deliver.</em></h2><p>See when specialists are overloaded, where additional capacity exists, and how work is distributed beyond task counts and calendar availability.</p></div><div class="capacity-screen pro-glass"><header><div><small>TEAM CAPACITY</small><h3>Professional workload</h3></div><span>Next 30 days⌄</span></header>{[['Advisory','91%','High'],['Delivery','82%','Balanced'],['Technical','88%','Watch'],['Finance','67%','Balanced'],['Operations','51%','Available']].map(([n,v,s],x)=><article><div><b>{n}</b><small>{s}</small></div><span><i class={`cap-${x}`} style={`--w:${v}`}></i></span><strong>{v}</strong></article>)}<footer><Icon name="sparkles"/><p>Technical specialists are concentrated across three concurrent client projects.</p></footer></div></div></section>

    <section class="section summary"><div class="pro-shell summary-grid"><div class="summary-screen pro-glass"><header><span><Icon name="sparkles"/></span><div><small>RALVIE SUMMARY AGENT</small><h3>Weekly Professional Services Summary</h3></div><button>Export</button></header><p>Client delivery focused on the Northbridge advisory and Atlas implementation projects. Contract review progressed ahead of plan while additional stakeholder requests increased Meridian research effort.</p><div class="summary-stats"><span><small>Completed tasks</small><b>46</b></span><span><small>Client effort</small><b>284h</b></span><span><small>Internal work</small><b>38h</b></span></div><footer><small>Generated from relevant workplace context</small><b>Updated 12 min ago</b></footer></div><div class="copy"><span class="eyebrow">AI SUMMARY AGENT</span><h2>Turn everyday activity into <em>clear work updates.</em></h2><p>Reduce manual status reporting with daily, weekly, and custom-period summaries for employees, managers, projects, and client conversations.</p></div></div></section>

    <section class="section views"><div class="pro-shell"><div class="section-head centered"><span class="eyebrow">MULTIPLE BUSINESS PERSPECTIVES</span><h2>Understand productivity <em>at every level.</em></h2></div><div class="view-grid">{[['user','Employee view','Personal activity, time records, projects, and summaries.'],['users','Manager view','Team workload, allocation, and work patterns.'],['folder','Project view','Effort, tasks, progress, and delivery context.'],['chart-bar','Leadership view','Capacity, portfolio trends, and operational visibility.']].map(([i,n,p],x)=><article class={`view-${x}`}><span><Icon name={i}/></span><h3>{n}</h3><p>{p}</p></article>)}</div></div></section>

    <section class="section privacy"><div class="pro-shell privacy-panel"><div><span class="eyebrow">PRIVACY & CONTROL</span><h2>Visibility should support professional work—<em>not micromanage it.</em></h2><p>Configure schedules, working hours, tracking preferences, idle settings, role-based access, and workplace policies with clear boundaries.</p></div><div class="privacy-grid">{[['shield-check','Configured policies'],['clock','Working-hour controls'],['users','Role-aware visibility'],['heart','Employee context']].map(([i,n],x)=><span class={`privacy-${x}`}><Icon name={i}/>{n}</span>)}</div></div></section>

    <section class="section faq"><div class="pro-shell faq-grid"><div class="section-head"><span class="eyebrow">FREQUENTLY ASKED QUESTIONS</span><h2>Professional services productivity, <em>explained.</em></h2><p>Understand the business behind the timesheets.</p></div><div class="faq-list">{faqs.map(([q,a],x)=><details open={x===0}><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></div></section>
    <ProductivityFinalCta />
  </main><Footer theme="light"/>
</Layout>
