---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Icon from '../../../components/Icon.astro';
import ProductivityFinalCta from '../../../components/ProductivityFinalCta.astro';
import { Image } from 'astro:assets';
import saasHeroImage from '../../../assets/saas hero section image.jpg';
import '../../../styles/saas-industry.css';

const title = 'AI Productivity & Time Tracking for SaaS Teams | Ralvie AI';
const description = 'Help SaaS teams understand where work time goes with automatic activity capture, AI-assisted timesheets, project intelligence, workload analytics, and work summaries.';
const teams = [['bolt','Engineering','Development effort, focus patterns, and project allocation.'],['target','Product','Roadmap, research, coordination, and feature effort.'],['sparkles','Design','Creative focus, feedback cycles, and work distribution.'],['megaphone','Marketing','Campaign, content, research, and operational effort.'],['headset','Customer teams','Customer-facing workload and internal coordination.'],['briefcase','Operations','Process overhead, capacity, and resource use.']];
const faqs = [
  ['What is Ralvie AI Productivity for SaaS?', 'Ralvie helps SaaS organizations capture relevant workplace activity, create AI-assisted timesheets, connect work with projects and tasks, generate summaries, and analyze team productivity patterns.'],
  ['Is Ralvie useful for software development teams?', 'Yes. Engineering teams can understand work distribution, project effort, task context, application activity, workload, and focus patterns.'],
  ['Do developers have to start timers manually?', 'Ralvie is designed to reduce dependence on manual timers through configured automatic workplace activity capture.'],
  ['Can development work be mapped to projects?', 'AI-assisted workflows can help associate relevant activity with projects and tasks.'],
  ['Can Ralvie help with sprint estimates?', 'Historical project and task effort provides useful context when estimating similar work in the future.'],
  ['Can managers see engineering workload?', 'Role-aware reports can provide workload, project, task, time, and activity context according to organizational permissions.'],
  ['Is Ralvie useful for remote SaaS teams?', 'Yes. Ralvie can support remote, hybrid, office-based, and distributed SaaS teams.'],
  ['Does Ralvie measure developers only by active time?', 'No. Activity should be interpreted alongside role, complexity, quality, collaboration, workload, progress, and outcomes.'],
];
const schema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---
<Layout title={title} description={description} theme="light" showScene={false}>
  <Header title="Ralvie AI" theme="light"/><script type="application/ld+json" is:inline set:html={JSON.stringify(schema)}/>
  <main class="saas-page pt-(--header-height)">
    <section class="saas-hero mesh"><div class="saas-shell hero-layout">
      <div class="hero-copy"><span class="saas-pill">RALVIE AI PRODUCTIVITY FOR SAAS</span><h1 class="industry-title-lines"><span>Build Faster.</span><span>Work Smarter.</span><span><em>See Where Your Team&#8217;s Time Goes.</em></span></h1><p class="industry-description-lines"><span>Automatically capture relevant work activity and connect time</span><span>with projects and tasks. Generate AI-assisted timesheets and</span><span>turn everyday work into useful productivity insights.</span></p><div class="saas-actions"><a href="https://me.ralvie.ai/auth/login" target="_blank" rel="noopener noreferrer" class="saas-primary">Start your free trial <Icon name="arrow-right"/></a><a href="#get-started" class="saas-secondary"><Icon name="calendar"/> Book a demo</a></div><small>Activity tracking · AI timesheets · Project intelligence · Team workload · AI summaries</small></div>
      <div class="saas-hero-visual">
        <Image src={saasHeroImage} alt="SaaS team collaborating on product development" class="saas-hero-image" widths={[640,960,1280]} sizes="(max-width: 920px) 100vw, 55vw" loading="eager"/>
        <div class="hero-overlay hero-overlay-small"><span><Icon name="bolt"/></span><div><small>FOCUS TIME</small><strong>4h 12m</strong><em>+14%</em></div></div>
        <div class="hero-overlay hero-overlay-medium"><header><div><small>SPRINT OVERVIEW</small><strong>Q3 Product Release</strong></div><span>This week⌄</span></header><div class="overlay-kpis"><div><small>Completed</small><b>38 tasks</b></div><div><small>Team effort</small><b>486h</b></div><div><small>Sprint health</small><b>On track</b></div></div><div class="overlay-progress"><span><i></i></span><footer><small>Release progress</small><b>82%</b></footer></div></div>
      </div>
    </div></section>

    <section class="section intro"><div class="saas-shell intro-layout"><div><span class="eyebrow">WORK INTELLIGENCE AT SAAS SPEED</span><h2>SaaS teams move fast. <em>Your productivity data should keep up.</em></h2></div><div class="question-stack">{['Where did the week go?','Which features consumed the most effort?','Is engineering overloaded?','Are teams focused on priority work?'].map((q,i)=><article class={i===1?'active':''}><span>0{i+1}</span><p>{q}</p><Icon name="arrow-right"/></article>)}</div></div></section>

    <section class="section tracking-mesh"><div class="saas-shell split"><div class="copy"><span class="eyebrow">AUTOMATIC ACTIVITY TRACKING</span><h2>Stop making your team <em>track every minute manually.</em></h2><p>Developers should not stop coding to update a timer. Ralvie Sundial captures configured workplace context while your team continues using the tools it already knows.</p><div class="chip-grid">{[['monitor','Applications'],['document','Documents & windows'],['clock','Work sessions'],['bolt','Active time'],['refresh','Offline activity'],['shield-check','Configured privacy']].map(([i,n])=><span><Icon name={i}/>{n}</span>)}</div></div><div class="timeline glass-panel"><header><div><small>ACTIVITY TIMELINE</small><h3>Tuesday, June 16</h3></div><span>7h 48m</span></header>{[['09:00','Development','VS Code · Authentication redesign','2h 14m'],['11:14','Documentation','API migration guide','48m'],['12:02','Collaboration','Sprint planning','56m'],['13:42','Development','Customer portal 2.0','3h 09m']].map(([t,n,d,v],i)=><article><time>{t}</time><i class={`t-${i}`}></i><div><b>{n}</b><small>{d}</small></div><strong>{v}</strong></article>)}</div></div></section>

    <section class="section timesheet-section"><div class="saas-shell"><div class="section-head centered"><span class="eyebrow">AI TIMESHEETS</span><h2>Let the workday help <em>build the timesheet.</em></h2><p>Replace Friday-afternoon guesswork with a reviewable work record informed by captured activity.</p></div><div class="flow-cards">{[['bolt','Work happens','Development, research and meetings'],['monitor','Activity captured','Workplace context is organized'],['sparkles','AI maps context','Projects and tasks are suggested'],['check','Employee reviews','A clearer timesheet is ready']].map(([i,n,p],x)=><article class={`glass-card flow-${x}`}><span><Icon name={i}/></span><small>0{x+1}</small><h3>{n}</h3><p>{p}</p></article>)}</div></div></section>

    <section class="section feature-effort mesh-dark"><div class="saas-shell split"><div class="effort-board glass-dark"><header><div><small>Q3 PRODUCT RELEASE</small><h3>Feature effort</h3></div><span>486h total</span></header>{[['CRM integration','97h','100%'],['AI reporting dashboard','86h','89%'],['Authentication upgrade','62h','64%'],['Mobile experience','48h','49%'],['Performance','41h','42%']].map(([n,h,w],i)=><article><span>{i+1}</span><div><b>{n}</b><i><em style={`--w:${w}`}></em></i></div><strong>{h}</strong></article>)}<footer><Icon name="sparkles"/><p>CRM integration required 32 hours more than planned, primarily across testing and dependency work.</p></footer></div><div class="copy light"><span class="eyebrow">FEATURE & PROJECT INTELLIGENCE</span><h2>Know what your roadmap <em>actually costs in team time.</em></h2><p>Connect engineering activity to the projects behind it, see which features consume the most effort, and use historical work data to improve future estimates.</p><ul><li>Understand feature complexity</li><li>Compare planned versus actual effort</li><li>Learn from previous sprint delivery</li><li>Allocate engineering capacity with context</li></ul></div></div></section>

    <section class="section"><div class="saas-shell"><div class="section-head"><span class="eyebrow">ONE PLATFORM ACROSS THE BUSINESS</span><h2>Work intelligence for every team <em>building and growing your SaaS.</em></h2></div><div class="team-bento">{teams.map(([icon,n,p],i)=><article class={`team-${i}`}><span><Icon name={icon}/></span><div><h3>{n}</h3><p>{p}</p></div></article>)}</div></div></section>

    <section class="section capacity-mesh"><div class="saas-shell split"><div class="copy"><span class="eyebrow">WORKLOAD & CAPACITY</span><h2>Scale your team with <em>better workload visibility.</em></h2><p>Understand whether the answer is to hire, reallocate, reduce scope, change priorities, or improve a process before delivery slows.</p><div class="decision-grid">{[['users','Reallocate'],['plus','Hire'],['target','Prioritize'],['sparkles','Automate']].map(([i,n])=><span><Icon name={i}/>{n}</span>)}</div></div><div class="capacity-dashboard glass-panel"><header><div><small>TEAM CAPACITY</small><h3>Workload by function</h3></div><span>This sprint⌄</span></header>{[['Engineering','92%','High'],['Product','78%','Balanced'],['Design','86%','Watch'],['Customer success','69%','Balanced'],['Operations','54%','Available']].map(([n,v,s],i)=><article><div><b>{n}</b><small>{s}</small></div><span><i class={`w-${i}`} style={`--w:${v}`}></i></span><strong>{v}</strong></article>)}<footer><Icon name="sparkles"/><p>Design capacity is concentrated across three roadmap initiatives. Consider reducing parallel work.</p></footer></div></div></section>

    <section class="section summary-section"><div class="saas-shell summary-grid"><div class="summary-card glass-panel"><header><span><Icon name="sparkles"/></span><div><small>RALVIE SUMMARY AGENT</small><h3>Weekly Product Summary</h3></div><button>Jun 8–12⌄</button></header><p>The team focused primarily on the analytics dashboard release, completing frontend implementation and progressing API integration. QA activity increased toward the end of the week while product meetings decreased.</p><div class="summary-stats"><span><small>Tasks completed</small><b>38</b></span><span><small>Focus time</small><b>128h</b></span><span><small>Meeting change</small><b class="positive">−12%</b></span></div><footer><span>Generated from relevant work context</span><button>Share summary</button></footer></div><div class="copy"><span class="eyebrow">SUMMARY AGENT</span><h2>Progress updates without <em>another reporting task.</em></h2><p>Turn the activity your teams already create into daily, weekly, and custom-period summaries. Let standups focus on blockers and priorities—not remembering yesterday.</p></div></div></section>

    <section class="section responsible"><div class="saas-shell"><div class="responsible-panel"><div><span class="eyebrow">RESPONSIBLE PRODUCTIVITY</span><h2>Context first. <em>Metrics second.</em></h2><p>Productivity intelligence should help teams work better—not reduce different roles and complex work to a simplistic activity score.</p></div><div class="principles">{[['shield-check','Configurable policies'],['users','Role-aware visibility'],['clock','Working-hour controls'],['heart','Employee context']].map(([i,n])=><span><Icon name={i}/>{n}</span>)}</div></div></div></section>

    <section class="section faq-section"><div class="saas-shell faq-layout"><div class="section-head"><span class="eyebrow">FREQUENTLY ASKED QUESTIONS</span><h2>SaaS productivity, <em>explained.</em></h2><p>Clearer work context for fast-moving, distributed teams.</p></div><div class="faq-list">{faqs.map(([q,a],i)=><details open={i===0}><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></div></section>
    <ProductivityFinalCta />
  </main><Footer theme="light"/>
</Layout>
