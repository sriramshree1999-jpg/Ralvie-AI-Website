---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Icon from '../../../components/Icon.astro';
import ProductivityFinalCta from '../../../components/ProductivityFinalCta.astro';
import { Image } from 'astro:assets';
import consultancyHeroImage from '../../../assets/consultancy hero section image.jpg';
import '../../../styles/consultancy-industry.css';

const title = 'AI Productivity & Time Tracking Software for Consulting Firms | Ralvie AI';
const description = 'Help consulting teams understand where client and project time goes with automatic activity capture, AI timesheets, consultant workload, summaries, and project visibility.';
const faqs = [
  ['What is Ralvie AI Productivity for consultancies?', 'Ralvie helps consulting firms capture relevant workplace activity, create AI-assisted timesheets, connect work with engagements and tasks, generate summaries, and analyze workload and project effort.'],
  ['Do consultants still need to start timers?', 'Ralvie is designed to reduce dependence on manual timers through configured automatic workplace activity capture.'],
  ['Can work be connected to client projects?', 'Yes. Relevant activity can be associated with clients, engagements, projects, and tasks using AI-assisted workflows.'],
  ['Can Ralvie generate project summaries?', 'Ralvie Summary Agent can create daily, weekly, and custom-period summaries from relevant work context.'],
  ['Can engagement managers understand workload?', 'Role-aware reports can provide consultant workload, project allocation, time, and activity context.'],
  ['Can Ralvie help improve estimates?', 'Historical engagement and task effort provides useful context when planning similar consulting work.'],
  ['Does Ralvie calculate billable rates or gross margins?', 'Ralvie supplies time and work context that can support analysis, but it is not a financial accounting system.'],
  ['Is Ralvie designed to monitor consultants?', 'No. Ralvie is a productivity and work-intelligence platform. Data should be used transparently and interpreted with role, complexity, quality, workload, and outcomes.'],
];
const schema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---
<Layout title={title} description={description} theme="light" showScene={false}>
  <Header title="Ralvie AI" theme="light"/><script type="application/ld+json" is:inline set:html={JSON.stringify(schema)}/>
  <main class="consult-page pt-(--header-height)">
    <section class="consult-hero consult-mesh"><div class="consult-shell hero-grid"><div class="hero-copy"><span class="consult-pill">RALVIE AI PRODUCTIVITY FOR CONSULTANCIES</span><h1 class="industry-title-lines"><span>Turn Consultant Time</span><span>Into Clearer Project</span><span><em>Intelligence.</em></span></h1><p class="industry-description-lines"><span>Your consultants were hired to solve problems and deliver</span><span>outcomes—not reconstruct timesheets. Ralvie connects activity</span><span>with engagements, tasks, time records, and summaries.</span></p><div class="consult-actions"><a href="#get-started" class="consult-primary">Start your free trial <Icon name="arrow-right"/></a><a href="#get-started" class="consult-secondary"><Icon name="calendar"/> Book a demo</a></div><small>Automatic tracking · AI timesheets · Client visibility · Consultant workload · AI summaries</small></div>
      <div class="consult-visual"><Image src={consultancyHeroImage} alt="Consultants collaborating on a client engagement" class="consult-image" widths={[640,960,1280]} sizes="(max-width:920px) 100vw, 53vw" loading="eager"/><div class="consult-mini"><span><Icon name="users"/></span><div><small>ACTIVE CONSULTANTS</small><strong>42</strong><em>86% allocated</em></div></div><div class="engagement-screen"><header><div><small>ENGAGEMENT HEALTH</small><strong>Transformation Program</strong></div><span>Q2⌄</span></header><div class="engagement-kpis"><div><small>Client effort</small><b>682h</b></div><div><small>Milestones</small><b>8 / 10</b></div><div><small>Forecast</small><b class="watch">+6%</b></div></div><div class="engagement-line"><span><i></i></span><footer><small>Delivery progress</small><b>80%</b></footer></div></div></div>
    </div></section>

    <section class="section intro"><div class="consult-shell intro-grid"><div><span class="eyebrow">CONSULTING WORK INTELLIGENCE</span><h2>Time, expertise, and client delivery—<em>without another hour of administration.</em></h2><p>Consultants move between analysis, research, meetings, presentations, internal collaboration, business development, and several client workstreams.</p></div><div class="context-map"><div class="context-center"><span>R</span><b>Engagement context</b></div>{[['document','Research'],['chart-bar','Analysis'],['users','Client meetings'],['sparkles','Presentations'],['mail','Follow-up'],['briefcase','Business development']].map(([i,n],x)=><article class={`ctx-${x}`}><Icon name={i}/><b>{n}</b></article>)}</div></div></section>

    <section class="section activity-mesh"><div class="consult-shell split"><div class="day-card glass"><header><div><small>CONSULTANT WORKDAY</small><h3>Wednesday · 8h 06m</h3></div><span>Captured</span></header>{[['09:00','Strategy call','Northstar Transformation','1h 15m'],['10:15','Financial analysis','Northstar Transformation','1h 25m'],['11:40','Internal project review','Delivery team','50m'],['13:15','Presentation preparation','Arcadia Operations','1h 45m'],['15:00','Market research','Cobalt Growth','1h 30m']].map(([t,n,p,h],x)=><article><time>{t}</time><i class={`day-${x}`}></i><div><b>{n}</b><small>{p}</small></div><strong>{h}</strong></article>)}</div><div class="copy"><span class="eyebrow">AUTOMATIC ACTIVITY TRACKING</span><h2>Let consultants focus on clients—<em>not timers.</em></h2><p>Capture configured context around applications, documents, work sessions, active periods, idle periods, and applicable offline work.</p><div class="capture-list">{[['monitor','Applications'],['document','Documents'],['clock','Work sessions'],['refresh','Offline context']].map(([i,n],x)=><span class={`capture-${x}`}><Icon name={i}/>{n}</span>)}</div></div></div></section>

    <section class="section"><div class="consult-shell"><div class="section-head centered"><span class="eyebrow">AI TIMESHEETS</span><h2>Make time reporting easier for <em>busy consultants.</em></h2></div><div class="time-flow">{[['bolt','Activity happens','Analysis, meetings, research'],['monitor','Context captured','The workday is organized'],['sparkles','AI organizes','Engagements and tasks suggested'],['user','Consultant reviews','Context is validated'],['check','Timesheet ready','A clearer record is created']].map(([i,n,p],x)=><article class={`flow-${x}`}><span><Icon name={i}/></span><small>STEP 0{x+1}</small><h3>{n}</h3><p>{p}</p></article>)}</div></div></section>

    <section class="section engagement-dark"><div class="consult-shell split"><div class="copy light"><span class="eyebrow">CLIENT & PROJECT CONTEXT</span><h2>See the true effort behind <em>every engagement.</em></h2><p>Connect consultant time with the client, engagement, workstream, task, and tools behind it. Identify effort drift before it becomes a delivery problem.</p><ul><li>Understand the work behind milestones</li><li>Compare planned and actual effort</li><li>See coordination and meeting overhead</li><li>Improve the next engagement estimate</li></ul></div><div class="portfolio dark-glass"><header><div><small>TOP ENGAGEMENTS BY EFFORT</small><h3>Consultancy portfolio</h3></div><span>1,846h</span></header>{[['Northstar Transformation','682h','92%'],['Arcadia Operations','438h','66%'],['Cobalt Growth Strategy','326h','49%'],['Meridian Technology','244h','37%'],['Internal practice work','156h','24%']].map(([n,h,w],x)=><article><span>{x+1}</span><div><b>{n}</b><i><em style={`--w:${w}`}></em></i></div><strong>{h}</strong></article>)}<footer><Icon name="sparkles"/><p>Northstar effort is 6% above forecast, driven by stakeholder workshops and additional analysis.</p></footer></div></div></section>

    <section class="section allocation"><div class="consult-shell"><div class="section-head"><span class="eyebrow">CONSULTANT ALLOCATION</span><h2>Know who can take on more work—<em>and who can’t.</em></h2></div><div class="allocation-layout"><div class="allocation-board glass"><header><div><small>RESOURCE PLAN</small><h3>Consultant allocation</h3></div><span>Next 4 weeks⌄</span></header>{[['Amelia Chen','Strategy','92%','3 engagements'],['Daniel Brooks','Technology','78%','2 engagements'],['Priya Shah','Operations','86%','4 engagements'],['Marcus Reed','Finance','64%','2 engagements'],['Sofia Martin','People','48%','1 engagement']].map(([n,p,v,e],x)=><article><span class={`avatar a-${x}`}>{n.split(' ').map(z=>z[0]).join('')}</span><div><b>{n}</b><small>{p} · {e}</small></div><i><em style={`--w:${v}`}></em></i><strong>{v}</strong></article>)}</div><div class="allocation-notes"><article><span><Icon name="bolt"/></span><h3>Workload concentration</h3><p>Priya is split across four engagements, increasing switching and coordination.</p></article><article><span><Icon name="users"/></span><h3>Available capacity</h3><p>Sofia has room to support the upcoming people-transformation engagement.</p></article><article><span><Icon name="target"/></span><h3>Staffing decision</h3><p>Move one operations workstream before assigning new delivery work.</p></article></div></div></div></section>

    <section class="section summary-mesh"><div class="consult-shell summary-grid"><div class="summary-screen glass"><header><span><Icon name="sparkles"/></span><div><small>RALVIE SUMMARY AGENT</small><h3>Weekly Engagement Summary</h3></div><button>Share update</button></header><p>The team completed stakeholder interviews and the current-state analysis. Financial modelling progressed ahead of plan, while two additional workshops increased coordination time.</p><div class="summary-row"><span><small>Milestones advanced</small><b>3</b></span><span><small>Consultant effort</small><b>184h</b></span><span><small>Client meetings</small><b>22h</b></span></div><footer><span>Generated from relevant engagement context</span><b>Updated 8 min ago</b></footer></div><div class="copy"><span class="eyebrow">AI WORK SUMMARIES</span><h2>Let work activity help <em>explain progress.</em></h2><p>Create daily, weekly, and custom-period summaries so consultants spend more time advising and less time preparing repetitive internal updates.</p></div></div></section>

    <section class="section roles"><div class="consult-shell"><div class="section-head centered"><span class="eyebrow">THE RIGHT VIEW AT EVERY LEVEL</span><h2>From consultant activity to <em>consultancy intelligence.</em></h2></div><div class="role-grid">{[['user','Consultants','Personal workday, timesheets, projects, and summaries.'],['folder','Engagement managers','Effort, tasks, workload, and project progress.'],['users','Practice leaders','Allocation, capacity, and practice-level patterns.'],['chart-bar','Operations','Work distribution, overhead, and planning context.'],['briefcase','Leadership','Portfolio effort, utilization, and operational trends.']].map(([i,n,p],x)=><article class={`role-${x}`}><span><Icon name={i}/></span><h3>{n}</h3><p>{p}</p></article>)}</div></div></section>

    <section class="section privacy"><div class="consult-shell privacy-card"><div><span class="eyebrow">PRIVACY & CONTROL</span><h2>Visibility should improve work—<em>not create micromanagement.</em></h2><p>Configure working hours, schedules, tracking preferences, idle settings, role-based visibility, and workplace policies around a clear business purpose.</p></div><div class="control-grid">{[['shield-check','Policy aligned'],['clock','Working-hour controls'],['users','Role-aware access'],['heart','Employee context']].map(([i,n],x)=><span class={`control-${x}`}><Icon name={i}/>{n}</span>)}</div></div></section>

    <section class="section faq"><div class="consult-shell faq-grid"><div class="section-head"><span class="eyebrow">FREQUENTLY ASKED QUESTIONS</span><h2>Consulting productivity, <em>explained.</em></h2><p>Clearer engagement context with less administrative work.</p></div><div class="faq-list">{faqs.map(([q,a],x)=><details open={x===0}><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></div></section>
    <ProductivityFinalCta />
  </main><Footer theme="light"/>
</Layout>
