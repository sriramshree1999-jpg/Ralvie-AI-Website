---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Icon from '../../../components/Icon.astro';
import ProductivityFinalCta from '../../../components/ProductivityFinalCta.astro';
import '../../../styles/employee-productivity.css';
import '../../../styles/task-management.css';
import '../../../styles/ralvie-product-ui.css';

const title = 'AI Task Management Software for Teams | Ralvie AI Productivity';
const description = 'Manage tasks with real work context using Ralvie AI Productivity. Connect tasks with activity, time, projects, AI summaries, workload, and productivity insights to improve execution and team visibility.';
const faqs = [
  ['What is Ralvie AI Task Management?', 'Ralvie connects tasks with workplace activity, time, projects, AI summaries, and workload context to explain how work is progressing.'],
  ['Can we create tasks directly in Ralvie?', 'Yes. Ralvie AI Productivity includes task workflows for organizing and managing work.'],
  ['Can tasks be connected to projects?', 'Yes. Tasks can be organized within projects to provide broader business context.'],
  ['Can Ralvie automatically track work related to a task?', 'Captured activity and AI-assisted context can help associate relevant work with tasks.'],
  ['Can we see how much time a task took?', 'Task-level work context helps teams understand effort associated with individual tasks.'],
  ['Does Ralvie generate task summaries?', 'AI summary capabilities turn task-related work activity into structured progress information.'],
  ['Can employees review assigned tasks?', 'Employees can access relevant task views according to organizational roles and permissions.'],
  ['Can managers see which tasks are active?', 'Task status, activity, time, and work context provide clearer visibility into active work.'],
  ['Can Ralvie help identify blocked tasks?', 'Task status and work patterns provide useful context for identifying work that may require attention.'],
  ['Does Ralvie support task priorities?', 'Tasks can use relevant priority and status information within the configured workflow.'],
  ['Can Ralvie help with workload planning?', 'Combining tasks with actual effort provides stronger employee workload context.'],
  ['Can task data improve estimates?', 'Historical task effort helps teams compare similar work and make more informed estimates.'],
  ['Can tasks come from Jira or other systems?', 'Connected task workflows can be supported through available integrations and configuration.'],
  ['Does Ralvie replace our project-management platform?', 'Ralvie supports tasks and projects directly while also complementing external tools through integrations.'],
  ['Is task performance measured only by time?', 'No. Complexity, quality, progress, dependencies, workload, and outcomes matter alongside time.'],
];
const faqSchema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---

<Layout title={title} description={description} theme="light" showScene={false}>
  <Header title="Ralvie AI" theme="light"/><script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)}/>
  <main class="employee-page task-page pt-(--header-height)">
    <section class="employee-hero task-hero mesh-bg"><div class="employee-shell hero-copy">
      <span class="pill">AI task management</span><h1 class="task-hero-title">Turn Every Task Into<br/><em>Visible, Measurable Progress.</em></h1><p>Connect every task with the activity, time, tools, projects, and people behind it. Employees see clear priorities, while managers gain the context to spot stalled work and support delivery without constant status checks.</p><div class="hero-actions"><a href="https://me.ralvie.ai/auth/login" target="_blank" rel="noopener noreferrer" class="primary-btn">Start your free trial <Icon name="arrow-right"/></a><a href="#get-started" class="secondary-btn"><Icon name="calendar"/> Book a demo</a></div>
      <div class="hero-dashboard glass task-ops-hero">
        <header><div><span><Icon name="list-check"/></span><div><small>My task workspace</small><strong>Today’s priorities</strong></div></div><button>+ New task</button></header>
        <div class="task-hero-filters"><span class="active">My tasks <b>12</b></span><span>In progress <b>5</b></span><span>Review <b>3</b></span><span>Blocked <b>2</b></span></div>
        <div class="task-hero-list">{[
          ['Implement customer portal','Customer Experience Platform','High','8h 26m','68%'],['Responsive QA','Ralvie Website','Critical','11h 42m','84%'],['Analytics dashboard','Product Intelligence','Medium','4h 18m','46%'],['CRM workflow integration','Sales Operations','High','7h 38m','35%']
        ].map(([name,project,priority,time,progress],i)=><article class={`task-row row-${i}`}><span class="task-check"><i></i></span><div><strong>{name}</strong><small>{project}</small></div><b class={`priority p-${i}`}>{priority}</b><span class="task-time"><Icon name="clock"/>{time}</span><span class="task-progress"><i><b style={`--w:${progress}`}></b></i><small>{progress}</small></span></article>)}</div>
        <footer><span><i></i> Automatic activity mapping enabled</span><small>Last synced 2 min ago</small></footer>
        <div class="task-widget task-widget-focus"><span><Icon name="target"/></span><strong>5<small>Priority tasks</small></strong></div><div class="task-widget task-widget-alert"><span><Icon name="bolt"/></span><strong>3<small>Need attention</small></strong></div>
      </div>
    </div></section>

    <section class="section intro-section"><div class="employee-shell center task-context-section"><span class="eyebrow">Beyond “to do” and “done”</span><h2>Task status provides structure.<br/><em>Ralvie adds the work context.</em></h2><p>Ownership, due dates, priority, and status describe how a task is organized, but they do not explain the work required to move it forward. Ralvie connects recent activity, invested time, applications, workload, and progress signals so teams can understand what changed today, where momentum is building, and which tasks may need support.</p><div class="task-context-flow glass"><header><span><Icon name="sparkles"/></span><div><small>Ralvie task intelligence</small><strong>From assignment to actionable insight</strong></div><b>Live</b></header><div class="task-context-track">{[['list-check','Task','Define the work, owner, and intended outcome.'],['monitor','Activity','Connect the tools, conversations, and documents supporting the task.'],['clock','Time','Understand the effort invested and where time is being spent.'],['chart-bar','Progress','Turn activity and task signals into a clearer view of momentum.'],['sparkles','Insight','Surface the next action, risk, or opportunity for the team.']].map(([icon,label,copy],i)=><article class={`context-step step-${i+1}`}><span><Icon name={icon}/></span><strong><small>0{i+1}</small>{label}</strong><p>{copy}</p>{i<4&&<b>→</b>}</article>)}</div><footer><span><i></i> Context updates automatically</span><small>Each stage adds clearer execution intelligence</small></footer></div></div></section>

    <section class="section soft-mesh"><div class="employee-shell split"><div class="copy"><span class="eyebrow">Task activity intelligence</span><h2>Understand what happens between <em>assignment and completion.</em></h2><p>Work happens across development tools, design apps, documents, browsers, spreadsheets, communication platforms, meetings, and internal systems. Ralvie connects relevant activity to the task it supports.</p><strong class="closing-line">The task shows the assignment. Activity shows the work.</strong></div><div class="task-activity-visual"><div class="task-map-panel"><header><small>AI task mapping</small><b>Confidence 94%</b></header><div class="task-map-body"><div class="task-map-source"><div><span>Fi</span><span>VS</span><span>Ch</span></div><small>Captured activity</small></div><div class="task-map-ai"><i></i><b>AI</b><i></i></div><article class="task-map-result"><span><Icon name="folder"/></span><small>Project</small><strong>Ralvie Website</strong><hr/><small>Task</small><strong>Build Productivity Landing Page</strong></article></div><footer><Icon name="check"/><strong>Work context connected automatically</strong></footer></div></div></div></section>

    <section class="section"><div class="employee-shell"><div class="section-head center"><span class="eyebrow">Clear task structure & personal priorities</span><h2>Give every piece of work<br/><em>a clear place.</em></h2><p>Turn scattered requests into organized, actionable work with clear owners, priorities, projects, dates, statuses, and dependencies. Connect each task with activity, effort, workload, and progress context so everyone understands what matters now, what is moving, and what needs attention next.</p></div><div class="task-structure-grid"><article class="glass task-editor"><header><div><small>Task details</small><h3>API integration setup</h3></div><b>In progress</b></header><div class="editor-fields">{[['Project','Customer Portal'],['Assignee','Alex Morgan'],['Priority','High'],['Source','Ralvie'],['Start date','Aug 25'],['Status','In progress']].map(([l,v])=><span><small>{l}</small><strong>{v}</strong></span>)}</div><footer><span><Icon name="clock"/>9h 12m tracked</span><span><Icon name="monitor"/>VS Code · Postman · Chrome</span></footer></article><article class="glass personal-priority"><header><div><small>Personal task view</small><h3>What needs attention now</h3></div><span>Today</span></header>{[['Critical','Responsive QA','Due today'],['High','CRM integration','Blocked'],['High','Customer portal','Active now'],['Medium','Content review','Tomorrow']].map(([p,n,d],i)=><div><b class={`rank-${i}`}>{i+1}</b><span><strong>{n}</strong><small>{p} · {d}</small></span><i class:list={[i===2&&'live']}></i></div>)}</article></div></div></section>

    <section class="section task-status-band"><div class="employee-shell"><div class="section-head center light"><span class="eyebrow">Task status + activity context</span><h2>Know where the task is.<br/><em>Understand what is happening inside it.</em></h2></div><div class="status-stage-grid">{[['To Do','Work is ready to begin','12'],['In Progress','Active execution has started','38'],['Review','Ready for validation','9'],['Blocked','Waiting on a dependency','7'],['Completed','Work has been finished','61']].map(([n,c,v],i)=><article class={`stage-${i}`}><span>{v}</span><h3>{n}</h3><p>{c}</p></article>)}</div></div></section>

    <section class="section soft-mesh"><div class="employee-shell split"><div class="glass attention-compare"><header><small>Activity attention</small><strong>Same status. Different story.</strong></header><article><span class="pulse active"></span><div><h3>Customer portal implementation</h3><p>Recent activity: 18 minutes ago</p></div><b>8h 12m</b></article><article><span class="pulse stale"></span><div><h3>CRM data migration</h3><p>Recent activity: 4 days ago</p></div><b>35m</b></article><footer><Icon name="sparkles"/><span><small>AI insight</small><strong>Review workload and dependencies for the second task.</strong></span></footer></div><div class="copy"><span class="eyebrow">Attention & progress intelligence</span><h2>See which tasks are <em>actually receiving attention.</em></h2><p>Use recent activity, invested time, work sessions, application context, status, and summaries to make progress conversations more meaningful.</p><ul><li>Reduce repetitive “still working on this” updates</li><li>Find stalled work before deadlines</li><li>Investigate with evidence, not assumptions</li></ul></div></div></section>

    <section class="section"><div class="employee-shell split"><div class="copy"><span class="eyebrow">AI task summaries</span><h2>Explain what happened<br/><em>without writing everything<br/>manually.</em></h2><p>Transform several hours or days of task activity into a concise update covering completed work, current progress, and the next step.</p><strong class="closing-line">Detailed activity becomes a clear progress update.</strong></div><div class="glass task-summary-card"><header><span><Icon name="sparkles"/></span><div><small>AI task summary</small><strong>Implement Website Form Page</strong></div><b>Generated</b></header><p>Work focused on frontend implementation, responsive layout adjustments, and content integration. The main structure is complete, with mobile testing and final CTA styling remaining.</p><div><span><small>Completed</small><b>Main sections</b><b>Content integration</b></span><span><small>In progress</small><b>Mobile responsiveness</b><b>CTA styling</b></span></div><footer>Next: final QA and deployment review.</footer></div></div></section>

    <section class="section task-effort-section soft-mesh"><div class="employee-shell"><div class="section-head center"><span class="eyebrow">Effort, bottlenecks & workload</span><h2>See where team effort is going <em>before work stops moving.</em></h2></div><div class="task-intel-grid"><article class="glass effort-bars"><header><small>Task effort analytics</small><h3>Product launch</h3></header>{[['CRM integration','22h 42m',92],['Landing page','14h 18m',68],['QA testing','11h 56m',58],['Email campaign','6h 31m',35],['Analytics setup','4h 48m',26]].map(([n,t,w],i)=><div><span>{n}</span><i><b style={`--w:${w}%`} class={`bar-${i}`}></b></i><strong>{t}</strong></div>)}</article><article class="glass blocked-task"><header><small>Blocked task context</small><b>Blocked</b></header><h3>CRM workflow integration</h3>{[['Tracked effort','7h 38m'],['Last active','Today, 2:42 PM'],['Recent work','API testing & authentication'],['Blocker','External OAuth approval']].map(([l,v])=><span><small>{l}</small><strong>{v}</strong></span>)}<footer><Icon name="bolt"/>External dependency requires attention</footer></article><article class="glass capacity-card"><header><small>Workload management</small><h3>Team capacity</h3></header>{[['Alex','High','9 active tasks',88],['Priya','Moderate','4 active tasks',58],['Jordan','Available','3 active tasks',38]].map(([n,s,t,w])=><div><span><strong>{n}</strong><small>{t}</small></span><i><b style={`--w:${w}%`}></b></i><em>{s}</em></div>)}</article></div></div></section>

    <section class="section"><div class="employee-shell"><div class="section-head center"><span class="eyebrow">Priority, focus & application context</span><h2>Make better decisions about <em>what gets attention.</em></h2></div><div class="signal-card-grid">{[['target','Priority intelligence','Balance business importance with real effort, approaching deadlines, dependencies, and current employee capacity.'],['refresh','Context switching','Reveal fragmented workdays, repeated switching, and interruptions so teams can protect focus for complex tasks.'],['monitor','Application context','Understand the applications, documents, coordination, and workflow patterns supporting each task from start to finish.'],['clock','Historical estimation','Use completed-task effort and delivery patterns to create stronger deadlines, sprint plans, and client commitments.'],['calendar','Repeatable work','Identify recurring tasks that are becoming slower, easier, inconsistent, or strong candidates for automation.'],['link','Connected sources','Bring Ralvie, Jira, and supported task workflows into one connected view with richer execution context.']].map(([icon,n,c],i)=><article class={`glass signal-${i}`}><span><Icon name={icon}/></span><h3>{n}</h3><p>{c}</p></article>)}</div></div></section>

    <section class="section task-dashboard-section soft-mesh"><div class="employee-shell"><div class="section-head center"><span class="eyebrow">Task analytics</span><h2>See more than <em>a list of<br/>open tasks.</em></h2></div><div class="glass task-analytics-dashboard"><header><div><small>Task intelligence</small><h3>Execution dashboard</h3></div><button>Download report</button></header><div class="task-kpis">{[['Open tasks','142'],['In progress','38'],['Completed this week','61'],['Blocked','7'],['High priority','24']].map(([n,v],i)=><article class={`kpi-${i}`}><small>{n}</small><strong>{v}</strong></article>)}</div><div class="task-dashboard-main"><article><header><strong>Task overview</strong><span>All projects</span></header>{[['Implement customer portal','Alex Morgan','High','8h 26m','In progress'],['Responsive QA','Priya Shah','Critical','11h 42m','Review'],['CRM data migration','Jordan Lee','High','7h 38m','Blocked']].map(([n,a,p,t,s],i)=><div><span class="mini-check"></span><strong>{n}<small>{a}</small></strong><b>{p}</b><span>{t}</span><em class={`state-${i}`}>{s}</em></div>)}</article><aside><span><Icon name="sparkles"/></span><small>AI insight</small><p>Three high-priority tasks received limited activity over the last two working days.</p><b>Review workload & dependencies</b></aside></div></div></div></section>

    <section class="section"><div class="employee-shell"><div class="section-head center"><span class="eyebrow">Built for everyday work</span><h2>Task intelligence for <em>every team.</em></h2></div><div class="task-team-grid">{[['wrench','Software & engineering','Coordinate implementation, bugs, QA, research, releases, and technical dependencies with real effort and activity context.'],['sparkles','Product teams','Connect discovery, planning, design, development, validation, and launch tasks to shared priorities and outcomes.'],['megaphone','Marketing','Manage content, campaigns, creative production, SEO, approvals, analytics, and launches with clearer progress visibility.'],['briefcase','Agencies & services','Track customer work, time, capacity, deliverables, and client engagements while protecting quality and margins.'],['squares','Operations','Organize recurring processes, internal requests, ownership, dependencies, and cross-functional operational work.'],['globe','Remote & hybrid','Maintain consistent priorities, workload visibility, and task context across distributed teams, locations, and time zones.']].map(([icon,n,c],i)=><article class={`glass team-${i}`}><span><Icon name={icon}/></span><h3>{n}</h3><p>{c}</p></article>)}</div></div></section>

    <section class="section comparison soft-mesh"><div class="employee-shell"><div class="section-head center"><span class="eyebrow">Before & after Ralvie</span><h2>Turn task tracking into<br/><em>task intelligence.</em></h2></div><div class="compare-table"><div class="compare-row head"><span>Traditional task management</span><span>With Ralvie AI Productivity</span></div>{[['Task status only','Status + activity context'],['Manual progress updates','Work activity supports visibility'],['Time entered separately','Task-level time context'],['Workload based on task count','Workload includes actual effort'],['Frequent status meetings','AI summaries reduce collection'],['Estimates rely on assumptions','Historical effort adds context'],['Blockers discovered late','Activity patterns provide signals']].map(([a,b])=><div class="compare-row"><span><Icon name="x-mark"/>{a}</span><span><Icon name="check"/>{b}</span></div>)}</div></div></section>

    <section class="section soft-mesh" id="how-it-works"><div class="employee-shell"><div class="section-head center"><span class="eyebrow">Assign the task. Let intelligence explain what happens next.</span><h2 class="task-how-title">How Ralvie <em>Task Management</em> works.</h2></div><div class="task-workflow-grid">{[['list-check','Create or connect','Create tasks in Ralvie or connect supported workflows without rebuilding the way your team already operates.'],['users','Assign the work','Set the owner, project, priority, status, dates, and dependencies so expectations remain clear.'],['briefcase','Work normally','Continue using the applications, communication tools, and systems your employees already know.'],['target','Capture activity','Automatically collect relevant workplace signals according to your organization’s configuration.'],['sparkles','Add task context','Organize captured activity around the task it supports with useful AI-assisted context.'],['clock','Track effort','Review invested time, recent activity, focus, and contribution to understand the true work involved.'],['document','Generate summaries','Turn underlying activity into clear updates covering progress, blockers, outcomes, and next steps.'],['chart-bar','Analyze & improve','Compare workload, effort, status, and historical patterns to improve prioritization and future planning.']].map(([icon,n,c],i)=><article class={`workflow-${i}`}><small>0{i+1}</small><span><Icon name={icon}/></span><h3>{n}</h3><p>{c}</p></article>)}</div></div></section>

    <section class="section faq soft-mesh"><div class="employee-shell faq-layout"><div class="faq-column faq-column-left"><div class="section-head"><span class="eyebrow">Frequently asked questions</span><h2>Task intelligence, <em>explained.</em></h2><p>Better task management starts with better questions.</p></div><div class="faq-list">{faqs.slice(0,5).map(([q,a],i)=><details open={i===0}><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></div><div class="faq-column"><div class="faq-list">{faqs.slice(5).map(([q,a])=><details><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></div></div></section>

    <ProductivityFinalCta />
  </main><Footer theme="light"/>
</Layout>
