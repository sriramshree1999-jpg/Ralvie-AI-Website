---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';

const title='AI Web Voicebot for Websites | Ralvie AI Frontdesk';
const description='Add an AI voice assistant directly to your website with Ralvie AI Frontdesk. Let visitors speak naturally, qualify as leads, book appointments, access business information, and connect with your team instantly.';
const features=[
 ['microphone','Natural browser conversations','Visitors speak normally, ask follow-ups, change direction, and continue without rigid commands.'],
 ['sparkles','Instant spoken answers','Turn product, service, policy, and support knowledge into a direct conversational response.'],
 ['target','Voice lead qualification','Collect needs, company details, locations, expected usage, and timeline naturally through speech.'],
 ['calendar','Conversational booking','Check connected availability and move a visitor toward a meeting without leaving the conversation.'],
 ['globe','Multilingual and 24/7','Give more visitors a voice experience across languages, devices, time zones, and business hours.'],
 ['users','Human escalation','Capture context and guide visitors toward sales, support, callbacks, or another configured handoff.'],
];
const sources=[['globe','Websites'],['document','Documents'],['link','APIs'],['database','Databases'],['users','CRMs'],['squares','Business systems']];
const pages=[['home','Homepage'],['sparkles','Product pages'],['chart-bar','Pricing'],['building','Industries'],['headset','Support'],['document','Blog content']];
const industries=[['sparkles','SaaS & technology'],['building','Hospitality'],['heart','Healthcare & clinics'],['home','Real estate'],['wrench','Automotive'],['academic-cap','Education']];
const faqs=[
 ['What is an AI Web Voicebot?','A voice-based conversational AI embedded into a website. Visitors speak through their browser, hear responses, ask follow-up questions, and interact with configured business workflows.'],
 ['Do visitors need to call or download anything?','No. A supported browser and microphone allow the conversation to happen directly on the website without a separate phone call or application.'],
 ['Can it answer questions about our business?','Yes. Ralvie can use approved business knowledge and connected information sources to answer relevant visitor questions.'],
 ['Can the Web Voicebot qualify leads?','Yes. It can ask configured qualification questions and collect relevant customer information during the voice conversation.'],
 ['Can visitors book appointments through voice?','Ralvie can connect with supported scheduling workflows and guide visitors toward available appointments.'],
 ['Can it access dynamic business information?','With appropriate integrations, Ralvie can participate in workflows involving APIs, databases, CRMs, calendars, and other systems.'],
 ['Does it work on mobile websites?','The Web Voice experience can be designed responsively for compatible mobile and desktop browsers.'],
 ['Does Ralvie support multiple languages?','Ralvie supports multilingual customer experiences across its AI Frontdesk capabilities.'],
 ['Can we customize the voice and greeting?','The experience can use supported voice settings, custom greetings, conversational instructions, and brand-appropriate tone.'],
 ['Can we customize how the widget looks?','Yes. Placement, visual treatment, activation, and related interface elements can align with your website brand.'],
 ['What happens when human assistance is needed?','Configured escalation workflows can guide visitors toward the appropriate team, callback, appointment, or human-support action.'],
];
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---

<Layout title={title} description={description}>
  <Header title="Ralvie AI" theme="light" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  <main class="voice-page pt-(--header-height)">
    <section class="hero"><div class="mesh"><i></i><i></i><i></i></div><div class="container-page hero-grid">
      <div class="hero-copy reveal"><span class="eyebrow"><i></i> AI web voicebot</span><h1><span class="hero-line ink">Let Visitors</span><span class="hero-line ink">Talk to</span><span class="hero-line">Your Website.</span></h1><p class="lead">No phone call. No typing. No waiting. Just tap and talk.</p><p>Ralvie adds a real-time AI voice experience directly to your website so visitors can ask questions, explore products, qualify their needs, and book appointments naturally.</p><div class="hero-actions"><a href="#demo" class="primary">Start your free trial <Icon name="arrow-right"/></a><a href="#demo" class="secondary"><Icon name="calendar"/> Book a demo</a></div><div class="proof"><span>Real-time voice</span><span>24/7 availability</span><span>Multilingual</span><span>Business knowledge</span></div></div>
      <div class="voice-widget-shell reveal" id="voice-demo">
        <div class="widget-intro"><span><i></i>Live AI voice demo</span><h2>Try Ralvie live.</h2><p>Tap the button, allow microphone access, and ask a question.</p></div>
        <div class="widget-rings" aria-hidden="true"><i></i><i></i></div>
        <embeddable-voice id="6f99dc7d-3b52-442b-9941-76cf3b7aff95"></embeddable-voice>
        <div class="voice-prompts"><small>Not sure what to ask?</small><div><button>“What can Ralvie automate?”</button><button>“Can you book a demo?”</button></div><p><Icon name="shield-check"/> Your microphone is only used during the live conversation.</p></div>
      </div>
    </div></section>

    <section class="section intro"><div class="container-page narrow reveal"><span class="eyebrow">A voice shortcut</span><h2>A website visitors can actually talk to.</h2><p>Websites are usually built around clicking, searching, reading, and filling forms. Sometimes the fastest way to get help is simply to ask. Ralvie puts that conversation directly on the page.</p><strong>Website visit → Voice conversation → Business action</strong></div></section>

    <section class="section how" id="how-it-works"><div class="container-page"><div class="section-title reveal"><span class="eyebrow">One natural flow</span><h2>A voice conversation without leaving the website.</h2></div><div class="steps">{[['01','Tap','Activate the voice assistant.'],['02','Speak','Ask naturally in your own words.'],['03','Understand','Ralvie identifies intent and context.'],['04','Respond','Hear an immediate spoken answer.'],['05','Continue','Ask follow-ups naturally.'],['06','Act','Capture, qualify, book, or route.']].map(([num,name,copy])=><article class="step reveal"><b>{num}</b><span><Icon name={name==='Tap'?'microphone':name==='Speak'?'chat':name==='Act'?'bolt':'sparkles'}/></span><h3>{name}</h3><p>{copy}</p></article>)}</div></div></section>

    <section class="section feature-section"><div class="container-page"><div class="section-title reveal"><span class="eyebrow">Conversation, not navigation</span><h2>Give every visitor a faster way to ask.</h2></div><div class="feature-grid">{features.map(([icon,name,copy],i)=><article class:list={['card reveal',i<2?'wide':'']}><span class="icon"><Icon name={icon}/></span><h3>{name}</h3><p>{copy}</p></article>)}</div></div></section>

    <section class="section context-section"><div class="container-page split"><div class="context-browser reveal"><div class="browser-bar"><i></i><i></i><i></i><span>ralvie.ai/enterprise</span></div><div class="page-preview"><small>ENTERPRISE AI FRONTDESK</small><h3>One intelligent front desk.<br/>Every customer channel.</h3><button><Icon name="microphone"/> Talk to Ralvie</button><div class="context-bubble"><span>Page context detected</span><p>Visitor asks: “How does this work?”</p><b>Answering for Enterprise AI Frontdesk</b></div></div></div><div class="reveal"><span class="eyebrow">Page-aware conversations</span><h2>Know what page the visitor is viewing.</h2><p class="large">When someone asks “How does this work?” on an enterprise or product page, Ralvie can use the page and conversation context to give a more relevant answer.</p></div></div></section>

    <section class="section knowledge"><div class="container-page"><div class="section-title reveal"><span class="eyebrow">Connected knowledge</span><h2>Let your Web Voicebot know your business.</h2><p>Combine approved static information with live data from the systems behind your operation.</p></div><div class="source-grid">{sources.map(([icon,name])=><article class="source reveal"><span><Icon name={icon}/></span><b>{name}</b><small>Voice-ready context</small></article>)}</div></div></section>

    <section class="section conversion"><div class="container-page split"><div class="reveal"><span class="eyebrow">Conversation becomes conversion</span><h2>Qualify and book while they’re still talking.</h2><p class="large">Gather requirements one question at a time, identify a strong opportunity, check availability, and guide the visitor toward a meeting—all without a form.</p><div class="checks"><span><Icon name="check"/> Lead requirements captured naturally</span><span><Icon name="check"/> Qualification completed in context</span><span><Icon name="check"/> Appointment workflow connected</span></div></div><div class="booking-card reveal"><header><span><Icon name="sparkles"/></span><div><small>Voice lead qualified</small><b>Enterprise hotel group</b></div><em>High intent</em></header><dl><div><dt>Properties</dt><dd>7 hotels</dd></div><div><dt>Interest</dt><dd>Phone + website automation</dd></div><div><dt>Requirement</dt><dd>After-hours coverage</dd></div><div><dt>Preferred time</dt><dd>Thursday afternoon</dd></div></dl><footer><Icon name="calendar"/><div><small>Next action</small><b>Enterprise demo requested</b></div><Icon name="check"/></footer></div></div></section>

    <section class="section everywhere"><div class="container-page"><div class="section-title reveal"><span class="eyebrow">Voice across your website</span><h2>One consistent assistant on every important page.</h2></div><div class="page-grid">{pages.map(([icon,name])=><article class="page-card reveal"><span><Icon name={icon}/></span><h3>{name}</h3><small>Visitors can simply ask <Icon name="arrow-right"/></small></article>)}</div></div></section>

    <section class="section states"><div class="container-page split"><div class="state-visual reveal"><div class="mini-orb"><Icon name="microphone"/></div><div class="state-list"><button class="active"><i></i><span><b>Ready</b><small>Tap to talk</small></span></button><button><i></i><span><b>Listening</b><small>Visitor is speaking</small></span></button><button><i></i><span><b>Thinking</b><small>Understanding context</small></span></button><button><i></i><span><b>Speaking</b><small>Ralvie is responding</small></span></button></div></div><div class="reveal"><span class="eyebrow">Clear voice feedback</span><h2>Listening. Thinking. Speaking.</h2><p class="large">A modern interface makes every voice state obvious through responsive waveform activity, status text, and subtle visual feedback.</p></div></div></section>

    <section class="section insights"><div class="container-page"><div class="section-title reveal"><span class="eyebrow">Conversation intelligence</span><h2>See what visitors are talking about.</h2></div><div class="dashboard reveal"><div class="metrics">{[['Voice conversations','342'],['Leads captured','48'],['Meetings requested','17'],['Resolved by AI','214'],['Human follow-ups','21'],['Avg. duration','2m 18s']].map(([name,value])=><div><small>{name}</small><b>{value}</b></div>)}</div><div class="conversation-row"><span>SM</span><div><small>Enterprise AI Frontdesk</small><b>Evaluating multi-location solution</b><p>Seven hotels · Phone and website automation · After-hours coverage</p></div><em>Demo requested</em></div></div></div></section>

    <section class="section industries"><div class="container-page"><div class="section-title reveal"><span class="eyebrow">Built for products that need explanation</span><h2>Let visitors experience the answer.</h2></div><div class="industry-grid">{industries.map(([icon,name])=><article class="industry reveal"><span><Icon name={icon}/></span><h3>{name}</h3><small>Explore voice use case <Icon name="arrow-right"/></small></article>)}</div></div></section>

    <section class="section comparison"><div class="container-page split"><div class="reveal"><span class="eyebrow">A more conversational website</span><h2>Ask directly instead of searching again.</h2><p class="large">Give visitors immediate help and your team richer customer intent.</p></div><div class="comparison-list reveal">{[['Browse multiple pages','Ask directly'],['Click and read','Speak naturally'],['Search for follow-ups','Continue the conversation'],['Static contact form','Conversational lead capture'],['Separate booking flow','Book while speaking'],['Page analytics only','Conversation intelligence']].map(([oldWay,newWay])=><div><span><Icon name="x-mark"/>{oldWay}</span><b><Icon name="check"/>{newWay}</b></div>)}</div></div></section>

    <section class="section faq"><div class="container-page faq-grid"><div class="reveal"><span class="eyebrow">Questions, answered</span><h2>Everything you need to know.</h2><p>See how Web Voice can fit your website, brand, knowledge, and workflows.</p><a href="#demo" class="text-link">Talk to our team <Icon name="arrow-right"/></a></div><div>{faqs.map(([q,a],i)=><details class="reveal" open={i===0}><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></div></section>

    <section class="final-cta" id="demo"><div class="mesh dark"><i></i><i></i><i></i></div><div class="container-page reveal"><span class="eyebrow">Meet Ralvie AI Frontdesk</span><h2>Turn Every Customer Conversation <span class="cta-keep">Into Action.</span></h2><p class="cta-description">Ralvie AI Frontdesk helps your business answer, understand, and act across every customer channel<br/>—voice calls, website chat, web voice, email, SMS, forms, and CRM. Be available 24/7. Respond instantly.<br/>Capture more opportunities. Connect every conversation to the right next step.</p><div class="cta-actions"><a href="#" class="primary">Try Ralvie AI Frontdesk <Icon name="arrow-right"/></a><a href="#" class="secondary dark-button"><Icon name="calendar"/> Book a Demo</a></div><small>One AI Frontdesk. Every customer channel. Always ready.</small></div></section>
  </main>
  <Footer theme="light" />
</Layout>

<script is:inline src="https://cdn.247aireceptionist.com/script.js"></script>
<script>
  const centerVoiceWidget=()=>{const widget=document.querySelector<HTMLElement>('embeddable-voice');if(!widget)return;const apply=()=>{const root=widget.shadowRoot;if(!root)return false;let style=root.querySelector<HTMLStyleElement>('#ralvie-hero-position');if(!style){style=document.createElement('style');style.id='ralvie-hero-position';style.textContent='.widget-wrapper{position:relative!important;inset:auto!important;top:auto!important;right:auto!important;bottom:auto!important;left:auto!important;margin:auto!important;z-index:2!important}.floating-text{white-space:nowrap}';root.appendChild(style)}return true};if(apply())return;const observer=new MutationObserver(()=>{if(apply())observer.disconnect()});observer.observe(widget,{attributes:true,childList:true,subtree:true});setTimeout(()=>observer.disconnect(),10000)};centerVoiceWidget();document.addEventListener('astro:page-load',centerVoiceWidget);
</script>

<style>
  .voice-page{--ink:#151c43;--muted:#626984;--line:rgba(38,47,93,.12);background:#fbfcff;color:var(--ink);overflow:hidden}.voice-page :global(h1),.voice-page :global(h2),.voice-page :global(h3){letter-spacing:-.035em}.hero{min-height:calc(100vh - var(--header-height));display:flex;align-items:center;position:relative;overflow:hidden;padding:5rem 0 6rem;background:linear-gradient(180deg,#fbfcff,#f3f6ff)}.mesh{position:absolute;inset:0;pointer-events:none}.mesh i{position:absolute;border-radius:50%;filter:blur(90px);opacity:.28}.mesh i:nth-child(1){width:42rem;height:42rem;background:#9bbcff;top:-18rem;right:-8rem}.mesh i:nth-child(2){width:34rem;height:34rem;background:#d8b6ff;bottom:-17rem;left:-7rem}.mesh i:nth-child(3){width:26rem;height:26rem;background:#8ff0ed;top:34%;left:39%;opacity:.18}.hero-grid,.split{display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:center;position:relative}.hero-copy{max-width:680px}.eyebrow{display:inline-flex;align-items:center;gap:.55rem;text-transform:uppercase;letter-spacing:.13em;font:700 .72rem var(--font-label);color:#4b59ac}.eyebrow>i{width:7px;height:7px;border-radius:50%;background:#5d7afb;box-shadow:0 0 0 5px rgba(93,122,251,.12)}h1{font-size:clamp(3.2rem,5.8vw,5.9rem);line-height:.99;margin:1.35rem 0 1.5rem}h1 span{background:linear-gradient(120deg,#3157e8,#8a5fe7);background-clip:text;color:transparent}.hero-copy .lead{font-weight:700;font-size:1.18rem;margin-bottom:.65rem}.hero-copy>p:last-of-type,.large{color:var(--muted);font-size:1.03rem;line-height:1.75}.hero-actions{display:flex;gap:.8rem;margin:2rem 0 1.6rem}.primary,.secondary{display:inline-flex;align-items:center;justify-content:center;gap:.55rem;padding:.9rem 1.25rem;border-radius:12px;font-weight:700;font-size:.88rem}.primary{color:#fff;background:linear-gradient(135deg,#315bea,#7f6cf7);box-shadow:0 14px 32px rgba(61,99,245,.25)}.secondary{color:var(--ink);background:rgba(255,255,255,.75);border:1px solid var(--line)}.primary svg,.secondary svg{width:17px}.proof{display:flex;flex-wrap:wrap;gap:.65rem 1.15rem;color:#727992;font-size:.74rem}.proof span:before{content:'✓';color:#4f70eb;margin-right:.35rem}
  .voice-widget-shell{position:relative;display:grid;place-items:center;width:100%;min-height:600px;padding:2rem;border:1px solid rgba(255,255,255,.92);border-radius:28px;background:rgba(255,255,255,.73);box-shadow:0 30px 75px rgba(53,66,129,.16);backdrop-filter:blur(22px)}.voice-widget-shell embeddable-voice{position:relative;z-index:2;display:block;width:max-content;max-width:100%;min-height:0}.widget-intro{position:absolute;z-index:3;top:2rem;left:1.5rem;right:1.5rem;text-align:center}.widget-intro>span{display:inline-flex;align-items:center;gap:.4rem;padding:.35rem .55rem;border-radius:99px;background:#edf0ff;color:#5365bc;font-size:.52rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em}.widget-intro>span i{width:6px;height:6px;border-radius:50%;background:#2eae80;box-shadow:0 0 0 4px rgba(46,174,128,.1)}.widget-intro h2{margin:.65rem 0 .25rem;font-size:1.35rem}.widget-intro p{color:#7d849a;font-size:.62rem}.widget-rings{position:absolute;left:50%;top:49%;width:170px;height:170px;transform:translate(-50%,-50%);pointer-events:none}.widget-rings i{position:absolute;inset:0;border:1px solid rgba(87,103,225,.24);border-radius:50%;animation:widget-ring 2.8s ease-out infinite}.widget-rings i:nth-child(2){animation-delay:1.4s}.voice-prompts{position:absolute;z-index:3;bottom:1.45rem;left:1.5rem;right:1.5rem;text-align:center}.voice-prompts>small{display:block;margin-bottom:.5rem;color:#8990a5;font-size:.5rem;font-weight:700}.voice-prompts>div{display:flex;justify-content:center;gap:.45rem}.voice-prompts button{padding:.48rem .65rem;border:1px solid rgba(68,86,173,.12);border-radius:99px;background:#f2f4ff;color:#5361a9;font-size:.5rem;transition:.2s}.voice-prompts button:hover{border-color:#7888df;background:#e9edff;transform:translateY(-1px)}.voice-prompts p{display:flex;align-items:center;justify-content:center;gap:.35rem;margin-top:.75rem;color:#9aa0b0;font-size:.45rem}.voice-prompts p svg{width:12px;color:#43a783}@keyframes widget-ring{0%{transform:scale(.72);opacity:.75}100%{transform:scale(2.15);opacity:0}}
  .section{padding:7rem 0}.narrow{max-width:900px;text-align:center}.narrow h2,.section-title h2,.split h2,.faq h2{font-size:clamp(2.35rem,4vw,4rem);line-height:1.08;margin:1rem 0 1.2rem}.narrow p,.section-title>p,.faq-grid>div>p{font-size:1.03rem;line-height:1.8;color:var(--muted)}.narrow strong{display:block;margin-top:1.4rem;color:#4058c6}.section-title{text-align:center;max-width:830px;margin:0 auto 3.5rem}.how{background:#171e49;color:#fff}.how .eyebrow{color:#aab6ff}.steps{display:grid;grid-template-columns:repeat(6,1fr);gap:.7rem}.step{padding:1.2rem;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.11);border-radius:16px}.step>b{color:#6878af;font-size:.6rem}.step>span{display:grid;place-items:center;width:38px;height:38px;border-radius:11px;background:#293463;color:#a3b1ff;margin:.8rem 0}.step>span svg{width:18px}.step h3{font-size:.78rem}.step p{font-size:.6rem;color:#aab2cf;line-height:1.5;margin-top:.3rem}.feature-section{background:linear-gradient(180deg,#f4f6ff,#fbfcff)}.feature-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:1rem}.card{grid-column:span 2;padding:1.55rem;background:#fff;border:1px solid var(--line);border-radius:20px}.card.wide{grid-column:span 3}.icon,.source>span,.page-card>span,.industry>span{display:grid;place-items:center;width:44px;height:44px;border-radius:13px;margin-bottom:1.1rem}.card:nth-child(1) .icon,.source:nth-child(1)>span,.page-card:nth-child(1)>span,.industry:nth-child(1)>span{color:#4777ed;background:#e5eeff}.card:nth-child(2) .icon,.source:nth-child(2)>span,.page-card:nth-child(2)>span,.industry:nth-child(2)>span{color:#ec5e75;background:#ffe7eb}.card:nth-child(3) .icon,.source:nth-child(3)>span,.page-card:nth-child(3)>span,.industry:nth-child(3)>span{color:#8b61ee;background:#f0e8ff}.card:nth-child(4) .icon,.source:nth-child(4)>span,.page-card:nth-child(4)>span,.industry:nth-child(4)>span{color:#19a978;background:#def8ec}.card:nth-child(5) .icon,.source:nth-child(5)>span,.page-card:nth-child(5)>span,.industry:nth-child(5)>span{color:#de6a31;background:#fff0e6}.card:nth-child(6) .icon,.source:nth-child(6)>span,.page-card:nth-child(6)>span,.industry:nth-child(6)>span{color:#249db5;background:#e1f7fb}.card h3,.page-card h3,.industry h3{font-size:1.02rem;margin-bottom:.5rem}.card p{font-size:.85rem;line-height:1.65;color:var(--muted)}
