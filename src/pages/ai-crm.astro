---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';

const title='AI CRM for Customer Conversations | Ralvie AI Frontdesk';
const description='Turn calls, chats, emails, and SMS conversations into structured customer intelligence with Ralvie AI CRM. Automatically capture leads, build customer timelines, summarize interactions, prioritize opportunities, and keep your team updated.';
const capabilities=[
 ['users','Automatic contact capture','Turn customer details from conversations into useful, structured profiles without repetitive data entry.'],
 ['refresh','Unified customer timeline','Connect calls, website chats, emails, appointments, notes, and workflow events in one story.'],
 ['document','AI conversation summaries','Understand what happened, what matters, and what should happen next without rereading every interaction.'],
 ['target','Lead intelligence','Surface buying intent, qualification details, urgency, opportunity signals, and higher-priority prospects.'],
 ['bolt','Suggested next actions','Bring follow-ups, appointments, escalations, and team assignments forward at the right moment.'],
 ['squares','Custom business data','Adapt fields, tags, stages, assignments, and customer views around the way your organization works.'],
];
const events=[
 ['phone','11:42 AM','Phone call','Asked about multi-location support.'],
 ['chat','11:49 AM','Website chat','Compared product capabilities.'],
 ['mail','12:03 PM','Email','Requested enterprise integration details.'],
 ['calendar','12:10 PM','Appointment','Demo requested for Thursday.'],
];
const pipeline=[['New enquiry','12'],['Contacted','8'],['Qualified','6'],['Demo scheduled','4'],['Proposal','3'],['Decision','2']];
const teams=[['target','Sales teams'],['headset','Customer support'],['building','Hospitality'],['home','Real estate'],['heart','Healthcare & clinics'],['briefcase','SaaS & technology']];
const faqs=[
 ['What is an AI CRM?','An AI CRM combines customer relationship management with artificial intelligence to capture, organize, summarize, and interpret customer information more automatically.'],
 ['How is Ralvie AI CRM different from a traditional CRM?','It is designed around conversations generated through AI Frontdesk, allowing interactions to contribute directly to records, timelines, summaries, and lead intelligence.'],
 ['Can Ralvie automatically create and update contacts?','Ralvie can capture customer information from supported interactions and use it within configured customer-management workflows.'],
 ['Can calls, chats, and emails appear in one timeline?','Yes. Supported voice, website chat, email, appointment, and workflow activity can contribute to a connected customer history.'],
 ['Can Ralvie summarize conversations automatically?','Yes. AI-generated summaries help teams understand important context without manually reviewing every interaction.'],
 ['Can it qualify and prioritize leads?','Qualification details and configured business criteria can help organize and surface higher-intent opportunities.'],
 ['Can we create custom fields and tags?','The CRM experience can be structured around your business-specific information, tags, stages, and workflow requirements.'],
 ['Can records be assigned to different teams?','Assignment workflows can route customer records to appropriate teams or users using configured rules.'],
 ['Can Ralvie connect with our existing CRM?','Ralvie can participate in external CRM workflows through supported integrations, APIs, and webhooks.'],
 ['Do we have to replace our existing CRM?','Not necessarily. You can use Ralvie CRM capabilities directly or connect Ralvie customer intelligence with established systems.'],
 ['Is AI CRM part of Ralvie AI Frontdesk?','Yes. AI CRM is the customer intelligence layer connecting information generated across the broader Frontdesk experience.'],
];
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---

<Layout title={title} description={description}>
  <Header title="Ralvie AI" theme="light" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  <main class="crm-page pt-(--header-height)">
    <section class="hero"><div class="mesh"><i></i><i></i><i></i></div><div class="container-page hero-grid">
      <div class="hero-copy reveal"><span class="eyebrow"><i></i> AI-powered CRM</span><h1>Every Customer Conversation. <span>Already Organized.</span></h1><p class="lead">The conversation creates the record.</p><p>Ralvie transforms calls, chats, emails, and appointments into structured customer profiles, summaries, lead intelligence, follow-ups, and activity history—automatically.</p><div class="hero-actions"><a href="#demo" class="primary">Start your free trial <Icon name="arrow-right"/></a><a href="#demo" class="secondary"><Icon name="calendar"/> Book a demo</a></div><div class="proof"><span>Automatic capture</span><span>Unified timeline</span><span>Lead intelligence</span><span>Workflow automation</span></div></div>
      <div class="crm-shell reveal" id="crm-demo"><div class="crm-main"><header><div><small>Customer intelligence</small><b>Sarah Mitchell</b></div></header><div class="profile"><span>SM</span><div><h3>Sarah Mitchell</h3><p>Northline Properties · 18 locations</p><div><i>Qualified lead</i><i>High opportunity score</i></div></div></div><div class="profile-grid"><div><small>Customer interest</small><b>AI Phone Receptionist</b></div><div><small>Primary requirement</small><b>After-hours coverage</b></div><div><small>Timeline</small><b>30–60 days</b></div><div><small>Next action</small><b class="next">Schedule enterprise demo</b></div></div><div class="ai-summary"><span><Icon name="sparkles"/> Latest AI summary</span><p>Sarah is evaluating Ralvie across 18 property locations. Her primary requirement is after-hours call coverage with centralized reporting. She prefers Thursday afternoon for an enterprise demo.</p></div><div class="timeline-mini">{events.map(([icon,time,name,copy])=><article><span><Icon name={icon}/></span><div><small>{time}</small><b>{name}</b><p>{copy}</p></div></article>)}</div></div></div>
    </div></section>

    <section class="section statement"><div class="container-page narrow reveal"><span class="eyebrow">A CRM that listens</span><h2>Your customers are talking. Your CRM should be listening.</h2><p>Traditional CRM systems depend on people remembering to update them. Ralvie turns useful information from customer interactions into structured intelligence as the conversation happens.</p><strong>Less reconstruction. More reliable customer context.</strong></div></section>

    <section class="section soft"><div class="container-page"><div class="section-title reveal"><span class="eyebrow">CRM without constant data entry</span><h2>Let AI capture the details.</h2></div><div class="feature-grid">{capabilities.map(([icon,name,copy],i)=><article class:list={['card reveal', i < 2 ? 'wide' : '']}><span class="icon"><Icon name={icon}/></span><h3>{name}</h3><p>{copy}</p></article>)}</div></div></section>

    <section class="section story"><div class="container-page story-grid"><div class="story-copy reveal"><span class="eyebrow">One customer. One complete story.</span><h2>A unified timeline across every channel.</h2><p>See what customers asked, what they provided, what Ralvie answered, what was promised, and what should happen next.</p><div class="channel-chips"><span><Icon name="phone"/> Voice</span><span><Icon name="chat"/> Chat</span><span><Icon name="mail"/> Email</span><span><Icon name="calendar"/> Meetings</span></div></div><div class="journey reveal">{events.map(([icon,time,name,copy],i)=><article data-event={i}><span><Icon name={icon}/></span><div><small>Today · {time}</small><h3>{name}</h3><p>{copy}</p></div><b>{i+1}</b></article>)}</div></div></section>

    <section class="section extraction"><div class="container-page split"><div class="conversation-card reveal"><div class="conversation-head"><span>Live call transcript</span><i>AI extracting fields</i></div><p>“We have around <mark>25 locations</mark> across <mark>Ontario</mark>. We’re hoping to implement before <mark>October</mark> and currently handle about <mark>5,000 calls</mark> each month.”</p><div class="extract-grid"><span><small>Locations</small><b>25</b></span><span><small>Region</small><b>Ontario</b></span><span><small>Timeline</small><b>Before October</b></span><span><small>Monthly volume</small><b>~5,000 calls</b></span></div></div><div class="reveal"><span class="eyebrow">Intelligent data extraction</span><h2>Let AI find the details hidden inside conversations.</h2><p class="large">Convert natural customer language into searchable fields without making people complete endless forms—or asking your team to type everything again.</p></div></div></section>

    <section class="section pipeline-section"><div class="container-page"><div class="section-title reveal"><span class="eyebrow">From conversation to opportunity</span><h2>Your pipeline can start building itself.</h2><p>Design stages around the way your business sells and keep every opportunity’s next action visible.</p></div><div class="pipeline" data-pipeline>{pipeline.map(([name,count],i)=><div class="stage reveal"><header><b>{name}</b><span>{count}</span></header>{i < 4 ? <article><span>{['SM','MC','ER','JL'][i]}</span><div><b>{['Sarah Mitchell','Marcus Chen','Emily Robertson','James Lee'][i]}</b><small>{['Enterprise · Demo requested','Pricing enquiry','Product questions','Proposal review'][i]}</small></div></article> : null}<i style={`--progress:${100-i*13}%`}></i></div>)}</div></div></section>

    <section class="section intelligence"><div class="container-page split"><div class="reveal"><span class="eyebrow">AI lead intelligence</span><h2>Find your best opportunities faster.</h2><p class="large">Prioritize using product interest, company size, timeline, requested actions, qualification responses, and conversation activity.</p><div class="checks"><span><Icon name="check"/> Buying intent surfaced</span><span><Icon name="check"/> Qualification already captured</span><span><Icon name="check"/> Suggested next action ready</span></div></div><div class="lead-stack reveal"><article class="high"><b>High priority</b><div><span>SM</span><p><strong>Sarah Mitchell</strong><small>18 locations · Demo requested</small></p><em>92</em></div></article><article><b>Medium priority</b><div><span>MC</span><p><strong>Marcus Chen</strong><small>Pricing enquiry · Evaluating</small></p><em>68</em></div></article><article><b>Early stage</b><div><span>ER</span><p><strong>Emily Robertson</strong><small>General product questions</small></p><em>41</em></div></article></div></div></section>

    <section class="section actions"><div class="container-page"><div class="section-title reveal"><span class="eyebrow">Know what happens next</span><h2>Turn customer context into action.</h2></div><div class="action-grid">{[['calendar','Demo requested','Schedule appointment','Find the right time and move the customer directly into your booking workflow.'],['target','High-intent lead','Notify sales team','Alert sales immediately with the customer’s interest, requirements, and conversation context.'],['refresh','Waiting for customer','Follow up in 3 days','Create a timely reminder so valuable conversations keep moving without manual tracking.'],['headset','Question unresolved','Assign to support','Route unresolved questions to the right support specialist with the full interaction history.'],['users','Human requested','Create escalation task','Bring in a team member with the customer details and reason for escalation already included.'],['bolt','Qualified opportunity','Trigger CRM workflow','Start the appropriate CRM sequence automatically when qualification criteria are met.']].map(([icon,signal,action,copy])=><article class="action reveal"><span><Icon name={icon}/></span><small>{signal}</small><h3>{action}</h3><p>{copy}</p></article>)}</div></div></section>

    <section class="section customize"><div class="container-page split"><div class="field-cloud reveal"><span>Company size</span><span>Property interest</span><span>Monthly calls</span><span>Lead source</span><span>Decision timeline</span><span>Assigned team</span><span>Opportunity value</span><span>Custom tags</span><span>Viewing status</span></div><div class="reveal"><span class="eyebrow">Built around your business</span><h2>Custom fields for the information that actually matters.</h2><p class="large">Hospitality, real estate, automotive, SaaS, healthcare, and sales teams all collect different context. Your CRM should adapt to your workflow—not the other way around.</p></div></div></section>

    <section class="section dashboard-section"><div class="container-page"><div class="section-title reveal"><span class="eyebrow">CRM intelligence</span><h2>See more than contact counts.</h2></div><div class="dashboard reveal"><div class="metrics">{[['New leads','42','+12%'],['Qualified','18','+8%'],['Appointments','12','+16%'],['Needs follow-up','9','-6%'],['Active opportunities','31','+10%'],['High-priority','7','+3%']].map(([name,value,change])=><div><small>{name}</small><b>{value}</b><em>{change}</em></div>)}</div><div class="dashboard-bottom"><div class="source-chart"><b>Lead sources</b>{[['Phone calls','38%'],['Website chat','29%'],['Email','21%'],['Other','12%']].map(([name,value])=><p><span>{name}</span><i style={`--w:${value}`}></i><small>{value}</small></p>)}</div><div class="activity"><b>Recent intelligence</b><p><span class="green"></span>Enterprise lead qualified <small>2m</small></p><p><span class="blue"></span>Demo added to Sarah’s timeline <small>8m</small></p><p><span class="orange"></span>Follow-up due for Marcus <small>14m</small></p></div></div></div></div></section>

    <section class="section ecosystem"><div class="container-page"><div class="section-title reveal"><span class="eyebrow">Customer context across Frontdesk</span><h2>Every channel contributes to one customer story.</h2></div><div class="ecosystem-flow reveal"><div><Icon name="phone"/><b>Phone</b></div><div><Icon name="chat"/><b>Website chat</b></div><span class="crm-core"><Icon name="database"/><b>AI CRM</b><small>Customer intelligence</small></span><div><Icon name="mail"/><b>Email</b></div><div><Icon name="calendar"/><b>Appointments</b></div></div></div></section>

    <section class="section teams"><div class="container-page"><div class="section-title reveal"><span class="eyebrow">For teams managing relationships</span><h2>Context for everyone who serves the customer.</h2></div><div class="team-grid">{teams.map(([icon,name])=><article class="team reveal"><span><Icon name={icon}/></span><h3>{name}</h3><small>Explore workflow <Icon name="arrow-right"/></small></article>)}</div></div></section>

    <section class="section comparison soft"><div class="container-page split"><div class="reveal"><span class="eyebrow">Conversation-driven CRM</span><h2>Keep customer intelligence connected to reality.</h2><p class="large">The next conversation starts with context—not discovery from zero.</p></div><div class="comparison-list reveal">{[['Manual contact creation','Conversation-driven capture'],['Separate channel notes','Unified timeline'],['Read every interaction','AI summaries'],['Rep-driven qualification','AI-assisted intelligence'],['Remember follow-ups','Next actions surfaced'],['Static customer database','Operational workflows']].map(([oldWay,newWay])=><div><span><Icon name="x-mark"/>{oldWay}</span><b><Icon name="check"/>{newWay}</b></div>)}</div></div></section>

    <section class="section faq"><div class="container-page faq-grid"><div class="reveal"><span class="eyebrow">Questions, answered</span><h2>Everything you need to know.</h2><p>See how AI CRM can fit your customer journey and existing systems.</p><a href="#demo" class="text-link">Talk to our team <Icon name="arrow-right"/></a></div><div>{faqs.map(([q,a],i)=><details class="reveal" open={i===0}><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></div></section>

    <section class="final-cta" id="demo"><div class="mesh dark"><i></i><i></i><i></i></div><div class="container-page reveal"><span class="eyebrow">Meet Ralvie AI Frontdesk</span><h2>Turn Every Customer Conversation <span class="cta-keep">Into Action.</span></h2><p class="cta-description">Ralvie AI Frontdesk helps your business answer, understand, and act across every customer channel<br/>—voice calls, website chat, web voice, email, SMS, forms, and CRM. Be available 24/7. Respond instantly.<br/>Capture more opportunities. Connect every conversation to the right next step.</p><div class="cta-actions"><a href="#" class="primary">Try Ralvie AI Frontdesk <Icon name="arrow-right"/></a><a href="#" class="secondary dark-button"><Icon name="calendar"/> Book a Demo</a></div><small>One AI Frontdesk. Every customer channel. Always ready.</small></div></section>
  </main>
  <Footer theme="light" />
</Layout>

<style>
  .crm-page{--ink:#151c43;--muted:#626984;--line:rgba(38,47,93,.12);background:#fbfcff;color:var(--ink);overflow:hidden}.crm-page :global(h1),.crm-page :global(h2),.crm-page :global(h3){letter-spacing:-.035em}.hero{min-height:calc(100vh - var(--header-height));display:flex;align-items:center;position:relative;overflow:hidden;padding:5rem 0 6rem;background:linear-gradient(180deg,#fbfcff,#f3f6ff)}.mesh{position:absolute;inset:0;pointer-events:none}.mesh i{position:absolute;border-radius:50%;filter:blur(90px);opacity:.27}.mesh i:nth-child(1){width:42rem;height:42rem;background:#9bbcff;top:-18rem;right:-8rem}.mesh i:nth-child(2){width:34rem;height:34rem;background:#d8b6ff;bottom:-17rem;left:-7rem}.mesh i:nth-child(3){width:26rem;height:26rem;background:#8ff0ed;top:34%;left:39%;opacity:.18}.hero-grid,.split{display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:center;position:relative}.hero-copy{max-width:680px}.eyebrow{display:inline-flex;align-items:center;gap:.55rem;text-transform:uppercase;letter-spacing:.13em;font:700 .72rem var(--font-label);color:#4b59ac}.eyebrow>i{width:7px;height:7px;border-radius:50%;background:#5d7afb;box-shadow:0 0 0 5px rgba(93,122,251,.12)}h1{font-size:clamp(3rem,5.55vw,5.7rem);line-height:1;margin:1.35rem 0 1.5rem}h1 span{background:linear-gradient(120deg,#3157e8,#8a5fe7);background-clip:text;color:transparent}.hero-copy .lead{font-weight:700;font-size:1.18rem;margin-bottom:.65rem}.hero-copy>p:last-of-type,.large{color:var(--muted);font-size:1.03rem;line-height:1.75}.hero-actions{display:flex;gap:.8rem;margin:2rem 0 1.6rem}.primary,.secondary{display:inline-flex;align-items:center;justify-content:center;gap:.55rem;padding:.9rem 1.25rem;border-radius:12px;font-weight:700;font-size:.88rem}.primary{color:#fff;background:linear-gradient(135deg,#315bea,#7f6cf7);box-shadow:0 14px 32px rgba(61,99,245,.25)}.secondary{color:var(--ink);background:rgba(255,255,255,.75);border:1px solid var(--line)}.primary svg,.secondary svg{width:17px}.proof{display:flex;flex-wrap:wrap;gap:.65rem 1.15rem;color:#727992;font-size:.74rem}.proof span:before{content:'✓';color:#4f70eb;margin-right:.35rem}
  .crm-shell{height:610px;display:grid;grid-template-columns:1fr;border:1px solid rgba(255,255,255,.9);border-radius:24px;background:rgba(255,255,255,.78);box-shadow:0 30px 75px rgba(53,66,129,.17);backdrop-filter:blur(22px);overflow:hidden}.crm-main{padding:1.15rem;background:#fafbff;overflow:hidden}.crm-main>header{display:flex;align-items:center;padding-bottom:.8rem;border-bottom:1px solid var(--line)}.crm-main header small,.crm-main header b{display:block}.crm-main header small{font-size:.55rem;color:#9198aa}.crm-main header b{font-size:.8rem;margin-top:.15rem}.profile{display:flex;align-items:center;gap:.75rem;padding:1rem 0}.profile>span{display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:#e7ebff;color:#4a5fc7;font-size:.7rem;font-weight:700}.profile h3{font-size:.86rem}.profile p{font-size:.58rem;color:#8a91a7}.profile>div>div{display:flex;gap:.35rem;margin-top:.4rem}.profile i{padding:.25rem .38rem;border-radius:99px;background:#e8f8f2;color:#298e70;font-size:.45rem;font-style:normal}.profile i+ i{background:#edf0ff;color:#5365ce}.profile-grid{display:grid;grid-template-columns:1fr 1fr;gap:.55rem}.profile-grid>div{padding:.65rem;background:#fff;border:1px solid var(--line);border-radius:10px}.profile-grid small,.profile-grid b{display:block}.profile-grid small{font-size:.47rem;color:#9298aa}.profile-grid b{font-size:.59rem;margin-top:.2rem}.profile-grid .next{color:#4059c7}.ai-summary{margin:.7rem 0;padding:.7rem;border:1px solid #dce2ff;background:#f0f3ff;border-radius:11px}.ai-summary>span{display:flex;align-items:center;gap:.35rem;color:#485ab6;font-size:.52rem;font-weight:700}.ai-summary svg{width:13px}.ai-summary p{min-height:57px;margin-top:.4rem;color:#59617f;font-size:.53rem;line-height:1.5}.timeline-mini{display:grid;grid-template-columns:1fr 1fr;gap:.45rem}.timeline-mini article{display:flex;gap:.5rem;padding:.55rem;background:#fff;border:1px solid var(--line);border-radius:10px}.timeline-mini article>span{display:grid;place-items:center;width:28px;height:28px;border-radius:8px;background:#edf0ff;color:#5569d7}.timeline-mini svg{width:14px}.timeline-mini small,.timeline-mini b,.timeline-mini p{display:block}.timeline-mini small{font-size:.43rem;color:#999faf}.timeline-mini b{font-size:.55rem}.timeline-mini p{font-size:.45rem;color:#7c8399;margin-top:.12rem}
  .section{padding:7rem 0}.narrow{max-width:900px;text-align:center}.narrow h2,.section-title h2,.story h2,.split h2,.faq h2{font-size:clamp(2.35rem,4vw,4rem);line-height:1.08;margin:1rem 0 1.2rem}.narrow p,.section-title>p,.story-copy>p,.faq-grid>div>p{font-size:1.03rem;line-height:1.8;color:var(--muted)}.narrow strong{display:block;margin-top:1.4rem;color:#4058c6}.soft{background:linear-gradient(180deg,#f4f6ff,#fbfcff)}.section-title{text-align:center;max-width:830px;margin:0 auto 3.5rem}.feature-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:1rem}.card{grid-column:span 2;padding:1.55rem;background:#fff;border:1px solid var(--line);border-radius:20px}.card.wide{grid-column:span 3}.icon,.action>span,.team>span{display:grid;place-items:center;width:45px;height:45px;border-radius:13px;margin-bottom:1.1rem}.card:nth-child(1) .icon,.action:nth-child(1)>span,.team:nth-child(1)>span{color:#4777ed;background:#e5eeff}.card:nth-child(2) .icon,.action:nth-child(2)>span,.team:nth-child(2)>span{color:#ec5e75;background:#ffe7eb}.card:nth-child(3) .icon,.action:nth-child(3)>span,.team:nth-child(3)>span{color:#8b61ee;background:#f0e8ff}.card:nth-child(4) .icon,.action:nth-child(4)>span,.team:nth-child(4)>span{color:#19a978;background:#def8ec}.card:nth-child(5) .icon,.action:nth-child(5)>span,.team:nth-child(5)>span{color:#de6a31;background:#fff0e6}.card:nth-child(6) .icon,.action:nth-child(6)>span,.team:nth-child(6)>span{color:#249db5;background:#e1f7fb}.card h3,.action h3,.team h3{font-size:1.02rem;margin-bottom:.5rem}.card p{font-size:.85rem;line-height:1.65;color:var(--muted)}
  .story{background:#171e49;color:#fff}.story-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:6rem;align-items:center}.story .eyebrow{color:#aab6ff}.story-copy>p{color:#b9c1dd}.channel-chips{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.4rem}.channel-chips span{display:flex;align-items:center;gap:.4rem;padding:.45rem .6rem;border:1px solid rgba(255,255,255,.12);border-radius:99px;color:#aeb7d8;font-size:.62rem}.channel-chips svg{width:14px}.journey{position:relative}.journey:before{content:'';position:absolute;left:21px;top:25px;bottom:25px;width:1px;background:rgba(255,255,255,.17)}.journey article{position:relative;display:grid;grid-template-columns:44px 1fr auto;gap:.8rem;align-items:center;padding:.75rem 0}.journey article>span{z-index:1;display:grid;place-items:center;width:43px;height:43px;border-radius:50%;background:#273260;border:1px solid #47568f;color:#9fafff}.journey article>span svg{width:18px}.journey small{font-size:.5rem;color:#8f98ba}.journey h3{font-size:.8rem}.journey p{font-size:.6rem;color:#aeb6d1}.journey article>b{color:#53638f;font-size:1.4rem}.extraction{background:#f4f6ff}.conversation-card{padding:1.4rem;background:#fff;border:1px solid var(--line);border-radius:21px;box-shadow:0 25px 60px rgba(56,68,128,.11)}.conversation-head{display:flex;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:.8rem;font-size:.62rem;font-weight:700}.conversation-head i{color:#278e70;font-style:normal}.conversation-card>p{padding:1.2rem 0;font-size:.83rem;line-height:1.8;color:#555d78}.conversation-card mark{padding:.1rem .2rem;background:#e9edff;color:#4054b5;border-radius:3px}.extract-grid{display:grid;grid-template-columns:1fr 1fr;gap:.55rem}.extract-grid span{padding:.7rem;background:#f6f8ff;border-radius:10px}.extract-grid small,.extract-grid b{display:block}.extract-grid small{font-size:.5rem;color:#8c93a7}.extract-grid b{font-size:.66rem;margin-top:.2rem}
