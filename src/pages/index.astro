      <script is:inline>
        (() => {
          const carousel = document.querySelector('.customer-voice-grid');
          const track = carousel?.querySelector('.customer-voice-track');
          const previous = carousel?.querySelector('[data-customer-voice-prev]');
          const next = carousel?.querySelector('[data-customer-voice-next]');
          if (!carousel || !track || !previous || !next) return;

          const storyCount = 5;
          let index = 0;
          let timer;

          const stepWidth = () => {
            const card = track.querySelector('.customer-voice-card');
            const set = track.querySelector('.customer-voice-set');
            return card ? card.getBoundingClientRect().width + parseFloat(getComputedStyle(set).gap || '0') : 0;
          };
          const render = (animate = true) => {
            track.style.transition = animate ? 'transform 600ms cubic-bezier(.22,.75,.25,1)' : 'none';
            track.style.transform = `translate3d(${-index * stepWidth()}px,0,0)`;
          };
          const moveNext = () => {
            index += 1;
            render();
          };
          const movePrevious = () => {
            if (index === 0) {
              index = storyCount;
              render(false);
              track.getBoundingClientRect();
            }
            index -= 1;
            render();
          };
          const restart = () => {
            window.clearInterval(timer);
            timer = window.setInterval(moveNext, 8000);
          };

          track.addEventListener('transitionend', () => {
            if (index >= storyCount) {
              index = 0;
              render(false);
            }
          });
          previous.addEventListener('click', () => { movePrevious(); restart(); });
          next.addEventListener('click', () => { moveNext(); restart(); });
          window.addEventListener('resize', () => render(false));
          render(false);
          restart();
        })();
      </script>
