---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import OtherFrontdeskFeatures from '../components/OtherFrontdeskFeatures.astro';

const title = 'AI Email Manager for Business | Ralvie AI Frontdesk';
const description = 'Manage business email with Ralvie AI Frontdesk. Automatically organize your inbox, draft contextual replies, identify leads, summarize threads, prioritize important messages, and connect email conversations with your business workflows.';
const features = [
  ['mail','Understands every email','Analyze the sender, intent, thread history, sentiment, and action required—not only the latest message.'],
  ['squares','Organizes automatically','Apply smart labels such as Needs Reply, Awaiting Reply, Lead, Support, Urgent, and Resolved.'],
  ['sparkles','Prepares contextual drafts','Create useful replies from the full conversation, your instructions, approved knowledge, and preferred tone.'],
  ['target','Detects sales opportunities','Identify buying intent, extract lead details, and surface valuable enquiries before they disappear in the inbox.'],
  ['document','Summarizes long threads','Turn a 30-message conversation into the context, decisions, outstanding questions, and next action.'],
  ['refresh','Keeps follow-ups moving','Surface conversations your team owes, prospects who went quiet, and customers awaiting the next response.'],
];
const labels = [['mail','Needs Reply','12','#476ff0'],['clock','Awaiting Reply','7','#8b63eb'],['target','Leads','5','#18a977'],['headset','Support','9','#e0663e'],['bolt','Urgent','3','#ed5068'],['check','Resolved','26','#2a9daf']];
const sources = [['globe','Websites'],['document','Documents'],['link','APIs'],['database','Databases'],['users','CRMs'],['squares','Business systems']];
const teams = [['target','Sales'],['headset','Customer support'],['briefcase','Front desk & operations'],['building','Hospitality'],['home','Real estate'],['heart','Healthcare & clinics']];
const faqs = [
 ['What is an AI Email Manager?','An AI Email Manager helps understand, organize, prioritize, summarize, and respond to business email while keeping your team involved in important decisions.'],
 ['Can Ralvie automatically organize incoming emails?','Yes. Ralvie can classify email using configured labels based on purpose, status, intent, and your business rules.'],
 ['Can Ralvie draft contextual email replies?','Yes. Drafts can use the full thread, configured instructions, approved business knowledge, and your preferred communication style.'],
 ['Does Ralvie automatically send AI-generated emails?','Automation follows your configured workflow. Important conversations can remain in draft for human approval and editing before anything is sent.'],
 ['Can the AI follow our company tone of voice?','Yes. You can configure tone, formality, length, style, signatures, and instructions for different email scenarios.'],
 ['Can Ralvie summarize long email threads?','Yes. It can produce concise summaries of the context, decisions, outstanding questions, and suggested next action.'],
 ['Can it identify leads and connect them to our CRM?','Ralvie can detect buying intent and participate in CRM workflows through supported integrations, APIs, and webhooks.'],
 ['Can Ralvie help with follow-ups and priority detection?','Yes. It can surface conversations needing action and identify signals such as urgency, frustration, or high buying intent.'],
 ['Can emails be routed to different teams?','Routing can be configured around topic, intent, sender, customer type, label, and other business logic.'],
 ['Can Ralvie work with multiple inboxes?','Yes. Connected inboxes can use their own labels, instructions, routing rules, tone, knowledge, and workflows.'],
];
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---

<Layout title={title} description={description}>
  <Header title="Ralvie AI" theme="light" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  <main class="email-page pt-(--header-height)">
    <section class="hero"><div class="mesh" aria-hidden="true"><i></i><i></i><i></i></div><div class="container-page hero-grid">
      <div class="hero-copy reveal"><span class="eyebrow"><i></i> AI email manager</span><h1>Your Inbox,<br/><span>Managed by AI.</span></h1><p>Ralvie understands intent, prioritizes every email, prepares contextual drafts, summarizes long threads, surfaces leads, and keeps follow-ups moving toward the next action.</p><div class="hero-actions"><a href="https://app.frontdesk.ralvie.ai/login" target="_blank" rel="noopener noreferrer" class="primary">Start your free trial <Icon name="arrow-right"/></a><a href="#demo" class="secondary"><Icon name="calendar"/> Book a demo</a></div><div class="proof"><span>AI drafts</span><span>Smart labels</span><span>Lead detection</span><span>Thread summaries</span></div></div>
      <div class="inbox-shell reveal" id="inbox-demo">
        <aside><div class="inbox-logo" aria-label="Inbox"><Icon name="mail"/></div></aside>
        <div class="mail-view"><div class="mail-toolbar"><div><small>Needs Reply</small><b>Enterprise pricing request</b></div><span>High intent</span></div><div class="sender"><span>DM</span><div><b>David Morgan</b><small>david@northstar.com · 2 min ago</small></div></div><div class="incoming">Hi, we’re evaluating AI reception solutions across 14 locations and would like to understand enterprise pricing.</div><div class="ai-draft"><div class="draft-head"><span><Icon name="sparkles"/> Ralvie AI Draft</span><small data-draft-status>Ready for review</small></div><p data-draft-text></p><div class="draft-actions"><button>Edit draft</button><button class="approve" data-approve>Approve & send</button></div></div></div>
      </div>
    </div></section>

    <section class="section statement"><div class="container-page narrow reveal"><span class="eyebrow">A calmer inbox</span><h2>Email shouldn’t become <span class="heading-accent">another full-time job.</span></h2><p>Finding important messages takes time. Rewriting the same answers takes more. Remembering every follow-up takes even more. Ralvie turns the inbox into an intelligent workflow that understands, organizes, and prepares the work around each decision.</p><strong>Inbox → Understanding → Action</strong></div></section>

    <section class="section soft"><div class="container-page"><div class="section-title reveal"><span class="eyebrow">More than an email writer</span><h2>An AI manager for your inbox.</h2></div><div class="feature-grid">{features.map(([icon,name,copy],i)=><article class:list={['card reveal', i < 2 ? 'wide' : '']}><span class="icon"><Icon name={icon}/></span><h3>{name}</h3><p>{copy}</p></article>)}</div></div></section>

    <section class="section label-section"><div class="container-page split"><div class="reveal"><span class="eyebrow">Smart AI labels</span><h2>Every important email, automatically organized.</h2><p class="large">Stop treating every email equally. Ralvie understands purpose, status, and urgency so your team can see what needs attention first.</p><div class="checks"><span><Icon name="check"/> Custom labels for your workflow</span><span><Icon name="check"/> Intent and sentiment detection</span><span><Icon name="check"/> Automatic status updates</span></div></div><div class="label-grid">{labels.map(([icon,name,count,color])=><article class="label-card reveal" style={`--label:${color}`}><span><Icon name={icon}/></span><div><b>{name}</b><small>AI classified</small></div><strong>{count}</strong></article>)}</div></div></section>

    <section class="section draft-section"><div class="container-page split"><div class="summary-card reveal"><div class="summary-head"><Icon name="document"/><div><b>Conversation summary</b><small>14 messages summarized</small></div></div><p>Northstar Hospitality is evaluating Ralvie AI Frontdesk for 14 locations. The prospect needs after-hours phone coverage and website chat. They requested an enterprise demo next week.</p><div><small>Recommended next action</small><b>Offer demo times and notify enterprise sales.</b></div></div><div class="reveal"><span class="eyebrow">Context in seconds</span><h2>Know what a 30-message thread says without reading all 30.</h2><p class="large">Ralvie distills what happened, what the sender needs, outstanding questions, important decisions, and the best next action.</p></div></div></section>

    <section class="section knowledge"><div class="container-page split"><div class="reveal"><span class="eyebrow">Connected knowledge</span><h2>Your inbox can know your business.</h2><p class="large">Improve every draft with approved product, policy, customer, and operational information—not only the latest email.</p><a href="#demo" class="text-link">Explore connected intelligence <Icon name="arrow-right"/></a></div><div class="source-grid">{sources.map(([icon,name])=><article class="source reveal"><span><Icon name={icon}/></span><b>{name}</b><small>Approved context</small></article>)}</div></div></section>

    <section class="section control-section"><div class="container-page"><div class="section-title reveal"><span class="eyebrow">Human approval where it matters</span><h2>AI handles the work around the decision.</h2><p>Your team remains in control of what is edited, sent, escalated, or handled personally.</p></div><div class="control-grid"><article class="reveal"><span class="control-icon ai"><Icon name="sparkles"/></span><h3>Ralvie can prepare</h3><ul><li>Classification and summaries</li><li>Contextual drafts</li><li>Lead information</li><li>Suggested next actions</li><li>Follow-up recommendations</li></ul></article><article class="reveal"><span class="control-icon human"><Icon name="users"/></span><h3>Your team decides</h3><ul><li>What gets sent</li><li>What gets edited</li><li>What gets escalated</li><li>What needs personal attention</li><li>Where automation is appropriate</li></ul></article></div></div></section>

    <section class="section dashboard-section"><div class="container-page"><div class="section-title reveal"><span class="eyebrow">Every conversation visible</span><h2>See your email activity in<br/>one place.</h2></div><div class="dashboard reveal"><div class="dash-top"><div><small>Email overview</small><h3>Good morning, your inbox is under control.</h3></div><button>This week</button></div><div class="metrics">{[['Emails received','1,284','+12%'],['Needs reply','12','-18%'],['AI drafts','86','+24%'],['Leads detected','19','+7%']].map(([name,value,change])=><div><small>{name}</small><b>{value}</b><em>{change}</em></div>)}</div><div class="activity"><div class="chart" aria-hidden="true">{[42,58,48,74,62,86,68,91,78,96,82,100].map((h)=><i style={`--h:${h}%`}></i>)}</div><div class="activity-list"><b>Priority activity</b><p><span class="dot red"></span>Urgent support request detected <small>2m</small></p><p><span class="dot green"></span>Enterprise lead added to CRM <small>8m</small></p><p><span class="dot blue"></span>Follow-up draft prepared <small>14m</small></p></div></div></div></div></section>

    <section class="section teams"><div class="container-page"><div class="section-title reveal"><span class="eyebrow">Built for teams that live in email</span><h2>One manager. Every business inbox.</h2></div><div class="team-grid">{teams.map(([icon,name])=><article class="team reveal"><span><Icon name={icon}/></span><h3>{name}</h3><small>Explore workflow <Icon name="arrow-right"/></small></article>)}</div></div></section>

    <section class="section comparison soft"><div class="container-page split"><div class="reveal"><span class="eyebrow">Before and after Ralvie</span><h2>Move beyond the manual inbox.</h2><p class="large">Let AI organize and prepare. Let your people decide and connect.</p></div><div class="comparison-list reveal">{[['Manual folders','AI-assisted organization'],['Write every reply','Contextual drafts prepared'],['Read every thread','Instant summaries'],['Notice leads manually','Buying intent detected'],['Remember follow-ups','Follow-ups surfaced'],['Copy into CRM','Connected workflows']].map(([oldWay,newWay])=><div><span><Icon name="x-mark"/>{oldWay}</span><b><Icon name="check"/>{newWay}</b></div>)}</div></div></section>

    <OtherFrontdeskFeatures current="email" />
    <section class="section faq"><div class="container-page faq-grid"><div class="reveal"><span class="eyebrow">Questions, answered</span><h2>Everything you need to know.</h2><p>See how Ralvie can fit your inbox, rules, knowledge, and workflows.</p><a href="#demo" class="text-link">Talk to our team <Icon name="arrow-right"/></a></div><div>{faqs.map(([q,a],i)=><details class="reveal" open={i===0}><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></div></section>

    <section class="final-cta" id="demo"><div class="mesh dark" aria-hidden="true"><i></i><i></i><i></i></div><div class="container-page reveal"><span class="eyebrow">Meet Ralvie AI Frontdesk</span><h2>Turn Every Customer Conversation <span class="cta-keep">Into Action.</span></h2><p class="cta-description">Ralvie AI Frontdesk helps your business answer, understand, and act across every customer channel<br/>—voice calls, website chat, web voice, email, SMS, forms, and CRM. Be available 24/7. Respond instantly.<br/>Capture more opportunities. Connect every conversation to the right next step.</p><div class="cta-actions"><a href="https://app.frontdesk.ralvie.ai/login" target="_blank" rel="noopener noreferrer" class="primary">Try Ralvie AI Frontdesk <Icon name="arrow-right"/></a><a href="#" class="secondary dark-button"><Icon name="calendar"/> Book a Demo</a></div><small>One AI Frontdesk. Every customer channel. Always ready.</small></div></section>
  </main>
  <Footer theme="light" />
</Layout>

<script>
  const setupEmailDemo=()=>{
    const text=document.querySelector<HTMLElement>('[data-draft-text]'); const approve=document.querySelector<HTMLButtonElement>('[data-approve]'); const status=document.querySelector<HTMLElement>('[data-draft-status]');
    if(!text||text.dataset.ready)return;text.dataset.ready='true'; const draft='Hi David,\n\nThanks for reaching out. We’d be happy to help you explore an enterprise setup across your locations. Could you share approximately how many customer enquiries your locations handle each month?';let run=0;
    const type=()=>{const id=++run;text.textContent='';status&&(status.textContent='Ralvie is drafting…');let i=0;const tick=()=>{if(id!==run)return;text.textContent=draft.slice(0,++i);if(i<draft.length)setTimeout(tick,12);else if(status)status.textContent='Ready for review'};setTimeout(tick,450)};type();
    approve?.addEventListener('click',()=>{if(status)status.textContent='Approved & sent ✓';approve.textContent='Sent';approve.classList.add('sent')});
    document.querySelectorAll<HTMLButtonElement>('[data-mail-filter]').forEach(btn=>btn.addEventListener('click',()=>{document.querySelectorAll('[data-mail-filter]').forEach(x=>x.classList.remove('selected'));btn.classList.add('selected');type()}));
  };setupEmailDemo();document.addEventListener('astro:page-load',setupEmailDemo);
</script>

<style>
  .email-page{--ink:#151c43;--muted:#626984;--line:rgba(38,47,93,.12);background:#fbfcff;color:var(--ink);overflow:hidden}.email-page :global(h1),.email-page :global(h2),.email-page :global(h3){letter-spacing:-.035em}.hero{min-height:calc(100vh - var(--header-height));display:flex;align-items:center;position:relative;overflow:hidden;padding:5rem 0 6rem;background:linear-gradient(180deg,#fbfcff,#f4f6ff)}.mesh{position:absolute;inset:0;pointer-events:none}.mesh i{position:absolute;border-radius:50%;filter:blur(90px);opacity:.3}.mesh i:nth-child(1){width:42rem;height:42rem;background:#9bbcff;top:-18rem;right:-8rem}.mesh i:nth-child(2){width:34rem;height:34rem;background:#d8b6ff;bottom:-17rem;left:-7rem}.mesh i:nth-child(3){width:26rem;height:26rem;background:#8ff0ed;top:34%;left:39%;opacity:.2}.hero-grid,.split{display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:center;position:relative}.hero-copy{max-width:680px}.eyebrow{display:inline-flex;align-items:center;gap:.55rem;text-transform:uppercase;letter-spacing:.13em;font:700 .72rem var(--font-label);color:#4b59ac}.eyebrow>i{width:7px;height:7px;border-radius:50%;background:#5d7afb;box-shadow:0 0 0 5px rgba(93,122,251,.12)}h1{font-size:clamp(3.2rem,6vw,6.2rem);line-height:.99;margin:1.35rem 0 1.5rem}h1 span{background:linear-gradient(120deg,#3157e8,#8a5fe7);background-clip:text;color:transparent}.hero-copy .lead{font-weight:700;font-size:1.18rem;margin-bottom:.65rem}.hero-copy>p:last-of-type,.large{color:var(--muted);font-size:1.03rem;line-height:1.75}.hero-actions{display:flex;gap:.8rem;margin:2rem 0 1.6rem}.primary,.secondary{display:inline-flex;align-items:center;justify-content:center;gap:.55rem;padding:.9rem 1.25rem;border-radius:12px;font-weight:700;font-size:.88rem}.primary{color:#fff;background:linear-gradient(135deg,#315bea,#7f6cf7);box-shadow:0 14px 32px rgba(61,99,245,.25)}.secondary{color:var(--ink);background:rgba(255,255,255,.75);border:1px solid var(--line)}.primary svg,.secondary svg{width:17px}.proof{display:flex;flex-wrap:wrap;gap:.65rem 1.15rem;color:#727992;font-size:.74rem}.proof span:before{content:'✓';color:#4f70eb;margin-right:.35rem}
  .inbox-shell,.card,.label-card,.summary-card,.dashboard{background:rgba(255,255,255,.76);border:1px solid rgba(255,255,255,.92);box-shadow:0 30px 70px rgba(61,77,135,.15),inset 0 1px #fff;backdrop-filter:blur(22px)}.inbox-shell{height:570px;border-radius:25px;display:grid;grid-template-columns:60px 1fr;overflow:hidden}.inbox-shell aside{display:flex;justify-content:center;background:#1a214d;padding:1rem .5rem;color:#aeb6d8}.inbox-logo{display:grid;place-items:center;width:40px;height:40px;color:#fff;padding:0}.inbox-logo svg{width:22px}.mail-view{padding:1.3rem;background:#fafbff;overflow:hidden}.mail-toolbar{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);padding-bottom:1rem}.mail-toolbar small,.mail-toolbar b{display:block}.mail-toolbar small{color:#8a91a8;font-size:.64rem}.mail-toolbar b{font-size:.85rem;margin-top:.2rem}.mail-toolbar>span{font-size:.58rem;color:#2a9875;background:#e8f8f2;padding:.35rem .5rem;border-radius:99px}.sender{display:flex;align-items:center;gap:.7rem;margin:1rem 0}.sender>span{display:grid;place-items:center;width:35px;height:35px;border-radius:50%;background:#e8ecff;color:#5265d4;font-size:.65rem;font-weight:700}.sender b,.sender small{display:block}.sender b{font-size:.72rem}.sender small{font-size:.57rem;color:#9399aa}.incoming{padding:.85rem;background:#f0f2f8;border-radius:12px;color:#5d647b;font-size:.7rem;line-height:1.55}.ai-draft{margin-top:1rem;border:1px solid #dce2ff;background:#f4f6ff;border-radius:14px;padding:1rem}.draft-head{display:flex;justify-content:space-between;color:#4656ae}.draft-head span{display:flex;align-items:center;gap:.4rem;font-size:.67rem;font-weight:700}.draft-head svg{width:15px}.draft-head small{font-size:.55rem;color:#828aa4}.ai-draft p{white-space:pre-line;min-height:165px;margin:1rem 0;color:#4f5777;font-size:.67rem;line-height:1.65}.draft-actions{display:flex;justify-content:flex-end;gap:.5rem}.draft-actions button{padding:.55rem .7rem;border:1px solid var(--line);background:#fff;border-radius:8px;font-size:.6rem}.draft-actions .approve{background:#5269e8;color:#fff}.draft-actions .sent{background:#269573}
  .section{padding:7rem 0}.narrow{max-width:900px;text-align:center}.narrow h2,.section-title h2,.split h2,.faq h2{font-size:clamp(2.35rem,4vw,4rem);line-height:1.08;margin:1rem 0 1.2rem}.narrow p,.section-title>p,.faq-grid>div>p{font-size:1.05rem;line-height:1.8;color:var(--muted)}.narrow strong{display:block;margin-top:1.5rem;color:#4058c6}.soft{background:linear-gradient(180deg,#f4f6ff,#fbfcff)}.section-title{text-align:center;max-width:820px;margin:0 auto 3.5rem}.feature-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:1rem}.card{grid-column:span 2;border-color:var(--line);border-radius:20px;padding:1.55rem}.card.wide{grid-column:span 3}.icon{display:grid;place-items:center;width:45px;height:45px;border-radius:13px;margin-bottom:1.1rem}.card:nth-child(1) .icon{color:#4777ed;background:#e5eeff}.card:nth-child(2) .icon{color:#ec5e75;background:#ffe7eb}.card:nth-child(3) .icon{color:#8b61ee;background:#f0e8ff}.card:nth-child(4) .icon{color:#19a978;background:#def8ec}.card:nth-child(5) .icon{color:#de6a31;background:#fff0e6}.card:nth-child(6) .icon{color:#249db5;background:#e1f7fb}.card h3,.team h3{font-size:1.03rem;margin-bottom:.5rem}.card p{color:var(--muted);font-size:.86rem;line-height:1.65}.steps{display:grid;grid-template-columns:repeat(7,1fr);gap:.25rem}.step{text-align:center;position:relative}.step b{width:49px;height:49px;border-radius:50%;display:grid;place-items:center;margin:0 auto .8rem;background:#fff;border:1px solid #dbe0fb;color:#5166de;position:relative;z-index:1}.step span{font-size:.8rem;font-weight:700}.step>i{position:absolute;top:24px;left:65%;width:70%;height:1px;background:#d8ddf4}
