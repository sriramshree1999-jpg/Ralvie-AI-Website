---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import ralvieLogoIcon from '../assets/Ralvie-logo-icon.svg';

const formTypes = [
  ['chat','Contact forms','Route general enquiries to the right team.'],
  ['target','Lead generation','Capture prospects and qualification context.'],
  ['calendar','Demo requests','Understand requirements before the meeting.'],
  ['list-check','Customer intake','Collect everything your team needs upfront.'],
  ['wrench','Support forms','Gather useful issue details before assignment.'],
  ['document','Request forms','Handle quotes, callbacks and service requests.'],
];
const capabilities = [
  ['squares','Conditional logic','Show the next best question based on every answer.'],
  ['sparkles','Open-text understanding','Turn written responses into structured business context.'],
  ['target','Lead qualification','Score intent, urgency, fit and priority automatically.'],
  ['users','Intelligent routing','Send each submission to the team equipped to respond.'],
  ['database','Connected CRM','Create or enrich customer records without manual copying.'],
  ['calendar','Instant booking','Move qualified visitors directly to an available meeting.'],
];
const industries = [['building','Hospitality'],['heart','Healthcare'],['home','Real estate'],['briefcase','Professional services'],['academic-cap','Education'],['monitor','SaaS & technology']];
const faqs = [
  ['What are Ralvie AI Website Forms?','Intelligent forms that capture customer information and connect it with qualification, routing, CRM, scheduling and configured workflows.'],
  ['Can forms use conditional questions?','Yes. Questions can change according to earlier answers and configured business rules, keeping each journey focused and relevant.'],
  ['Can Ralvie qualify leads from form responses?','Yes. Responses can be evaluated against your qualification criteria to identify intent, fit, urgency and lead priority.'],
  ['Can forms understand written responses?','AI can interpret configured open-text answers and extract useful details such as industry, locations, requirements and timeline.'],
  ['Can submissions go to our CRM?','Ralvie can connect submissions with supported CRM integrations, APIs, webhooks and automation workflows.'],
  ['Can visitors book after submitting?','Yes. Qualified visitors can continue directly into a supported scheduling flow instead of waiting for manual follow-up.'],
  ['Are forms customizable and mobile-friendly?','Forms can match your brand and are designed to work responsively across desktop, tablet and compatible mobile devices.'],
];
const schema = { '@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}})) };
---

<Layout title="AI Website Forms for Lead Capture & Intake | Ralvie AI Frontdesk" description="Create intelligent website forms with Ralvie AI Frontdesk. Capture leads, qualify prospects, route submissions, trigger workflows, book appointments, and connect form data with your CRM.">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(schema)} /></Fragment>
  <Header theme="light" />
  <main class="forms-page">
    <section class="hero" id="top">
      <div class="mesh"><i></i><i></i><i></i></div>
      <div class="container-page hero-grid">
        <div class="hero-copy">
          <span class="eyebrow"><i></i>AI Website Forms</span>
          <h1><span class="keep-line">Turn every form</span> submission into the <span>next action.</span></h1>
          <p class="lead">Collect more than names and email addresses.</p>
          <p>Capture customer intent, qualify prospects, route requests, update your CRM and move every visitor toward the right next step.</p>
          <div class="hero-actions"><a class="primary" href="#demo">Start your free trial <Icon name="arrow-right" /></a><a class="secondary" href="#demo"><Icon name="calendar" /> Book a demo</a></div>
        </div>

        <div class="form-demo builder-demo" id="form-demo">
          <div class="builder-control"><label>Form title</label><div>Contact Us</div></div>
          <div class="builder-control description-control"><label>Description</label><div>We'd love to hear from you. Fill out the form below and we'll get back to you within 24 hours.<span>94 / 500</span></div></div>
          <div class="builder-fields">
            <div class="builder-scroll"><i></i></div>
            <article class="builder-field"><span class="drag">☰</span><div><b>Full Name <em>*</em></b><p>Enter your full name</p></div></article>
            <article class="builder-field"><span class="drag">☰</span><div><b>Email <em>*</em></b><p>Enter your email</p></div></article>
            <article class="builder-field"><span class="drag">☰</span><div><b>What's your company name? <em>*</em></b><p>Enter your company name</p></div></article>
            <article class="builder-field selected"><span class="drag">☰</span><div><b>Phone Number <em>*</em></b></div><button aria-label="Delete phone field">×</button></article>
          </div>
          <div class="builder-control submit-control"><label>Submit button text</label><div>Send Message <span>12 / 30</span></div></div>
        </div>
      </div>
    </section>

    <section class="section intro"><div class="container-page narrow reveal"><span class="eyebrow">Submission → Understanding → Action</span><h2>Forms should do more than collect fields.</h2><p>A traditional form creates another inbox task. Ralvie structures the information, understands what the customer needs and starts the appropriate workflow while their intent is still fresh.</p></div></section>

    <section class="section journeys"><div class="container-page"><div class="section-title reveal"><span class="eyebrow">Purpose-built journeys</span><h2>Build around the outcome you need.</h2><p>One flexible form platform for every customer entry point.</p></div><div class="type-grid">{formTypes.map(([icon,title,text])=><article class="type-card reveal"><span><Icon name={icon}/></span><h3>{title}</h3><p>{text}</p><small>Explore journey <Icon name="arrow-right"/></small></article>)}</div></div></section>

    <section class="section form-product-showcase"><div class="container-page product-split"><div class="product-copy reveal"><span class="eyebrow">One place for every form</span><h2>Manage every customer entry point from one workspace.</h2><p class="large">Create, organize, publish, and monitor forms without losing sight of what each submission is doing for your business. Ralvie gives your team a clear view of active forms, recent response volume, performance, and remaining capacity while keeping every form connected to the same AI Frontdesk.</p><div class="checks"><span><Icon name="check"/>See performance across every live form</span><span><Icon name="check"/>Search and manage forms from one dashboard</span><span><Icon name="check"/>Keep lead capture, support, and intake organized</span></div></div><div class="forms-admin portrait-ui reveal"><header><div><span><Icon name="form"/></span><div><small>Website Forms</small><b>Forms overview</b></div></div><button>+ New form</button></header><div class="admin-metrics"><div><small>Submissions · 7d</small><b>184</b><em>+18% this week</em></div><div><small>Active forms</small><b>6</b><em>All systems live</em></div><div><small>Completion rate</small><b>42.8%</b><em>+6.4% improvement</em></div><div><small>Submission usage</small><b>184 / 300</b><em>On track</em></div></div><div class="admin-search"><Icon name="globe"/><span>Search forms…</span></div><div class="form-list"><article><div><b>Contact us</b><small>4 fields · Sales routing</small></div><span>Live</span><strong>68 <small>submissions</small></strong></article><article><div><b>Book a consultation</b><small>7 fields · Calendar connected</small></div><span>Live</span><strong>51 <small>submissions</small></strong></article><article><div><b>Enterprise enquiry</b><small>9 fields · Qualification enabled</small></div><span>Live</span><strong>39 <small>submissions</small></strong></article><article><div><b>Customer support</b><small>6 fields · Support routing</small></div><span>Live</span><strong>26 <small>submissions</small></strong></article></div></div></div></section>

    <section class="section form-detail-showcase"><div class="container-page product-split reverse"><div class="form-insights portrait-ui reveal"><header><a><Icon name="arrow-right"/> All forms</a><span>Live</span></header><div class="insight-title"><small>Web form</small><h3>Contact us</h3><p>Last edited today · Sales routing enabled</p></div><div class="insight-metrics"><div><small>Total submissions</small><b>86</b></div><div><small>Qualified leads</small><b>34</b></div><div><small>Meetings booked</small><b>19</b></div></div><div class="insight-tabs"><b>Overview</b><span>Submissions</span><span>History</span></div><div class="performance-card"><header><b>Submission activity</b><small>Last 7 days</small></header><div class="mini-bars">{[48,64,57,76,69,88,82].map((height)=><i style={`--h:${height}%`}></i>)}</div><div class="performance-summary"><span><small>Conversion rate</small><b>46.2%</b></span><span><small>Avg. completion</small><b>2m 18s</b></span></div></div><div class="recent-leads"><b>Recent qualified submissions</b><p><span>SM</span><strong>Sarah Mitchell<small>Northline Properties · Demo booked</small></strong><em>High intent</em></p><p><span>DL</span><strong>Daniel Lee<small>Vertex Health · Sales follow-up</small></strong><em>Qualified</em></p></div></div><div class="product-copy reveal"><span class="eyebrow">Clarity after every submission</span><h2>Understand performance and follow every opportunity.</h2><p class="large">Open any form to see how it is performing, which responses are qualified, and what happened next. Ralvie connects submission activity with lead quality, booked meetings, routing history, and the customer context your team needs to continue the conversation.</p><div class="checks"><span><Icon name="check"/>Track conversion and completion trends</span><span><Icon name="check"/>Review qualified submissions in context</span><span><Icon name="check"/>See bookings, routing, and follow-up outcomes</span></div></div></div></section>

    <section class="section branching" id="how"><div class="container-page split"><div class="reveal"><span class="eyebrow">Adaptive by design</span><h2>One form. Multiple intelligent paths.</h2><p class="large">Visitors only see questions relevant to them. Your team receives the context it needs.</p><div class="checks"><span><Icon name="check"/>Shorter for every visitor</span><span><Icon name="check"/>More useful for your team</span><span><Icon name="check"/>Configured around your business rules</span></div></div><div class="logic-card reveal"><div class="logic-question"><small>What are you interested in?</small><b>AI Website Chatbot</b></div><div class="connector"><i></i><span>IF</span><i></i></div><div class="logic-result"><span><Icon name="sparkles"/></span><div><small>Show relevant question</small><b>How many website enquiries do you receive?</b></div></div><div class="options"><span>0–500</span><span class="active">500–2,000</span><span>2,000+</span></div></div></div></section>

    <section class="section capabilities"><div class="container-page"><div class="section-title reveal"><span class="eyebrow">Intelligence after submit</span><h2>Form data becomes operational data.</h2></div><div class="cap-grid">{capabilities.map(([icon,title,text],i)=><article class:list={['cap-card','reveal',i===0&&'featured']}><span><Icon name={icon}/></span><div><h3>{title}</h3><p>{text}</p></div></article>)}</div></div></section>


    <section class="section channels"><div class="container-page split"><div class="reveal"><span class="eyebrow">One connected journey</span><h2>Submit is a beginning, not an ending.</h2><p class="large">Continue with chat, Web Voice, website forms, phone calls, or email—whichever next step makes sense for the customer.</p><a href="#demo" class="text-link">Design your customer journey <Icon name="arrow-right"/></a></div><div class="channel-map reveal"><div class="center"><img src={ralvieLogoIcon.src} alt="Ralvie" /></div>{[['chat','Web chat'],['microphone','Web voice'],['form','Website form'],['phone','Phone call'],['mail','Email'],['database','AI CRM']].map(([icon,label],i)=><div class={`node n${i+1}`}><span><Icon name={icon}/></span><small>{label}</small></div>)}</div></div></section>


    <section class="section industries"><div class="container-page"><div class="section-title reveal"><span class="eyebrow">Built for every team</span><h2>Collect the right information from the start.</h2></div><div class="industry-grid">{industries.map(([icon,name])=><article class="industry reveal"><span><Icon name={icon}/></span><h3>{name}</h3></article>)}</div></div></section>

    <section class="section comparison"><div class="container-page split"><div class="reveal"><span class="eyebrow">Beyond contact forms</span><h2>A form that thinks ahead.</h2><p class="large">Replace the generic thank-you screen with qualification, routing and action.</p></div><div class="comparison-list reveal">{[['Static questions','Conditional journeys'],['Unstructured message','AI-assisted understanding'],['Manual lead review','Configured qualification'],['Inbox notification','Intelligent routing'],['Copy into CRM','Connected customer record'],['Wait for follow-up','Continue to booking']].map(([oldWay,newWay])=><div><span><Icon name="x-mark"/>{oldWay}</span><b><Icon name="check"/>{newWay}</b></div>)}</div></div></section>

    <section class="section faq"><div class="container-page faq-grid"><div class="reveal"><span class="eyebrow">Questions, answered</span><h2>Everything you need to know.</h2><p>Build forms around your brand, customer journey and workflows.</p></div><div>{faqs.map(([q,a],i)=><details class="reveal" open={i===0}><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></div></section>

    <section class="final-cta" id="demo"><div class="mesh dark"><i></i><i></i><i></i></div><div class="container-page reveal"><span class="eyebrow">Meet Ralvie AI Frontdesk</span><h2>Turn Every Customer Conversation <span class="cta-keep">Into Action.</span></h2><p class="cta-description">Ralvie AI Frontdesk helps your business answer, understand, and act across every customer channel<br/>—voice calls, website chat, web voice, email, SMS, forms, and CRM. Be available 24/7. Respond instantly.<br/>Capture more opportunities. Connect every conversation to the right next step.</p><div class="cta-actions"><a class="primary" href="#">Try Ralvie AI Frontdesk <Icon name="arrow-right"/></a><a class="secondary dark-button" href="#"><Icon name="calendar"/> Book a Demo</a></div><small>One AI Frontdesk. Every customer channel. Always ready.</small></div></section>
  </main>
  <Footer theme="light" />
</Layout>

<style>
  .forms-page{--ink:#151b3f;--muted:#666d86;--line:rgba(38,46,87,.12);background:#fcfcff;color:var(--ink);overflow:hidden}.forms-page :global(h1),.forms-page :global(h2),.forms-page :global(h3){letter-spacing:-.035em}.hero{position:relative;min-height:calc(100vh - var(--header-height));display:flex;align-items:center;padding:5rem 0 6rem;background:linear-gradient(180deg,#fcfcff,#f5f7ff)}.mesh{position:absolute;inset:0;pointer-events:none}.mesh i{position:absolute;border-radius:50%;filter:blur(100px);opacity:.24}.mesh i:nth-child(1){width:42rem;height:42rem;right:-14rem;top:-19rem;background:#a8b9ff}.mesh i:nth-child(2){width:34rem;height:34rem;left:-12rem;bottom:-18rem;background:#c8f2e5}.mesh i:nth-child(3){width:26rem;height:26rem;left:43%;top:25%;background:#e4c8ff;opacity:.14}.hero-grid,.split{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:center}.hero-copy{max-width:650px}.eyebrow{display:inline-flex;align-items:center;gap:.55rem;color:#4d5eaf;text-transform:uppercase;letter-spacing:.13em;font:700 .72rem var(--font-label)}.eyebrow>i{width:7px;height:7px;border-radius:50%;background:#657cf3;box-shadow:0 0 0 5px rgba(101,124,243,.12)}h1{font-size:clamp(3.1rem,5.5vw,5.55rem);line-height:1;margin:1.3rem 0 1.5rem}h1 span,.final-cta h2 span{background:linear-gradient(120deg,#315bea,#8b5fe5);background-clip:text;color:transparent}.lead{font-size:1.15rem;font-weight:700;margin-bottom:.65rem}.hero-copy>p:last-of-type,.large{color:var(--muted);font-size:1rem;line-height:1.75}.hero-actions{display:flex;gap:.8rem;margin:2rem 0 1.5rem}.primary,.secondary{display:inline-flex;align-items:center;justify-content:center;gap:.55rem;padding:.9rem 1.2rem;border-radius:12px;font-size:.85rem;font-weight:700}.primary{color:#fff;background:linear-gradient(135deg,#3b62e8,#7766ec);box-shadow:0 13px 30px rgba(57,86,209,.24)}.secondary{color:var(--ink);background:rgba(255,255,255,.8);border:1px solid var(--line)}.primary svg,.secondary svg{width:17px}.proof{display:flex;flex-wrap:wrap;gap:.8rem 1.2rem;font-size:.7rem;color:#747b92}.proof span:before{content:'✓';color:#4c67df;margin-right:.35rem}
  .form-demo{width:min(100%,520px);height:auto;justify-self:end;border:1px solid #e4e7ed;border-radius:18px;background:#fff;box-shadow:0 24px 58px rgba(55,65,123,.13);overflow:hidden}.builder-demo{padding:.85rem}.builder-control label{display:block;margin-bottom:.32rem;color:#96a5be;font-size:.54rem;font-weight:800;letter-spacing:.05em;text-transform:uppercase}.builder-control>div{position:relative;padding:.62rem .68rem;border:1px solid #e1e4e9;border-radius:9px;background:#f8f9fb;color:#182038;font-size:.66rem}.description-control{margin-top:.58rem}.description-control>div{min-height:0;padding:.55rem .85rem;line-height:1.35;font-size:.55rem}.builder-control>div span{position:absolute;right:.1rem;bottom:-.7rem;color:#98a3b5;font-size:.44rem}.builder-fields{position:relative;height:auto;margin:.82rem 0;padding:.42rem 1rem;border-top:1px solid #e8eaf0;border-bottom:1px solid #e8eaf0;overflow:hidden}.builder-field{position:relative;display:flex;align-items:center;gap:.4rem;min-height:0;margin:.26rem 0;padding:.45rem .45rem;border:1px solid transparent;border-radius:9px;background:#fff}.builder-field .drag{color:#cbd3df;font-size:.5rem;transform:rotate(90deg)}.builder-field>div{flex:1}.builder-field b{display:block;font-size:.52rem;line-height:1.2}.builder-field b em{color:#ff6471;font-style:normal}.builder-field p{margin-top:.25rem;padding:.38rem .5rem;border-radius:99px;background:#f5f7f9;color:#c2c7ce;font-size:.47rem;line-height:1.2}.builder-field.selected{min-height:48px;border:2px solid #8198f2;border-radius:9px 9px 0 0}.builder-field.selected button{color:#ff6170;font-size:.78rem}.builder-scroll{position:absolute;z-index:3;right:.1rem;top:.42rem;bottom:.42rem;width:6px;border-radius:99px;background:#f0f0f0}.builder-scroll i{display:block;width:100%;height:55%;margin-top:7px;border-radius:99px;background:#bdbdbd}.submit-control>div{display:flex;justify-content:space-between}.submit-control>div span{position:static;color:#969ca9;font-size:.44rem}
  .hero-copy h1 .keep-line{white-space:nowrap;background:none;color:var(--ink)}.section{padding:7rem 0}.narrow{max-width:880px;text-align:center}.narrow h2,.section-title h2,.split h2,.faq h2{font-size:clamp(2.3rem,4vw,3.9rem);line-height:1.08;margin:1rem 0 1.2rem}.narrow p,.section-title>p,.faq-grid>div>p{color:var(--muted);font-size:1rem;line-height:1.8}.section-title{max-width:800px;margin:0 auto 3.5rem;text-align:center}.journeys{background:#f4f6ff}.type-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.type-card{padding:1.5rem;border:1px solid var(--line);border-radius:19px;background:#fff}.type-card>span,.cap-card>span,.industry>span{display:grid;place-items:center;width:45px;height:45px;border-radius:13px;margin-bottom:1rem}.type-card:nth-child(1)>span,.cap-card:nth-child(1)>span,.industry:nth-child(1)>span{color:#4777ed;background:#e5eeff}.type-card:nth-child(2)>span,.cap-card:nth-child(2)>span,.industry:nth-child(2)>span{color:#e95f77;background:#ffe7eb}.type-card:nth-child(3)>span,.cap-card:nth-child(3)>span,.industry:nth-child(3)>span{color:#8960e9;background:#f0e8ff}.type-card:nth-child(4)>span,.cap-card:nth-child(4)>span,.industry:nth-child(4)>span{color:#19a877;background:#def8ec}.type-card:nth-child(5)>span,.cap-card:nth-child(5)>span,.industry:nth-child(5)>span{color:#dc6c31;background:#fff0e6}.type-card:nth-child(6)>span,.cap-card:nth-child(6)>span,.industry:nth-child(6)>span{color:#249db5;background:#e1f7fb}.type-card svg,.cap-card>span svg,.industry>span svg{width:20px}.type-card h3{font-size:1rem}.type-card p{min-height:3.1rem;margin:.5rem 0;color:var(--muted);font-size:.78rem;line-height:1.65}.type-card small{display:flex;align-items:center;gap:.4rem;color:#5365c2;font-size:.56rem}.type-card small svg{width:13px}.branching{background:#fff}.checks{display:grid;gap:.75rem;margin-top:1.35rem}.checks span{display:flex;align-items:center;gap:.55rem;font-size:.8rem}.checks svg{width:17px;color:#5269db}.logic-card{padding:1.5rem;border:1p