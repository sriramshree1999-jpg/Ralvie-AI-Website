---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Icon from '../../../components/Icon.astro';
import FrontdeskFinalCta from '../../../components/FrontdeskFinalCta.astro';
import { Image } from 'astro:assets';
import hotelImage from '../../../assets/hotels and hospitlaity.jpg';
import '../../../styles/hotels-hospitality.css';

const title = 'AI Receptionist for Hotels & Hospitality | Ralvie AI Frontdesk';
const description = 'Help hotels answer guest calls, handle routine enquiries, route requests, support reservation workflows, and stay available 24/7 with Ralvie AI Frontdesk.';
const faqs = [
  ['What is Ralvie AI Frontdesk for hotels?', 'Ralvie is an AI-powered guest communication layer across phone, website chat, web voice, SMS, email, forms, routing, and connected workflows.'],
  ['Can Ralvie answer hotel calls 24/7?', 'Yes. Ralvie can stay available around the clock for supported guest enquiries and configured after-hours workflows.'],
  ['Can Ralvie answer common guest questions?', 'Yes. It can answer from approved property knowledge, including hours, parking, Wi-Fi, breakfast, amenities, directions, and policies.'],
  ['Can Ralvie handle housekeeping and maintenance requests?', 'Yes. It can capture request details and route them through the configured department workflow.'],
  ['Can Ralvie support reservation enquiries?', 'Yes. It can collect booking context and support connected reservation workflows, subject to the systems and rules you configure.'],
  ['Can Ralvie support multiple hotel properties?', 'Yes. It can identify the property, apply local knowledge, and route conversations using property-specific rules.'],
  ['Can Ralvie support multiple languages?', 'Yes. Supported multilingual conversations can use the same approved property knowledge and routing rules.'],
  ['Does Ralvie replace hotel front-desk employees?', 'No. Ralvie handles repetitive communication and structured intake while staff focus on hospitality, judgment, and service recovery.'],
];
const schema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---
<Layout title={title} description={description} theme="light" showScene={false}>
  <Header title="Ralvie AI" theme="light"/><script type="application/ld+json" is:inline set:html={JSON.stringify(schema)}/>
  <main class="hotel-page pt-(--header-height)">
    <section class="hotel-hero hotel-mesh"><div class="hotel-shell hero-grid"><div class="hero-copy"><span class="hotel-pill"><i></i> RALVIE AI FRONTDESK FOR HOTELS & HOSPITALITY</span><h1 class="industry-title-lines"><span>Give Every Guest</span><span>an Always-Available</span><span><em>Front Desk.</em></span></h1><p class="industry-description-lines"><span>Answer routine questions, support reservation enquiries, and</span><span>capture guest requests. Route calls and keep conversations</span><span>moving across every channel—24/7.</span></p><div class="hotel-actions"><a href="#get-started" class="hotel-primary">Start your free trial <Icon name="arrow-right"/></a><a href="#get-started" class="hotel-secondary"><Icon name="calendar"/> Book a demo</a></div><small>24/7 guest support · Multilingual conversations · Smart routing · Guest request intake</small></div>
      <div class="hotel-visual"><Image src={hotelImage} alt="Hotel reception team welcoming a guest" class="hotel-image" widths={[640,960,1280]} sizes="(max-width:920px) 100vw, 52vw" loading="eager"/><div class="guest-card"><span><Icon name="bell"/></span><div><small>GUEST REQUESTS</small><strong>38 active</strong><em>Across 4 departments</em></div></div><div class="stay-screen"><header><div><small>RESERVATION ENQUIRY</small><strong>Stay request</strong></div><span>Ready</span></header><div class="stay-guest"><span>LM</span><div><b>Leah Martin</b><small>2 guests · 3 nights</small></div></div><div class="stay-data"><p><small>CHECK-IN</small><b>18 Sep</b></p><p><small>ROOM</small><b>King suite</b></p><p><small>PROPERTY</small><b>City Hotel</b></p></div><footer><span><Icon name="sparkles"/> Intent understood</span><b>Route to reservations</b></footer></div></div>
    </div></section>

    <section class="hotel-section intro"><div class="hotel-shell intro-grid"><div><span class="eyebrow">HOSPITALITY NEVER REALLY CLOSES</span><h2>Guests expect help <em>wherever they are.</em></h2><p>Before check-in, during a stay, late at night, or while your team is helping guests in person—Ralvie provides a fast first response.</p></div><div class="question-cloud">{['What time is check-in?','Do you have parking?','I need more towels.','Can I change my reservation?','Is the restaurant open?','Connect me to the spa.'].map((q,x)=><span class={`q-${x}`}>{q}</span>)}</div></div></section>

    <section class="hotel-section phone-mesh"><div class="hotel-shell split"><div class="phone-screen hotel-glass"><header><div><span><Icon name="phone"/></span><div><small>LIVE GUEST CALL</small><h3>Ralvie Hotel Frontdesk</h3></div></div><b>01:08</b></header><div class="transcript"><p class="guest-msg">Could I get two extra towels sent to room 412?</p><p class="ralvie-msg">Absolutely. I’ve captured the request for room 412 and I’m sending it to housekeeping now.</p></div><div class="intent"><Icon name="sparkles"/><div><small>REQUEST STRUCTURED</small><b>Housekeeping · Towels · Room 412</b></div><em>Sent</em></div><footer>{['Guest verified','Request captured','Housekeeping notified'].map(x=><span><Icon name="check"/>{x}</span>)}</footer></div><div class="copy"><span class="eyebrow">AI PHONE RECEPTIONIST</span><h2>Every call gets <em>a useful first response.</em></h2><p>Guests speak naturally. Ralvie understands why they are calling, answers from approved hotel knowledge, captures the request, or routes to the right team.</p><ul><li>Resolve routine property questions</li><li>Capture service requests with context</li><li>Route calls without complex menus</li><li>Transfer to staff when people are needed</li></ul></div></div></section>

    <section class="hotel-section night-section"><div class="hotel-shell"><div class="section-head centered"><span class="eyebrow">ALWAYS-ON HOSPITALITY</span><h2>Your guests don’t follow <em>office hours.</em></h2><p>Turn after-hours calls into clear, helpful next steps instead of voicemail.</p></div><div class="night-flow">{[['phone','Guest calls','At any hour'],['sparkles','Ralvie understands','Property and intent'],['book','Answers','Approved information'],['bell','Captures','A structured request'],['users','Routes','Using your rules']].map(([i,n,p],x)=><article><small>0{x+1}</small><span><Icon name={i}/></span><h3>{n}</h3><p>{p}</p></article>)}</div></div></section>

    <section class="hotel-section concierge"><div class="hotel-shell split"><div class="copy"><span class="eyebrow">HOTEL KNOWLEDGE ENGINE</span><h2>A conversational concierge for <em>every routine question.</em></h2><p>Give Ralvie approved property information so guests get one current answer across voice and digital channels.</p><div class="amenity-grid">{[['clock','Check-in & checkout'],['car','Parking & directions'],['wifi','Wi-Fi & facilities'],['coffee','Breakfast & dining'],['heart','Spa & wellness'],['home','Rooms & policies']].map(([i,n],x)=><span class={`amenity-${x}`}><Icon name={i}/>{n}</span>)}</div></div><div class="concierge-screen hotel-glass"><header><div><small>PROPERTY CONCIERGE</small><h3>Guest knowledge</h3></div><span>124 answers</span></header><div class="search"><Icon name="sparkles"/> What time does breakfast finish?</div><div class="answer"><small>APPROVED ANSWER</small><p>Breakfast is served in The Garden Room until 10:30 AM on weekdays and 11:00 AM on weekends.</p><footer><span>City Hotel</span><b>Updated today</b></footer></div><div class="sources"><span><Icon name="book"/> Dining hours</span><span><Icon name="shield-check"/> Approved</span></div></div></div></section>

    <section class="hotel-section routing-section"><div class="hotel-shell"><div class="section-head"><span class="eyebrow">SMART CALL ROUTING</span><h2>Let guests ask for <em>what they need.</em></h2><p>One conversational entry point can understand the request and connect guests with the right department.</p></div><div class="department-board"><div class="guest-node"><span><Icon name="user"/></span><b>Guest request</b><small>“I’d like to book a massage.”</small></div><div class="route-core"><Icon name="sparkles"/><b>Intent</b><small>Spa booking</small></div><div class="departments">{[['headset','Front desk'],['calendar','Reservations'],['bell','Housekeeping'],['wrench','Maintenance'],['heart','Spa'],['coffee','Restaurant'],['users','Events'],['briefcase','Sales']].map(([i,n],x)=><article class={x===4?'matched':''}><span><Icon name={i}/></span><b>{n}</b>{x===4&&<em>Matched</em>}</article>)}</div></div></div></section>

    <section class="hotel-section portfolio-mesh"><div class="hotel-shell split"><div class="portfolio-screen hotel-glass"><header><div><small>MULTI-PROPERTY OVERVIEW</small><h3>Guest operations</h3></div><span>Live</span></header>{[['City Hotel','142','92%'],['Harbour Resort','118','87%'],['Park Suites','96','90%'],['Airport Lodge','74','82%']].map(([n,c,v],x)=><article><span class={`property-${x}`}><Icon name="building"/></span><div><b>{n}</b><small>{c} conversations today</small></div><i><em style={`--w:${v}`}></em></i><strong>{v}</strong></article>)}<footer><Icon name="sparkles"/><p>After-hours reservation enquiries are up 18% at Harbour Resort.</p></footer></div><div class="copy"><span class="eyebrow">MULTI-PROPERTY HOSPITALITY</span><h2>One Frontdesk across <em>your hotel portfolio.</em></h2><p>Identify the property, understand the guest’s intent, apply local knowledge, and follow property-specific routing rules.</p><ul><li>Local hours, amenities, and policies</li><li>Property and department routing</li><li>Consistent guest experience</li><li>Portfolio insight with local context</li></ul></div></div></section>

    <section class="hotel-section analytics"><div class="hotel-shell"><div class="section-head centered"><span class="eyebrow">CONVERSATION ANALYTICS</span><h2>See what guests need—<em>not only call volume.</em></h2></div><div class="hotel-dashboard hotel-glass"><header><div><small>HOTEL FRONTDESK</small><h3>Guest communication overview</h3></div><button>Today</button></header><div class="hotel-kpis">{[['chat','Guest conversations','684','+14%'],['bell','Service requests','126','+9%'],['users','Human transfers','48','−7%'],['clock','After-hours','112','+21%']].map(([i,n,v,c],x)=><article class={`hotel-kpi-${x}`}><span><Icon name={i}/></span><small>{n}</small><strong>{v}</strong><em>{c}</em></article>)}</div><div class="analytics-body"><article><b>Guest demand by hour</b><div class="hotel-bars">{[38,48,65,82,71,92,68,78,59,45,34,25].map(h=><i style={`--h:${h}%`}></i>)}</div><footer><span>6 AM</span><span>Midnight</span></footer></article><aside><b>Top guest intents</b>{[['Reservations','31%'],['Property information','24%'],['Housekeeping','18%'],['Dining & spa','15%'],['Other','12%']].map(([n,v],x)=><p><i class={`dot-${x}`}></i>{n}<strong>{v}</strong></p>)}</aside></div></div></div></section>

    <section class="hotel-section responsible"><div class="hotel-shell responsible-panel"><div><span class="eyebrow">AI + HUMAN HOSPITALITY</span><h2>Automate the repetitive layer. <em>Keep people in the moments that matter.</em></h2><p>Configure what Ralvie can answer, capture, route, and escalate—with clear human paths for complaints, safety issues, and service recovery.</p></div><div class="guardrails">{[['shield-check','Approved knowledge','Answers grounded in hotel information'],['users','Human handoff','Context moves with the guest'],['bolt','Urgent workflows','Safety and escalation come first'],['link','Connected actions','Use supported hotel systems']].map(([i,n,p],x)=><article class={`guard-${x}`}><span><Icon name={i}/></span><div><b>{n}</b><small>{p}</small></div></article>)}</div></div></section>

    <section class="hotel-section faq"><div class="hotel-shell faq-grid"><div class="section-head"><span class="eyebrow">FREQUENTLY ASKED QUESTIONS</span><h2>Hospitality Frontdesk, <em>explained.</em></h2><p>Always-on guest communication with your property knowledge and service rules.</p></div><div class="faq-list">{faqs.map(([q,a],x)=><details open={x===0}><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></div></section>
    <FrontdeskFinalCta id="demo" />
  </main><Footer theme="light"/>
</Layout>
