---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Icon from '../../../components/Icon.astro';
import FrontdeskFinalCta from '../../../components/FrontdeskFinalCta.astro';
import { Image } from 'astro:assets';
import educationImage from '../../../assets/Education.jpg';
import '../../../styles/real-estate.css';
import '../../../styles/education-institutions.css';

const title = 'AI Receptionist for Schools, Colleges & Universities | Ralvie AI Frontdesk';
const description = 'Help education institutions answer student and parent enquiries 24/7, automate admissions questions, route calls, capture enquiries, and schedule campus visits.';
const faqs = [
  ['What is Ralvie AI Frontdesk for education?', 'Ralvie is an AI-powered first point of contact across phone, website chat, web voice, SMS, email, forms, routing, and connected education workflows.'],
  ['Can Ralvie answer calls 24/7?', 'Yes. It can remain available for configured routine student, parent, applicant, and campus enquiries.'],
  ['Can Ralvie answer admissions questions?', 'Yes. Ralvie can answer from approved information about programs, entry requirements, deadlines, application steps, campuses, and general policies.'],
  ['Can Ralvie capture prospective students?', 'Yes. It can collect contact details, program interest, intake, study preference, campus, and the desired next step.'],
  ['Can Ralvie schedule campus visits?', 'Ralvie can support campus-visit and consultation workflows through available scheduling integrations and configured rules.'],
  ['Can Ralvie route callers to departments?', 'Yes. It can route by audience, campus, school, faculty, department, intent, or requested staff member.'],
  ['Can Ralvie support multiple campuses and languages?', 'Yes. It can apply campus-specific knowledge and routing across supported multilingual conversations.'],
  ['Does Ralvie make admissions decisions?', 'No. Admissions decisions and other consequential education decisions remain with authorized institutional staff.'],
  ['Can Ralvie access student records?', 'Only data required for an approved workflow should be connected, with sensitive records behind appropriate controls.'],
];
const schema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---
<Layout title={title} description={description} theme="light" showScene={false}>
  <Header title="Ralvie AI" theme="light"/><script type="application/ld+json" is:inline set:html={JSON.stringify(schema)}/>
  <main class="estate-page education-page pt-(--header-height)">
    <section class="estate-hero education-mesh"><div class="estate-shell hero-grid"><div class="hero-copy"><span class="estate-pill"><i></i> RALVIE AI FRONTDESK FOR EDUCATION</span><h1 class="industry-title-lines"><span>Give Every Student, Parent,</span><span>and Prospect a Faster Way</span><span><em>to Get Answers.</em></span></h1><p class="industry-description-lines"><span>Answer common questions and capture prospective-student enquiries.</span><span>Support admissions workflows, schedule campus visits, and route</span><span>people to the right department—24/7.</span></p><div class="estate-actions"><a href="#get-started" class="estate-primary">Start your free trial <Icon name="arrow-right"/></a><a href="#get-started" class="estate-secondary"><Icon name="calendar"/> Book a demo</a></div><small>24/7 student support · Admissions enquiries · Smart routing · Multilingual support</small></div>
      <div class="estate-visual education-visual"><Image src={educationImage} alt="Students and staff at an education institution" class="estate-image education-image" widths={[640,960,1280]} sizes="(max-width:920px) 100vw, 52vw" loading="eager"/><div class="admission-screen"><header><div><small>NEW ADMISSIONS ENQUIRY</small><strong>Prospective student</strong></div><span>Qualified</span></header><div class="student-row"><span>AK</span><div><b>Amelia Khan</b><small>International applicant</small></div></div><div class="admission-data"><p><small>PROGRAM</small><b>MSc Data Science</b></p><p><small>INTAKE</small><b>Fall 2027</b></p><p><small>CAMPUS</small><b>Main Campus</b></p></div><footer><span><Icon name="sparkles"/> Intent understood</span><b>Send to admissions →</b></footer></div><div class="visit-widget"><span><Icon name="calendar"/></span><div><small>CAMPUS VISITS</small><strong>18 scheduled</strong><em>6 spaces remaining</em></div></div><div class="support-widget"><span><Icon name="headset"/></span><div><small>LIVE SUPPORT</small><strong>94% answered</strong><em>Today</em></div></div></div>
    </div></section>

    <section class="estate-section education-intro"><div class="estate-shell education-intro-grid"><div><span class="eyebrow">ONE INTELLIGENT FRONTDESK</span><h2>Different audiences. <em>One clear first step.</em></h2><p>Ralvie handles the repetitive first layer while staff focus on conversations requiring individual support, judgment, and care.</p></div><div class="audience-cards">{[['academic-cap','Prospective student','Programs and admission requirements'],['users','Parent or family','Tuition and campus information'],['book','Current student','Administrative support and routing'],['document','Applicant','Application status and next steps']].map(([i,n,p],x)=><article class={`audience-${x}`}><span><Icon name={i}/></span><div><h3>{n}</h3><p>{p}</p></div></article>)}</div></div></section>

    <section class="estate-section education-call"><div class="estate-shell split"><div class="call-screen estate-glass"><header><div><span><Icon name="phone"/></span><div><small>INCOMING ADMISSIONS CALL</small><h3>Ralvie Education Frontdesk</h3></div></div><b>01:14</b></header><div class="transcript"><p class="caller">What are the admission requirements for the MBA program?</p><p class="ralvie">I can help. Are you interested in the full-time or executive MBA pathway?</p></div><div class="detected"><Icon name="sparkles"/><div><small>INTENT DETECTED</small><b>Graduate admissions · MBA · Requirements</b></div><em>96%</em></div><footer>{['Audience identified','Program matched','Admissions workflow'].map((n,x)=><span class={x<2?'done':''}><Icon name="check"/>{n}</span>)}</footer></div><div class="copy"><span class="eyebrow">AI PHONE RECEPTIONIST</span><h2>Every caller gets <em>a first response.</em></h2><p>Prospective students, parents, current students, and applicants can explain what they need naturally—without navigating a complicated campus phone tree.</p><ul><li>Answer approved admissions questions</li><li>Capture prospective-student context</li><li>Route by campus, faculty, and department</li><li>Bring in staff when people are needed</li></ul></div></div></section>

    <section class="estate-section dark-leads education-dark"><div class="estate-shell"><div class="section-head centered"><span class="eyebrow">ALWAYS-ON EDUCATION SUPPORT</span><h2>Questions don’t only arrive during <em>office hours.</em></h2><p>Keep a helpful first point of contact available across time zones, weekends, and peak enrollment periods.</p></div><div class="lead-types">{[['clock','After-hours','Answer routine questions'],['academic-cap','Admissions','Capture program interest'],['calendar','Campus visits','Support scheduling'],['globe','International','Help across time zones'],['users','Student services','Route to the right office']].map(([i,n,p],x)=><article><span><Icon name={i}/></span><small>0{x+1}</small><h3>{n}</h3><p>{p}</p></article>)}</div></div></section>

    <section class="estate-section admissions-section"><div class="estate-shell split"><div class="copy"><span class="eyebrow">AI ADMISSIONS ASSISTANT</span><h2>Move prospective students toward <em>the right next step.</em></h2><p>Turn questions into structured enquiries, consultations, campus visits, or a routed conversation with the relevant admissions team.</p><div class="qualify-chips">{[['book','Program interest'],['calendar','Preferred intake'],['globe','Student location'],['academic-cap','Study level']].map(([i,n],x)=><span class={`chip-${x}`}><Icon name={i}/>{n}</span>)}</div></div><div class="program-screen estate-glass"><header><div><small>PROGRAM FINDER</small><h3>Admissions assistant</h3></div><span>42 programs</span></header><div class="program-search"><Icon name="sparkles"/><p>Postgraduate technology program, full-time, next fall</p></div>{[['MSc Data Science','Main Campus','92%'],['MSc Computer Science','Downtown Campus','86%'],['MSc Artificial Intelligence','Online + Campus','81%']].map(([n,c,v],x)=><article class={x===0?'selected':''}><span><Icon name="academic-cap"/></span><div><b>{n}</b><small>{c}</small></div><em>{v} match</em></article>)}<footer><div><small>NEXT STEP</small><b>Book admissions consultation</b></div><button>Continue <Icon name="arrow-right"/></button></footer></div></div></section>

    <section class="estate-section campus-routing"><div class="estate-shell"><div class="section-head"><span class="eyebrow">SMART CAMPUS ROUTING</span><h2>Understand first. <em>Route second.</em></h2><p>Make complex institutional structures easier to navigate through natural conversation.</p></div><div class="education-route-board"><div class="caller-node"><span><Icon name="user"/></span><b>Student enquiry</b><small>“I need help with financial aid.”</small></div><div class="education-route-core"><Icon name="sparkles"/><b>Intent matched</b><small>Main Campus</small></div><div class="department-grid">{[['academic-cap','Admissions'],['currency-coin','Financial aid'],['document','Registrar'],['headset','IT support'],['users','Student services'],['book','Faculty office'],['building','Campus office'],['shield-check','Safety']].map(([i,n],x)=><article class={x===1?'matched':''}><span><Icon name={i}/></span><b>{n}</b>{x===1&&<em>Matched</em>}</article>)}</div></div></div></section>

    <section class="estate-section campus-mesh"><div class="estate-shell split"><div class="campus-screen estate-glass"><header><div><small>MULTI-CAMPUS OVERVIEW</small><h3>Student access network</h3></div><span>Today</span></header>{[['Main Campus','268','94%'],['Downtown Campus','184','89%'],['International Campus','126','91%'],['Online Programs','214','96%']].map(([n,c,v],x)=><article><span class={`campus-${x}`}><Icon name="building"/></span><div><b>{n}</b><small>{c} conversations</small></div><i><em style={`--w:${v}`}></em></i><strong>{v}</strong></article>)}<footer><Icon name="sparkles"/><p>International admissions enquiries peak between 7–10 PM.</p></footer></div><div class="copy"><span class="eyebrow">MULTI-CAMPUS EDUCATION</span><h2>One Frontdesk across <em>every location.</em></h2><p>Identify the audience, campus, and department before applying local knowledge and configured routing.</p><ul><li>Campus-specific programs and hours</li><li>Faculty and department routing</li><li>Consistent institutional experience</li><li>Central insight with local context</li></ul></div></div></section>

    <section class="estate-section education-analytics"><div class="estate-shell"><div class="section-head centered"><span class="eyebrow">ADMISSIONS INTELLIGENCE</span><h2>Understand why students <em>are contacting you.</em></h2></div><div class="estate-dashboard estate-glass"><header><div><small>EDUCATION FRONTDESK</small><h3>Student communication overview</h3></div><button>Today</button></header><div class="estate-kpis">{[['chat','Conversations','892','+16%'],['academic-cap','Admissions enquiries','284','+12%'],['calendar','Campus visits','74','+9%'],['users','Human transfers','68','−5%']].map(([i,n,v,c],x)=><article class={`estate-kpi-${x}`}><span><Icon name={i}/></span><small>{n}</small><strong>{v}</strong><em>{c}</em></article>)}</div><div class="dash-body"><article><b>Conversation volume</b><div class="estate-bars">{[34,48,72,94,81,66,88,74,61,48,33,22].map(h=><i style={`--h:${h}%`}></i>)}</div><footer><span>7 AM</span><span>10 PM</span></footer></article><aside><b>Top intents</b>{[['Admissions','36%'],['Program information','23%'],['Student services','17%'],['IT support','13%'],['Other','11%']].map(([n,v],x)=><p><i class={`dot-${x}`}></i>{n}<strong>{v}</strong></p>)}</aside></div></div></div></section>

    <section class="estate-section human education-responsible"><div class="estate-shell human-panel"><div><span class="eyebrow">RESPONSIBLE AI FOR EDUCATION</span><h2>Automate access. <em>Keep sensitive decisions appropriately controlled.</em></h2><p>Ralvie explains approved processes and routes enquiries. Authorized people retain admissions decisions, protected records, financial decisions, and student support judgment.</p></div><div class="human-rules">{[['shield-check','Approved knowledge','Answers within institutional scope'],['document','Data boundaries','Collect only what a workflow needs'],['users','Human oversight','Consequential decisions stay human'],['bolt','Safety routing','Follow approved escalation guidance']].map(([i,n,p],x)=><article class={`human-${x}`}><span><Icon name={i}/></span><div><b>{n}</b><small>{p}</small></div></article>)}</div></div></section>

    <section class="estate-section faq"><div class="estate-shell faq-grid"><div class="section-head"><span class="eyebrow">FREQUENTLY ASKED QUESTIONS</span><h2>Education Frontdesk, <em>explained.</em></h2><p>Make your institution easier to reach and easier to navigate.</p></div><div class="faq-list">{faqs.map(([q,a],x)=><details open={x===0}><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></div></section>
    <FrontdeskFinalCta id="demo" />
  </main><Footer theme="light"/>
</Layout>
