---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Icon from '../../../components/Icon.astro';
import FrontdeskFinalCta from '../../../components/FrontdeskFinalCta.astro';
import { Image } from 'astro:assets';
import healthcareImage from '../../../assets/healthcare and clinics.jpg';
import '../../../styles/healthcare-clinics.css';

const title = 'AI Receptionist & Patient Communication for Healthcare | Ralvie AI';
const description = 'Help patients reach your practice faster with Ralvie AI Frontdesk. Answer calls, support appointment workflows, route requests, provide multilingual help, and reduce repetitive front-desk work.';
const faqs = [
  ['What is Ralvie AI Frontdesk for healthcare?', 'Ralvie is an AI-powered administrative communication layer for phone, website, messaging, email, forms, routing, and connected workflows.'],
  ['Can Ralvie answer patient phone calls?', 'Yes. Ralvie can answer configured administrative calls, understand the request, provide approved information, and route or escalate when necessary.'],
  ['Is Ralvie available after hours?', 'Yes. Ralvie can provide configured 24/7 coverage for routine enquiries and administrative next steps.'],
  ['Can Ralvie schedule appointments?', 'Ralvie can support appointment workflows through available scheduling integrations and configured rules.'],
  ['Can Ralvie support multiple clinic locations?', 'Yes. It can identify location context and apply location-specific knowledge, routing, and workflows.'],
  ['Can patients ask for a human?', 'Yes. Human handoff and escalation rules can be configured for conversations that need staff.'],
  ['Can Ralvie provide medical advice?', 'No. Ralvie should be configured for administrative communication. Clinical advice, diagnosis, and care decisions remain with qualified healthcare professionals.'],
  ['What happens in an emergency?', 'Emergency language should trigger configured safety guidance and escalation rather than continue a routine administrative workflow.'],
  ['Is Ralvie HIPAA compliant?', 'Specific privacy, security, infrastructure, and compliance requirements must be evaluated against the current supported configuration before deployment.'],
];
const schema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---
<Layout title={title} description={description} theme="light" showScene={false}>
  <Header title="Ralvie AI" theme="light"/><script type="application/ld+json" is:inline set:html={JSON.stringify(schema)}/>
  <main class="health-page pt-(--header-height)">
    <section class="health-hero health-mesh"><div class="health-shell hero-grid"><div class="hero-copy"><span class="health-pill"><i></i> RALVIE AI FRONTDESK FOR HEALTHCARE & CLINICS</span><h1 class="industry-title-lines"><span>Give Every Patient</span><span>a Faster Way to</span><span><em>Reach Your Practice.</em></span></h1><p class="industry-description-lines"><span>Answer routine calls, support appointment workflows, and capture</span><span>patient requests. Route conversations and provide a clearer path</span><span>without adding more pressure to your front desk.</span></p><div class="health-actions"><a href="https://app.frontdesk.ralvie.ai/login" target="_blank" rel="noopener noreferrer" class="health-primary">Start your free trial <Icon name="arrow-right"/></a><a href="#get-started" class="health-secondary"><Icon name="calendar"/> Book a demo</a></div><small>24/7 patient access · Appointment assistance · Smart routing · Multilingual support</small></div>
      <div class="health-visual"><Image src={healthcareImage} alt="Healthcare clinic professional supporting a patient" class="health-image" widths={[640,960,1280]} sizes="(max-width:920px) 100vw, 52vw" loading="eager"/><div class="intake-screen"><header><div><small>NEW PATIENT REQUEST</small><strong>Appointment intake</strong></div><span>Live</span></header><div class="patient"><span>AM</span><div><b>Alex Morgan</b><small>General consultation · Downtown</small></div></div><div class="intake-steps">{[['check','Contact captured'],['check','Service identified'],['calendar','Times requested']].map(([i,n],x)=><p class={x<2?'done':''}><Icon name={i}/>{n}</p>)}</div><footer><span>Ready for scheduling</span><b>View request →</b></footer></div><div class="after-card"><span><Icon name="clock"/></span><div><small>AFTER-HOURS</small><strong>18 requests</strong><em>Handled tonight</em></div></div><div class="response-widget"><span><Icon name="phone"/></span><div><small>RESPONSE TIME</small><strong>12 sec</strong><em>↓ 24% this week</em></div></div></div>
    </div></section>

    <section class="section patient-access"><div class="health-shell access-grid"><div><span class="eyebrow">PATIENT ACCESS, WITHOUT THE HOLD MUSIC</span><h2>Patients need answers. <em>Staff need time to focus.</em></h2><p>Ralvie handles the repetitive administrative conversation around patient access while your people focus on patients and situations that need human care.</p></div><div class="access-orbit"><div class="access-core"><Icon name="heart"/><b>Patient request</b></div>{[['phone','Phone'],['chat','Website chat'],['microphone','Web voice'],['form','Forms'],['mail','Email'],['chat','SMS']].map(([i,n],x)=><span class={`channel-${x}`}><Icon name={i}/>{n}</span>)}</div></div></section>

    <section class="section call-section"><div class="health-shell split"><div class="call-panel health-glass"><header><div><span><Icon name="phone"/></span><div><small>INCOMING PATIENT CALL</small><h3>Ralvie Healthcare Frontdesk</h3></div></div><b>00:42</b></header><div class="conversation"><p class="patient-msg">I need to change my appointment at the downtown clinic.</p><p class="ai-msg">Of course. I can help with the next step. May I confirm your name and appointment date?</p></div><div class="call-intent"><span><Icon name="sparkles"/></span><div><small>INTENT UNDERSTOOD</small><b>Reschedule appointment · Downtown</b></div><em>96%</em></div><footer>{['Understood','Location found','Scheduling workflow'].map((x,i)=><span class={i<2?'done':''}>{x}</span>)}</footer></div><div class="copy"><span class="eyebrow">AI PHONE RECEPTIONIST</span><h2>Every call gets <em>a useful first response.</em></h2><p>Patients speak naturally. Ralvie understands the administrative request, answers from approved practice knowledge, supports configured actions, or routes to the right team.</p><ul><li>Answer routine patient enquiries</li><li>Capture new-patient details</li><li>Support scheduling workflows</li><li>Transfer with conversation context</li></ul></div></div></section>

    <section class="section hours-dark"><div class="health-shell"><div class="section-head centered"><span class="eyebrow">ALWAYS-ON PATIENT ACCESS</span><h2>Your clinic may close. <em>Patient questions don’t.</em></h2><p>Turn “our office is closed” into a helpful administrative next step.</p></div><div class="after-flow">{[['phone','Patient calls','After-hours request begins'],['sparkles','Ralvie understands','Intent and location identified'],['book','Approved answer','Practice information provided'],['calendar','Workflow supported','Appointment request captured'],['users','Route if needed','Rules determine next step']].map(([i,n,p],x)=><article class={`after-${x}`}><span><Icon name={i}/></span><small>0{x+1}</small><h3>{n}</h3><p>{p}</p></article>)}</div></div></section>

    <section class="section scheduling-mesh"><div class="health-shell split"><div class="copy"><span class="eyebrow">AI APPOINTMENT SCHEDULING</span><h2>Make booking easier for <em>patients and staff.</em></h2><p>Use natural conversation to collect the required administrative information and connect patients with configured scheduling workflows.</p><div class="schedule-benefits">{[['calendar','Book appointments'],['refresh','Support rescheduling'],['users','New-patient requests'],['bell','Appointment guidance']].map(([i,n],x)=><span class={`benefit-${x}`}><Icon name={i}/>{n}</span>)}</div></div><div class="schedule-screen health-glass"><header><div><small>APPOINTMENT ASSISTANT</small><h3>Find an appointment</h3></div><span>Downtown Clinic⌄</span></header><div class="schedule-query"><Icon name="sparkles"/><p>General consultation, next week, preferably morning</p></div><div class="dates">{[['Tue','18','9:30 AM'],['Wed','19','10:15 AM'],['Fri','21','8:45 AM']].map(([d,n,t],x)=><article class={x===1?'selected':''}><small>{d}</small><strong>{n}</strong><span>{t}</span></article>)}</div><footer><div><small>PATIENT</small><b>Alex Morgan</b></div><button>Continue request <Icon name="arrow-right"/></button></footer></div></div></section>

    <section class="section routing"><div class="health-shell"><div class="section-head"><span class="eyebrow">SMART CALL ROUTING</span><h2>Understand first. <em>Route second.</em></h2><p>Replace complex phone menus with natural conversation and configured paths across locations, departments, and staff.</p></div><div class="routing-board"><div class="patient-node"><span><Icon name="user"/></span><b>Patient</b><small>“I have a billing question”</small></div><div class="route-line"><i></i><span><Icon name="sparkles"/> Intent understood</span></div><div class="route-targets">{[['calendar','Appointments'],['currency-coin','Billing'],['document','Records'],['users','New patients'],['headset','Human assistance']].map(([i,n],x)=><article class={`route-${x}`}><span><Icon name={i}/></span><b>{n}</b>{x===1&&<em>Matched</em>}</article>)}</div></div></div></section>

    <section class="section locations-mesh"><div class="health-shell split"><div class="location-screen health-glass"><header><div><small>MULTI-LOCATION OVERVIEW</small><h3>Patient access network</h3></div><span>Today⌄</span></header>{[['Downtown Clinic','128','94%'],['North Richmond','86','88%'],['Lakeside Health','74','91%'],['West Medical','62','84%']].map(([n,c,v],x)=><article><span class={`loc-${x}`}><Icon name="building"/></span><div><b>{n}</b><small>{c} conversations</small></div><i><em style={`--w:${v}`}></em></i><strong>{v}</strong></article>)}<footer><Icon name="sparkles"/><p>Appointment enquiries are highest at Downtown Clinic between 8–10 AM.</p></footer></div><div class="copy"><span class="eyebrow">MULTI-LOCATION HEALTHCARE</span><h2>One Frontdesk across <em>your practice network.</em></h2><p>Identify the right location, understand the request, apply local rules, and route or act using location-aware practice knowledge.</p><ul><li>Location-specific hours and services</li><li>Department and staff routing</li><li>Consistent patient access</li><li>Central insight with local context</li></ul></div></div></section>

    <section class="section knowledge-dark"><div class="health-shell split"><div class="copy light"><span class="eyebrow">HEALTHCARE KNOWLEDGE ENGINE</span><h2>Answer from your information—<em>not a guess.</em></h2><p>Give Ralvie approved practice knowledge and access only to the current information required for each configured workflow.</p></div><div class="knowledge-grid">{[['book','Practice knowledge','Hours, services, locations, policies'],['database','Connected information','Availability and configured system data'],['shield-check','Guardrails','Approved scope and escalation rules'],['refresh','Current answers','Keep relevant information updated']].map(([i,n,p],x)=><article class={`know-${x}`}><span><Icon name={i}/></span><h3>{n}</h3><p>{p}</p></article>)}</div></div></section>

    <section class="section dashboard-section"><div class="health-shell"><div class="section-head centered"><span class="eyebrow">CONVERSATION INTELLIGENCE</span><h2>Understand why patients <em>are contacting you.</em></h2></div><div class="health-dashboard health-glass"><header><div><small>HEALTHCARE FRONTDESK</small><h3>Patient communication overview</h3></div><button>Today⌄</button></header><div class="dash-kpis">{[['phone','Patient conversations','486','+12%'],['calendar','Appointment requests','128','+8%'],['users','Human transfers','42','−6%'],['clock','After-hours activity','76','+18%']].map(([i,n,v,c],x)=><article class={`kpi-${x}`}><span><Icon name={i}/></span><small>{n}</small><strong>{v}</strong><em>{c}</em></article>)}</div><div class="dash-body"><article><header><b>Conversation volume</b><span>Hourly</span></header><div class="volume-bars">{[38,55,78,91,72,60,83,68,48,34,27,19].map((h,x)=><i style={`--h:${h}%`}><span>{x}</span></i>)}</div><footer><span>8 AM</span><span>8 PM</span></footer></article><aside><b>Top patient intents</b>{[['Appointments','38%'],['Clinic information','24%'],['Billing','15%'],['Records','12%'],['Other','11%']].map(([n,v],x)=><p><i class={`intent-${x}`}></i>{n}<strong>{v}</strong></p>)}</aside></div></div></div></section>

    <section class="section safety"><div class="health-shell safety-panel"><div><span class="eyebrow">RESPONSIBLE HEALTHCARE AI</span><h2>Keep clinical decisions with <em>clinical professionals.</em></h2><p>Ralvie supports administrative access. It should not diagnose symptoms, provide medical advice, or replace qualified care.</p></div><div class="safety-rules">{[['shield-check','Administrative scope','Answer, capture, schedule, route'],['heart','Clinical boundary','Escalate care-related conversations'],['bolt','Emergency guardrail','Follow configured emergency guidance'],['users','Human availability','Step aside when people are needed']].map(([i,n,p],x)=><article class={`safe-${x}`}><span><Icon name={i}/></span><div><b>{n}</b><small>{p}</small></div></article>)}</div></div></section>

    <section class="section faq"><div class="health-shell faq-grid"><div class="section-head"><span class="eyebrow">FREQUENTLY ASKED QUESTIONS</span><h2>Healthcare Frontdesk, <em>explained.</em></h2><p>Patient access automation with clear administrative boundaries.</p></div><div class="faq-list">{faqs.map(([q,a],x)=><details open={x===0}><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></div></section>
    <FrontdeskFinalCta id="demo" />
  </main><Footer theme="light"/>
</Layout>
