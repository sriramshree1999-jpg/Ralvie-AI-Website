---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Icon from '../../../components/Icon.astro';
import FrontdeskFinalCta from '../../../components/FrontdeskFinalCta.astro';
import { Image } from 'astro:assets';
import financeImage from '../../../assets/finance services.jpg';
import '../../../styles/real-estate.css';
import '../../../styles/financial-services.css';

const title = 'AI Receptionist for Financial Services | Ralvie AI Frontdesk';
const description = 'Help financial services organizations answer client enquiries 24/7, capture leads, schedule consultations, route calls, and connect conversations with business workflows.';
const faqs = [
  ['What is Ralvie AI Frontdesk for financial services?', 'Ralvie is an AI-powered first point of contact across phone, website chat, web voice, SMS, email, forms, routing, and supported business workflows.'],
  ['Can Ralvie answer financial-services calls 24/7?', 'Yes. It can remain available around the clock for configured routine enquiries, intake, scheduling, and routing.'],
  ['Can Ralvie capture and qualify financial leads?', 'Yes. It can collect contact details, service interest, general requirements, preferred branch or advisor, timeline, and requested next step.'],
  ['Can Ralvie schedule advisor appointments?', 'Ralvie can support consultation workflows through available scheduling integrations and configured rules.'],
  ['Can Ralvie route callers by product or branch?', 'Yes. It can route by intent, financial product, team, advisor, location, or configured business rule.'],
  ['Can Ralvie handle insurance claim enquiries?', 'It can capture configured first-contact claim information and route it to authorized claims workflows and professionals.'],
  ['Can Ralvie provide investment advice or make lending decisions?', 'No. Professional advice and consequential financial decisions remain with authorized people and systems.'],
  ['Can Ralvie access customer account information?', 'Only information required for an approved workflow should be connected, with identity verification before any sensitive disclosure.'],
  ['Does Ralvie replace financial professionals?', 'No. Ralvie handles communication and administrative work while qualified professionals retain advice, judgment, and decisions.'],
];
const schema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---
<Layout title={title} description={description} theme="light" showScene={false}>
  <Header title="Ralvie AI" theme="light"/><script type="application/ld+json" is:inline set:html={JSON.stringify(schema)}/>
  <main class="estate-page finance-page pt-(--header-height)">
    <section class="estate-hero finance-mesh"><div class="estate-shell hero-grid"><div class="hero-copy"><span class="estate-pill"><i></i> RALVIE AI FRONTDESK FOR FINANCIAL SERVICES</span><h1 class="industry-title-lines"><span>Give Every Client</span><span>a Faster Path to the</span><span><em>Right Financial Service.</em></span></h1><p class="industry-description-lines"><span>Answer routine enquiries, capture prospects, and schedule</span><span>consultations. Collect administrative information and route</span><span>clients to the right professional—24/7.</span></p><div class="estate-actions"><a href="https://app.frontdesk.ralvie.ai/login" target="_blank" rel="noopener noreferrer" class="estate-primary">Start your free trial <Icon name="arrow-right"/></a><a href="#get-started" class="estate-secondary"><Icon name="calendar"/> Book a demo</a></div><small>24/7 client support · Lead capture · Consultation scheduling · Smart routing</small></div>
      <div class="estate-visual finance-visual"><Image src={financeImage} alt="Financial services professionals helping a client" class="estate-image finance-image" widths={[640,960,1280]} sizes="(max-width:920px) 100vw, 52vw" loading="eager"/><div class="finance-intake"><header><div><small>NEW CLIENT ENQUIRY</small><strong>Business financing</strong></div><span>Qualified</span></header><div class="client-row"><span>NS</span><div><b>Northstar Retail</b><small>Commercial prospect</small></div></div><div class="finance-data"><p><small>REQUIREMENT</small><b>Growth capital</b></p><p><small>TIMELINE</small><b>30–60 days</b></p><p><small>REGION</small><b>Toronto</b></p></div><footer><span><Icon name="sparkles"/> High intent</span><b>Route to lending →</b></footer></div><div class="consult-widget"><span><Icon name="calendar"/></span><div><small>CONSULTATIONS</small><strong>14 booked</strong><em>Today</em></div></div><div class="answer-widget"><span><Icon name="phone"/></span><div><small>ANSWER RATE</small><strong>96%</strong><em>↑ 8% this month</em></div></div></div>
    </div></section>

    <section class="estate-section finance-intro"><div class="estate-shell finance-intro-grid"><div><span class="eyebrow">FINANCIAL SERVICE STARTS WITH AVAILABILITY</span><h2>Client intent is happening <em>right now.</em></h2><p>Mortgage research at night, a Sunday policy enquiry, or a business owner seeking financing should receive a useful next step—not voicemail.</p></div><div class="service-journeys">{[['home','Mortgage','New borrowing enquiry'],['briefcase','Business finance','Commercial requirement'],['shield-check','Insurance','Policy or claim request'],['chart-bar','Wealth','Advisor consultation']].map(([i,n,p],x)=><article class={`service-${x}`}><span><Icon name={i}/></span><div><h3>{n}</h3><p>{p}</p></div></article>)}</div></div></section>

    <section class="estate-section finance-call"><div class="estate-shell split"><div class="call-screen estate-glass"><header><div><span><Icon name="phone"/></span><div><small>INCOMING CLIENT CALL</small><h3>Ralvie Financial Frontdesk</h3></div></div><b>00:48</b></header><div class="transcript"><p class="caller">I’d like to speak with someone about financing for my business.</p><p class="ralvie">Of course. I can collect a few details and connect you with the appropriate business-lending team.</p></div><div class="detected"><Icon name="sparkles"/><div><small>INTENT DETECTED</small><b>Business lending · New prospect · Consultation</b></div><em>97%</em></div><footer>{['Service identified','Context captured','Team matched'].map((n,x)=><span class={x<2?'done':''}><Icon name="check"/>{n}</span>)}</footer></div><div class="copy"><span class="eyebrow">AI PHONE RECEPTIONIST</span><h2>Every incoming call gets <em>a first response.</em></h2><p>Ralvie understands why the caller is reaching out and follows the right configured workflow—from routine enquiry to structured intake or human handoff.</p><ul><li>Answer approved service questions</li><li>Capture lead and client context</li><li>Schedule configured consultations</li><li>Route without complex phone menus</li></ul></div></div></section>

    <section class="estate-section dark-leads finance-dark"><div class="estate-shell"><div class="section-head centered"><span class="eyebrow">ALWAYS-ON FINANCIAL SERVICES</span><h2>Your office has hours. <em>Customer questions don’t.</em></h2><p>Offer an immediate first step before work, after work, on weekends, across time zones, and during peak demand.</p></div><div class="lead-types">{[['clock','24/7 response','Configured routine support'],['chat','Understand intent','Natural conversation'],['form','Capture context','Structured client intake'],['calendar','Schedule','Advisor consultations'],['users','Route','The right professional']].map(([i,n,p],x)=><article><span><Icon name={i}/></span><small>0{x+1}</small><h3>{n}</h3><p>{p}</p></article>)}</div></div></section>

    <section class="estate-section finance-routing"><div class="estate-shell"><div class="section-head"><span class="eyebrow">SMART CALL ROUTING</span><h2>Let clients say <em>what they need.</em></h2><p>Understand the request first, then route by product, branch, advisor, client type, or configured service workflow.</p></div><div class="finance-route-board"><div class="finance-caller"><span><Icon name="user"/></span><b>Client request</b><small>“I need help with a mortgage.”</small></div><div class="finance-route-core"><Icon name="sparkles"/><b>Intent matched</b><small>New mortgage</small></div><div class="finance-departments">{[['home','Mortgage'],['currency-coin','Personal lending'],['briefcase','Business finance'],['shield-check','Insurance'],['chart-bar','Wealth'],['document','Claims'],['building','Branch'],['headset','Human help']].map(([i,n],x)=><article class={x===0?'matched':''}><span><Icon name={i}/></span><b>{n}</b>{x===0&&<em>Matched</em>}</article>)}</div></div></div></section>

    <section class="estate-section consultation-mesh"><div class="estate-shell split"><div class="copy"><span class="eyebrow">APPOINTMENT BOOKING</span><h2>Move interested clients toward <em>the right advisor.</em></h2><p>Reduce scheduling back-and-forth by connecting qualified client intent with configured specialist availability.</p><div class="qualify-chips">{[['home','Mortgage consultation'],['chart-bar','Retirement planning'],['briefcase','Business finance'],['shield-check','Insurance review']].map(([i,n],x)=><span class={`chip-${x}`}><Icon name={i}/>{n}</span>)}</div></div><div class="advisor-screen estate-glass"><header><div><small>ADVISOR SCHEDULING</small><h3>Find a consultation</h3></div><span>Business finance</span></header><div class="advisor-match"><span>RL</span><div><small>MATCHED SPECIALIST</small><b>Rachel Lee · Commercial Advisor</b></div><em>Available</em></div><div class="advisor-times">{[['Tue','10:30 AM'],['Wed','2:00 PM'],['Thu','9:15 AM']].map(([d,t],x)=><article class={x===1?'selected':''}><small>{d}</small><b>{t}</b></article>)}</div><div class="appointment-context"><Icon name="sparkles"/><p>Business expansion · $250k–$500k · Toronto</p></div><button>Confirm consultation <Icon name="arrow-right"/></button></div></div></section>

    <section class="estate-section knowledge-section"><div class="estate-shell split"><div class="knowledge-screen estate-glass"><header><div><small>APPROVED KNOWLEDGE</small><h3>Financial services library</h3></div><span>Current</span></header>{[['book','Service information','Products, processes, eligibility basics'],['building','Branch knowledge','Hours, locations, available teams'],['shield-check','Conversation guardrails','Scope, verification, escalation'],['refresh','Connected information','Authorized current business data']].map(([i,n,p],x)=><article class={`knowledge-${x}`}><span><Icon name={i}/></span><div><b>{n}</b><small>{p}</small></div><em><Icon name="check"/></em></article>)}<footer><Icon name="sparkles"/><p>Answers use approved information—not guesses.</p></footer></div><div class="copy"><span class="eyebrow">FINANCIAL SERVICES KNOWLEDGE ENGINE</span><h2>Answer from approved information—<em>not a guess.</em></h2><p>Give Ralvie the right service information and access only to current data required for each authorized workflow.</p><ul><li>General product and service information</li><li>Branch and advisor availability</li><li>Clear identity and access boundaries</li><li>Human escalation for sensitive requests</li></ul></div></div></section>

    <section class="estate-section branches-mesh"><div class="estate-shell split"><div class="branch-screen estate-glass"><header><div><small>MULTI-BRANCH OVERVIEW</small><h3>Client service network</h3></div><span>Today</span></header>{[['Downtown Branch','186','94%'],['North Region','142','89%'],['Commercial Centre','96','92%'],['Digital Advisory','218','97%']].map(([n,c,v],x)=><article><span class={`branch-${x}`}><Icon name="building"/></span><div><b>{n}</b><small>{c} conversations</small></div><i><em style={`--w:${v}`}></em></i><strong>{v}</strong></article>)}<footer><Icon name="sparkles"/><p>Business-finance enquiries are up 18% at Commercial Centre.</p></footer></div><div class="copy"><span class="eyebrow">MULTI-BRANCH FRONTDESK</span><h2>One Frontdesk across <em>your branch network.</em></h2><p>Identify intent and location, apply relevant knowledge, then answer, capture, or route using local rules.</p><ul><li>Branch-specific hours and services</li><li>Regional and specialist routing</li><li>One consistent client experience</li><li>Central insight with branch context</li></ul></div></div></section>

    <section class="estate-section finance-analytics"><div class="estate-shell"><div class="section-head centered"><span class="eyebrow">CONVERSATION ANALYTICS</span><h2>Understand why clients <em>are contacting you.</em></h2></div><div class="estate-dashboard estate-glass"><header><div><small>FINANCIAL SERVICES FRONTDESK</small><h3>Client communication overview</h3></div><button>Today</button></header><div class="estate-kpis">{[['chat','Client conversations','746','+13%'],['target','New opportunities','184','+17%'],['calendar','Consultations','68','+11%'],['users','Human transfers','92','−4%']].map(([i,n,v,c],x)=><article class={`estate-kpi-${x}`}><span><Icon name={i}/></span><small>{n}</small><strong>{v}</strong><em>{c}</em></article>)}</div><div class="dash-body"><article><b>Client demand by hour</b><div class="estate-bars">{[31,45,69,91,78,63,86,74,58,43,29,20].map(h=><i style={`--h:${h}%`}></i>)}</div><footer><span>7 AM</span><span>10 PM</span></footer></article><aside><b>Top intents</b>{[['Lending','31%'],['Account services','23%'],['Insurance','18%'],['Advisory','16%'],['Other','12%']].map(([n,v],x)=><p><i class={`dot-${x}`}></i>{n}<strong>{v}</strong></p>)}</aside></div></div></div></section>

    <section class="estate-section human finance-responsible"><div class="estate-shell human-panel"><div><span class="eyebrow">RESPONSIBLE FINANCIAL AI</span><h2>Automate communication. <em>Keep financial expertise human.</em></h2><p>Ralvie supports access and administration. Authorized people and systems retain advice, identity verification, KYC, lending, claims, and other consequential decisions.</p></div><div class="human-rules">{[['shield-check','Verified scope','Use approved information and controls'],['user','Identity boundary','Verify before sensitive disclosure'],['users','Human decisions','Advice and approvals stay authorized'],['bolt','Urgent routing','Escalate fraud and security concerns']].map(([i,n,p],x)=><article class={`human-${x}`}><span><Icon name={i}/></span><div><b>{n}</b><small>{p}</small></div></article>)}</div></div></section>

    <section class="estate-section faq"><div class="estate-shell faq-grid"><div class="section-head"><span class="eyebrow">FREQUENTLY ASKED QUESTIONS</span><h2>Financial Services Frontdesk, <em>explained.</em></h2><p>Help every client reach the right information, workflow, or professional faster.</p></div><div class="faq-list">{faqs.map(([q,a],x)=><details open={x===0}><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></div></section>
    <FrontdeskFinalCta id="demo" />
  </main><Footer theme="light"/>
</Layout>
