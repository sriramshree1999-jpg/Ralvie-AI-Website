---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Icon from '../../../components/Icon.astro';
import FrontdeskFinalCta from '../../../components/FrontdeskFinalCta.astro';
import { Image } from 'astro:assets';
import realEstateImage from '../../../assets/real estate.jpg';
import '../../../styles/real-estate.css';

const title = 'AI Receptionist for Real Estate | Ralvie AI Frontdesk';
const description = 'Capture property enquiries 24/7. Answer buyer and seller questions, qualify leads, schedule showings, route calls, handle tenant requests, and connect conversations with your CRM.';
const faqs = [
  ['What is Ralvie AI Frontdesk for real estate?', 'Ralvie is an AI communication layer for property enquiries across phone, website chat, web voice, SMS, email, forms, routing, and connected workflows.'],
  ['Can Ralvie answer real estate calls 24/7?', 'Yes. Ralvie can answer supported calls around the clock, understand intent, capture context, and follow configured next steps.'],
  ['Can Ralvie capture buyer and seller leads?', 'Yes. It can collect contact details, property requirements, timelines, budget context, and the preferred next action.'],
  ['Can Ralvie answer questions about properties?', 'Yes, when connected to appropriate current listing information and configured knowledge sources.'],
  ['Can Ralvie schedule property showings?', 'Ralvie can support showing and consultation workflows through available scheduling integrations and configured rules.'],
  ['Can Ralvie route enquiries to specific agents?', 'Yes. Enquiries can be routed by listing, territory, office, property type, intent, or requested agent.'],
  ['Can Ralvie support property management?', 'Yes. It can capture tenant enquiries and maintenance details and follow configured operational or escalation workflows.'],
  ['Does Ralvie replace real estate agents?', 'No. Ralvie prepares and moves the conversation forward while agents retain relationships, advice, negotiation, and professional judgment.'],
];
const schema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---
<Layout title={title} description={description} theme="light" showScene={false}>
  <Header title="Ralvie AI" theme="light"/><script type="application/ld+json" is:inline set:html={JSON.stringify(schema)}/>
  <main class="estate-page pt-(--header-height)">
    <section class="estate-hero estate-mesh"><div class="estate-shell hero-grid"><div class="hero-copy"><span class="estate-pill"><i></i> RALVIE AI FRONTDESK FOR REAL ESTATE</span><h1 class="industry-title-lines"><span>Turn Every Property</span><span>Enquiry Into the</span><span><em>Right Next Step.</em></span></h1><p class="industry-description-lines"><span>Answer calls and digital enquiries 24/7. Qualify buyers and sellers,</span><span>schedule showings, and route conversations while keeping</span><span>lead context connected across the journey.</span></p><div class="estate-actions"><a href="#get-started" class="estate-primary">Start your free trial <Icon name="arrow-right"/></a><a href="#get-started" class="estate-secondary"><Icon name="calendar"/> Book a demo</a></div><small>24/7 lead capture · Showing scheduling · Smart agent routing · CRM workflows</small></div>
      <div class="estate-visual"><Image src={realEstateImage} alt="Real estate professional discussing a property" class="estate-image" widths={[640,960,1280]} sizes="(max-width:920px) 100vw, 52vw" loading="eager"/><div class="lead-screen"><header><div><small>NEW PROPERTY ENQUIRY</small><strong>Buyer lead</strong></div><span>High intent</span></header><div class="lead-person"><span>JO</span><div><b>Jordan Oliver</b><small>Lakeview Drive listing</small></div></div><div class="lead-fields"><p><small>BUDGET</small><b>$850k–$950k</b></p><p><small>VIEWING</small><b>Saturday AM</b></p><p><small>STATUS</small><b>Pre-approved</b></p></div><footer><span><Icon name="sparkles"/> Qualified</span><b>Assign agent →</b></footer></div><div class="showing-widget"><span><Icon name="calendar"/></span><div><small>SHOWINGS TODAY</small><strong>12 booked</strong><em>4 awaiting confirmation</em></div></div></div>
    </div></section>

    <section class="estate-section momentum"><div class="estate-shell momentum-grid"><div><span class="eyebrow">REAL ESTATE MOVES FAST</span><h2>Respond while intent is <em>still high.</em></h2><p>A buyer at 9:30 PM, a seller on Sunday, or a tenant after hours should not become another missed opportunity.</p></div><div class="journey">{[['chat','Enquiry'],['sparkles','Understand'],['form','Qualify'],['calendar','Schedule'],['users','Agent']].map(([i,n],x)=><article><small>0{x+1}</small><span><Icon name={i}/></span><b>{n}</b></article>)}</div></div></section>

    <section class="estate-section call-mesh"><div class="estate-shell split"><div class="call-screen estate-glass"><header><div><span><Icon name="phone"/></span><div><small>INCOMING PROPERTY CALL</small><h3>Ralvie Real Estate Frontdesk</h3></div></div><b>00:56</b></header><div class="transcript"><p class="caller">I’m calling about the house on Lakeview Drive. Is it still available?</p><p class="ralvie">Yes, that property is currently available. Would you like to arrange a viewing?</p></div><div class="detected"><Icon name="sparkles"/><div><small>INTENT DETECTED</small><b>Buyer · Listing enquiry · Viewing interest</b></div><em>97%</em></div><footer>{['Listing matched','Lead captured','Showing workflow'].map((n,x)=><span class={x<2?'done':''}><Icon name="check"/>{n}</span>)}</footer></div><div class="copy"><span class="eyebrow">24/7 AI RECEPTIONIST</span><h2>Every call can become <em>an opportunity.</em></h2><p>Ralvie identifies whether the caller is a buyer, seller, tenant, investor, or existing client and follows the right configured journey.</p><ul><li>Answer listing and office questions</li><li>Capture structured lead details</li><li>Qualify intent through conversation</li><li>Route with context to the right professional</li></ul></div></div></section>

    <section class="estate-section dark-leads"><div class="estate-shell"><div class="section-head centered"><span class="eyebrow">ALWAYS-ON LEAD CAPTURE</span><h2>Buyers don’t only search during <em>office hours.</em></h2><p>Keep property conversations moving while agents are showing homes, meeting clients, or away from the office.</p></div><div class="lead-types">{[['home','Buyer','Property, budget, location'],['currency-coin','Seller','Valuation and timeline'],['building','Tenant','Rental or service request'],['chart-bar','Investor','Residential or commercial'],['briefcase','Commercial','Space and business needs']].map(([i,n,p],x)=><article><span><Icon name={i}/></span><small>0{x+1}</small><h3>{n}</h3><p>{p}</p></article>)}</div></div></section>

    <section class="estate-section qualification"><div class="estate-shell split"><div class="copy"><span class="eyebrow">AI BUYER QUALIFICATION</span><h2>Give agents more than <em>a name and number.</em></h2><p>Turn natural conversation into a useful lead profile with the property requirement, readiness, timeline, and requested next step.</p><div class="qualify-chips">{[['home','Property type'],['currency-coin','Budget range'],['globe','Preferred area'],['calendar','Move timeline']].map(([i,n],x)=><span class={`chip-${x}`}><Icon name={i}/>{n}</span>)}</div></div><div class="profile-screen estate-glass"><header><div><small>BUYER PROFILE</small><h3>Qualified opportunity</h3></div><span>82 / 100</span></header><div class="profile-row"><span>JO</span><div><b>Jordan Oliver</b><small>Active buyer · First conversation</small></div><em>High intent</em></div>{[['Property','Detached home'],['Area','Lakeview / North'],['Budget','$850k–$950k'],['Timeline','Within 60 days'],['Financing','Pre-approved']].map(([n,v],x)=><p><span>{n}</span><b>{v}</b><i><em style={`--w:${[92,78,86,71,96][x]}%`}></em></i></p>)}<footer><Icon name="sparkles"/><span>Recommended: schedule a viewing and assign the Lakeview territory agent.</span></footer></div></div></section>

    <section class="estate-section listing-mesh"><div class="estate-shell split"><div class="listing-screen estate-glass"><header><div><small>LIVE LISTING KNOWLEDGE</small><h3>18 Lakeview Drive</h3></div><span>Available</span></header><div class="property-card"><div class="property-art"><Icon name="home"/></div><div><b>Modern detached home</b><small>Lakeview · 4 bed · 3 bath</small><strong>$899,000</strong></div></div><div class="listing-facts">{[['home','2,480 sq ft'],['calendar','Open Sat 11 AM'],['globe','Lakeview School'],['building','Double garage']].map(([i,n])=><span><Icon name={i}/>{n}</span>)}</div><div class="listing-question"><Icon name="chat"/><div><small>BUYER ASKED</small><p>“Can I arrange a private viewing on Sunday?”</p></div></div><button>Start scheduling workflow <Icon name="arrow-right"/></button></div><div class="copy"><span class="eyebrow">DYNAMIC PROPERTY INFORMATION</span><h2>Answer while buyers are <em>looking at the listing.</em></h2><p>When connected to current property data, Ralvie can identify the listing, retrieve relevant information, and respond according to your rules.</p><ul><li>Availability and listing details</li><li>Open-house and viewing information</li><li>Property-specific agent routing</li><li>Safe fallback when data is unavailable</li></ul></div></div></section>

    <section class="estate-section routing"><div class="estate-shell"><div class="section-head"><span class="eyebrow">SMART AGENT ROUTING</span><h2>Right customer. <em>Right agent.</em></h2><p>Route by listing, neighborhood, territory, property type, intent, office, or requested staff member.</p></div><div class="routing-board"><div class="request-node"><span><Icon name="user"/></span><b>Buyer enquiry</b><small>Luxury condo · Downtown</small></div><div class="routing-core"><Icon name="sparkles"/><b>Rules matched</b><small>Intent + territory</small></div><div class="agent-grid">{[['home','Residential'],['building','Commercial'],['globe','Downtown'],['briefcase','Luxury'],['users','Leasing'],['headset','General office']].map(([i,n],x)=><article class={x===2?'matched':''}><span><Icon name={i}/></span><b>{n}</b>{x===2&&<em>Assigned</em>}</article>)}</div></div></div></section>

    <section class="estate-section offices-mesh"><div class="estate-shell split"><div class="office-screen estate-glass"><header><div><small>MULTI-OFFICE OVERVIEW</small><h3>Lead network</h3></div><span>Today</span></header>{[['Downtown Office','146','92%'],['North Region','112','86%'],['West Realty','88','89%'],['Commercial Team','64','81%']].map(([n,c,v],x)=><article><span class={`office-${x}`}><Icon name="building"/></span><div><b>{n}</b><small>{c} enquiries</small></div><i><em style={`--w:${v}`}></em></i><strong>{v}</strong></article>)}<footer><Icon name="sparkles"/><p>Seller valuation requests are up 16% in the North Region.</p></footer></div><div class="copy"><span class="eyebrow">MULTI-LOCATION REAL ESTATE</span><h2>One Frontdesk across <em>multiple offices.</em></h2><p>Keep the customer experience simple while applying local listings, teams, territories, hours, and routing rules.</p><ul><li>Central AI experience</li><li>Local business context</li><li>Territory-aware lead assignment</li><li>Cross-office communication visibility</li></ul></div></div></section>

    <section class="estate-section analytics"><div class="estate-shell"><div class="section-head centered"><span class="eyebrow">CONVERSION ANALYTICS</span><h2>Understand the real estate <em>lead funnel.</em></h2></div><div class="estate-dashboard estate-glass"><header><div><small>REAL ESTATE FRONTDESK</small><h3>Opportunity overview</h3></div><button>Last 30 days</button></header><div class="estate-kpis">{[['chat','New enquiries','1,248','+18%'],['target','Qualified leads','486','+12%'],['calendar','Showing requests','214','+9%'],['home','Seller leads','96','+22%']].map(([i,n,v,c],x)=><article class={`estate-kpi-${x}`}><span><Icon name={i}/></span><small>{n}</small><strong>{v}</strong><em>{c}</em></article>)}</div><div class="dash-body"><article><b>Enquiry activity</b><div class="estate-bars">{[35,52,68,91,74,63,88,70,56,46,31,24].map(h=><i style={`--h:${h}%`}></i>)}</div><footer><span>Week 1</span><span>Week 4</span></footer></article><aside><b>Lead types</b>{[['Buyers','42%'],['Sellers','24%'],['Rentals','16%'],['Commercial','11%'],['Other','7%']].map(([n,v],x)=><p><i class={`dot-${x}`}></i>{n}<strong>{v}</strong></p>)}</aside></div></div></div></section>

    <section class="estate-section human"><div class="estate-shell human-panel"><div><span class="eyebrow">AI + REAL ESTATE PROFESSIONALS</span><h2>Let AI prepare the conversation. <em>Let agents build the relationship.</em></h2><p>Ralvie handles access, questions, qualification, scheduling, and routing. Your professionals keep advice, negotiation, relationships, and judgment.</p></div><div class="human-rules">{[['sparkles','AI prepares','Captures and structures the opportunity'],['users','Agent takes over','Receives useful conversation context'],['shield-check','Professional boundary','Advice and decisions stay human'],['link','Connected journey','Keep context in supported systems']].map(([i,n,p],x)=><article class={`human-${x}`}><span><Icon name={i}/></span><div><b>{n}</b><small>{p}</small></div></article>)}</div></div></section>

    <section class="estate-section faq"><div class="estate-shell faq-grid"><div class="section-head"><span class="eyebrow">FREQUENTLY ASKED QUESTIONS</span><h2>Real Estate Frontdesk, <em>explained.</em></h2><p>Move every property conversation toward a clear and useful next step.</p></div><div class="faq-list">{faqs.map(([q,a],x)=><details open={x===0}><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></div></section>
    <FrontdeskFinalCta id="demo" />
  </main><Footer theme="light"/>
</Layout>
