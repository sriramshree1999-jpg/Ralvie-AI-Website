---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Icon from '../../../components/Icon.astro';
import ralvieLogoIcon from '../../../assets/Ralvie-logo-icon.svg';
import '../../../styles/customer-support.css';
import '../../../styles/support-typography-fix.css';
import '../../../styles/multilingual-support.css';
import '../../../styles/multilingual-support-overrides.css';

const title = 'Multilingual AI Customer Support | Ralvie AI Frontdesk';
const description = 'Support customers across multiple languages with Ralvie AI Frontdesk. Handle calls, website chat, web voice, SMS, and other customer conversations with multilingual AI that understands context, responds naturally, and routes customers when human help is needed.';
const channels = [
  ['phone','AI Phone Receptionist','Handle incoming calls through natural AI voice conversations in supported languages.'],
  ['chat','Website Chatbot','Let visitors ask questions in the language they are most comfortable using.'],
  ['microphone','Web Voicebot','Give visitors multilingual voice interactions directly in the browser.'],
  ['mail','SMS & email','Continue configured multilingual customer conversations through text workflows.'],
];
const faqs = [
  ['What is Ralvie AI multilingual support?','It enables configured customer conversations across supported languages using Frontdesk channels such as phone, website chat, web voice, and other applicable experiences.'],
  ['Can Ralvie handle multilingual phone calls?','Yes. Ralvie AI Phone Receptionist can support multilingual voice conversations according to the languages and voice capabilities configured for the deployment.'],
  ['Can the website chatbot support different languages?','Yes. Ralvie Website Chatbot can support conversations in applicable configured languages.'],
  ['Does the customer need to select a language first?','The experience depends on deployment configuration and can be designed to reduce unnecessary language-selection friction where supported.'],
  ['Can customers change language during a conversation?','Supported experiences can be configured to handle multilingual interaction patterns where the underlying language capabilities allow it.'],
  ['Can Ralvie use our business information?','Ralvie can use approved business knowledge as context while preserving important terminology and language-specific content where precision is required.'],
  ['Can multilingual calls be transferred to humans?','Yes. Handoff can be configured around customer need, language, department, region, and other business rules.'],
  ['How many languages does Ralvie support?','Available languages depend on the voice, model, channel, and deployment configuration. Confirm the exact language list for your deployment.'],
];
const faqSchema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---

<Layout title={title} description={description} theme="light" showScene={false}>
  <Header title="Ralvie AI" theme="light" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  <main class="support-page multilingual-page pt-(--header-height)">
    <section class="support-hero multilingual-hero"><div class="language-orb orb-a"></div><div class="language-orb orb-b"></div><div class="support-shell multilingual-hero-grid"><div class="hero-copy"><span class="hero-eyebrow"><span class="pulse"></span> Multilingual AI support</span><h1><span class="hero-line ink">Speak to Every</span><span class="hero-line ink">Customer in Their</span><span class="hero-line">Preferred Language.</span></h1><p class="hero-description">Give every customer a natural way to connect in their preferred language, with shared context and the right path to human help.</p><div class="hero-actions"><a href="https://app.frontdesk.ralvie.ai/login" target="_blank" rel="noopener noreferrer" class="primary-btn">Start your free trial <Icon name="arrow-right"/></a><a href="#get-started" class="secondary-btn"><Icon name="calendar"/> Book a demo</a></div></div><div class="language-console app-window"><header><img src={ralvieLogoIcon.src} alt="Ralvie AI"/><div><small>Ralvie AI Frontdesk</small><b>Multilingual conversation</b></div><span>● Live</span></header><div class="language-switcher"><b>Español</b><span>English</span><span>Français</span><span>Deutsch</span></div><main><p class="customer">Hola, necesito cambiar mi cita de mañana.</p><p class="ai">Claro. ¿Me puede indicar su nombre y la hora que prefiere?</p><p class="customer">María López. Después de las dos, por favor.</p><p class="ai">Perfecto, María. Encontré dos horarios disponibles.</p><div class="translation"><small>Intent understood</small><b>Reschedule appointment · Spanish</b></div></main><footer><span>Language: Spanish</span><span>Intent: Appointment</span><span>Context retained</span></footer></div></div></section>

    <section class="section"><div class="support-shell split"><div class="copy"><span class="eyebrow">A more accessible first conversation</span><h2>Language shouldn’t be a barrier between <em>your business and your customers.</em></h2><p>Customers should not have to wait for the right multilingual employee, move between departments, or rely on separate translation tools before they can explain what they need.</p><strong class="closing">Fewer language barriers. More accessible customer conversations.</strong></div><div class="barrier-card app-window">{[['Finding the right agent','Customer waits'],['Separate language menus','Conversation starts with friction'],['External translation tools','Context becomes fragmented'],['Ralvie AI Frontdesk','Immediate multilingual first response']].map(([a,b],i)=><article class:list={[i===3&&'active']}><span>{i===3?<Icon name="check"/>:<Icon name="x-mark"/>}</span><div><b>{a}</b><small>{b}</small></div></article>)}</div></div></section>

    <section class="section soft-mesh"><div class="support-shell"><div class="section-head center"><span class="eyebrow">Omnichannel language support</span><h2>Let customers choose how—and where—<em>they communicate.</em></h2></div><div class="multilingual-channels">{channels.map(([icon,n,c])=><article><span><Icon name={icon}/></span><h3>{n}</h3><p>{c}</p></article>)}</div></div></section>

    <section class="section context-language" id="language-demo"><div class="support-shell split"><div class="language-chat app-window"><header><img src={ralvieLogoIcon.src} alt="Ralvie AI"/><div><b>Ralvie AI Frontdesk</b><small><i></i> Language-aware chat</small></div><em>FR</em></header><main><p class="visitor">Bonjour, notre terminal ne se synchronise plus depuis ce matin.</p><p class="ai">Je peux vous aider. Avez-vous déjà redémarré le terminal?</p><p class="visitor">Oui, deux fois.</p><p class="ai">Merci. Je vais éviter cette étape et vérifier les prochaines options de dépannage.</p></main><footer><span>Support request</span><span>Existing product</span><span>Restart attempted</span><span>Sync issue</span></footer></div><div class="copy"><span class="eyebrow">Context-aware multilingual AI</span><h2>Understand the customer—<em>not just the language.</em></h2><p>Translation alone converts words. Useful support also identifies intent, important details, conversation history, and the next information needed.</p><ul><li>Natural, language-appropriate responses</li><li>Relevant follow-up questions</li><li>Context preserved when languages change</li></ul></div></div></section>

    <section class="section language-band"><div class="support-shell"><div class="section-head center light"><span class="eyebrow">Language-aware conversations</span><h2>Start naturally. Continue naturally. <em>Switch when needed.</em></h2></div><div class="language-path">{[['ES','Customer starts in Spanish','Ralvie continues in Spanish'],['FR','Customer starts in French','Ralvie responds in French'],['EN','Customer starts in English','Ralvie continues in English'],['EN + ES','Customer switches language','Context stays connected']].map(([code,a,b])=><article><span>{code}</span><b>{a}</b><p>{b}</p></article>)}</div></div></section>

    <section class="section"><div class="support-shell split"><div class="copy"><span class="eyebrow">Knowledge-powered support</span><h2>One business knowledge layer. <em>Multiple customer languages.</em></h2><p>Use approved websites, FAQs, documents, product information, policies, procedures, APIs, databases, and CRM workflows as context for applicable multilingual conversations.</p><strong class="closing">Language changes. Business rules stay consistent.</strong></div><div class="terminology-card app-window"><header><span><Icon name="book"/></span><div><small>Terminology controls</small><b>Protected brand language</b></div></header>{[['Ralvie AI Frontdesk','Keep original'],['AI Phone Receptionist','Keep original'],['Model RX-240','Protected model number'],['Support explanation','Translate naturally']].map(([term,rule],i)=><article><div><b>{term}</b><small>{rule}</small></div><span class:list={[i===3&&'translated']}>{i===3?'Localized':'Locked'}</span></article>)}</div></div></section>

    <section class="section routing-section soft-mesh"><div class="support-shell"><div class="section-head center"><span class="eyebrow">Smart multilingual routing</span><h2>Route based on the customer’s need—<em>not simply their language.</em></h2></div><div class="routing-grid">{[['Spanish enterprise lead','Spanish-speaking sales','Enterprise demo'],['French support request','Regional support team','Technical assistance'],['English technical issue','Product specialist','Priority escalation']].map(([source,team,outcome],i)=><article><span>0{i+1}</span><div><small>Conversation</small><b>{source}</b></div><Icon name="arrow-right"/><div><small>Assigned team</small><b>{team}</b></div><em>{outcome}</em></article>)}</div></div></section>

    <section class="section analytics-language"><div class="support-shell"><div class="section-head center"><span class="eyebrow">Language analytics</span><h2>Understand where multilingual demand <em>is growing.</em></h2><p>Use conversation patterns to inform staffing, content, regional sales coverage, and market strategy.</p></div><div class="language-dashboard app-window"><header><div><small>Multilingual customer intelligence</small><b>Today’s conversations</b></div><button>Last 24 hours</button></header><div class="language-kpis">{[['Conversations','684'],['Multilingual','216'],['Voice','94'],['Website chat','72'],['Human escalations','32'],['Qualified leads','27']].map(([n,v])=><article><small>{n}</small><b>{v}</b></article>)}</div><div class="language-chart"><article><b>Language distribution</b>{[['English','68%'],['Spanish','14%'],['French','7%'],['Other configured','11%']].map(([n,v])=><p><span>{n}</span><i><b style={`--w:${v}`}></b></i><em>{v}</em></p>)}</article><article><b>Top multilingual intents</b>{['Customer support','Product information','Lead enquiry','Appointment request','Order or account question'].map((x,i)=><p><span>{String(i+1).padStart(2,'0')}</span>{x}</p>)}</article></div></div></div></section>

    <section class="section soft-mesh"><div class="support-shell"><div class="section-head center"><span class="eyebrow">Multilingual support across industries</span><h2>Serve more customers with <em>a consistent first experience.</em></h2></div><div class="industry-grid">{['Hospitality','Travel & tourism','Healthcare & clinics','Real estate','Retail & ecommerce','SaaS & technology','Automotive','Multi-location enterprises'].map((x,i)=><article><span><Icon name={i%3===0?'building':i%3===1?'globe':'briefcase'}/></span><h3>{x}</h3></article>)}</div></div></section>

    <section class="section"><div class="support-shell"><div class="section-head center"><span class="eyebrow">How it works</span><h2>One multilingual AI layer across <em>the customer journey.</em></h2></div><div class="steps-grid multilingual-steps">{['Connect business knowledge','Configure supported languages','Set conversation rules','Activate customer channels','Customer starts naturally','Understand language and intent','Respond or act','Escalate when needed'].map((x,i)=><article><span>{String(i+1).padStart(2,'0')}</span><h3>{x}</h3></article>)}</div></div></section>

    <section class="section comparison soft-mesh"><div class="support-shell"><div class="section-head center"><span class="eyebrow">Before & after Ralvie</span><h2>Move beyond translation toward <em>useful communication.</em></h2></div><div class="compare-table">{[['Wait for a matching language agent','Immediate AI first-line support'],['Separate language phone menus','Natural multilingual voice'],['Translated but static website','Conversational multilingual chat'],['Customers repeat after transfer','Context moves with the workflow'],['Language support depends on staffing','AI extends multilingual coverage'],['Translation alone','Language + intent + business context']].map(([a,b])=><div class="compare-row"><span><Icon name="x-mark"/>{a}</span><span><Icon name="check"/>{b}</span></div>)}</div></div></section>

    <section class="section faq"><div class="support-shell faq-layout"><div class="faq-column faq-column-left"><div class="section-head"><span class="eyebrow">Frequently asked questions</span><h2>Multilingual AI support, <em>explained.</em></h2><p>Language-aware customer conversations with your business context behind them.</p></div><div class="faq-list">{faqs.slice(0,2).map(([q,a],i)=><details open={i===0}><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></div><div class="faq-column"><div class="faq-list">{faqs.slice(2).map(([q,a])=><details><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></div></div></section>

    <section class="final-cta multilingual-final" id="get-started"><div class="cta-mesh" aria-hidden="true"><i></i><i></i><i></i></div><div class="support-shell center"><span class="eyebrow">One Frontdesk. More ways to be understood.</span><h2>Make Your Business Easier to Reach <em>In Every Language You Support.</em></h2><p>Give customers a natural way to call, chat, ask questions, explain their needs, and reach the right next step—24/7.</p><div class="cta-actions"><a class="primary-btn" href="#">Book a demo <Icon name="arrow-right"/></a><a class="secondary-btn" href="#language-demo"><Icon name="microphone"/> Talk to Ralvie AI</a></div><small>Different languages. One intelligent customer experience.</small></div></section>
  </main>
  <Footer theme="light" />
</Layout>
