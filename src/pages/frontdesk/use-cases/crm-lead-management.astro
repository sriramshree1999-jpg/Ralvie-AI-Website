---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Icon from '../../../components/Icon.astro';
import ralvieLogoIcon from '../../../assets/Ralvie-logo-icon.svg';
import '../../../styles/customer-support.css';
import '../../../styles/support-typography-fix.css';
import '../../../styles/crm-lead-management.css';

const title = 'AI Lead Capture & Appointment Booking | Ralvie AI Frontdesk';
const description = 'Capture, qualify, and route leads with Ralvie AI Frontdesk. Engage prospects across phone, chat, web voice, SMS, email, and forms, then move qualified leads directly toward appointment booking.';
const channels = [
  ['phone','Phone calls','Capture requirements and buying intent during natural voice conversations.'],
  ['chat','Website chat','Turn anonymous visits into qualified sales conversations.'],
  ['microphone','Web voice','Let prospects speak with your website and share details naturally.'],
  ['mail','Email','Identify sales enquiries and organize useful customer context.'],
  ['chat','SMS','Continue qualification and follow-up through two-way text.'],
  ['document','Website forms','Collect structured lead details with conditional questions.'],
];
const faqs = [
  ['Can Ralvie capture leads automatically?','Ralvie can collect configured lead information during supported phone, website chat, web voice, SMS, email, and form interactions.'],
  ['What information can Ralvie collect?','Depending on the workflow, Ralvie can collect contact details, company information, requirements, location count, expected usage, product interest, timeline, and preferred follow-up.'],
  ['Can it qualify leads?','Ralvie can ask configured qualification questions and organize the answers around your sales requirements.'],
  ['Can we choose the qualification questions?','Yes. Flows can reflect your product, industry, customer type, and sales process.'],
  ['Can Ralvie book appointments?','Ralvie can connect customer conversations with supported calendar and appointment workflows to help qualified customers move toward booking.'],
  ['Can appointments be booked during phone calls?','Where an appropriate scheduling workflow is configured, Ralvie can guide callers through appointment booking during the conversation.'],
  ['Can visitors book through website chat?','Yes. A website-chat conversation can move into a configured scheduling workflow when appropriate.'],
  ['Can different leads be routed to different calendars?','Qualification and routing logic can use lead type, product interest, geography, business size, or department.'],
  ['Can Ralvie update our CRM?','Ralvie can participate in supported CRM workflows through integrations, APIs, webhooks, and other configured connections.'],
  ['Can sales see what was discussed before the meeting?','Relevant captured lead information, conversation context, and AI-generated summaries can be made available through configured workflows.'],
  ['Can Ralvie capture leads outside business hours?','Yes. Ralvie AI Frontdesk can remain available 24/7 across supported customer channels.'],
  ['Does Ralvie replace salespeople?','No. Ralvie automates repetitive first response, capture, qualification, routing, scheduling, and administration while people focus on discovery, relationships, and closing.'],
];
const faqSchema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---

<Layout title={title} description={description} theme="light" showScene={false}>
  <Header title="Ralvie AI" theme="light" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  <main class="support-page crm-lead-page pt-(--header-height)">
    <section class="support-hero crm-hero mesh-bg"><div class="support-shell hero-grid">
      <div class="hero-copy"><span class="hero-eyebrow"><span class="pulse"></span> AI lead capture & appointment booking</span><h1><span class="hero-line ink">Capture the Lead.</span><span class="hero-line ink">Qualify the Need.</span><span class="hero-line">Book the Next Step.</span></h1><p class="hero-description">Capture, qualify, and move prospects from any channel toward the right next step—including a booked appointment.</p><div class="hero-actions"><a href="https://app.frontdesk.ralvie.ai/login" target="_blank" rel="noopener noreferrer" class="primary-btn">Start your free trial <Icon name="arrow-right"/></a><a href="#get-started" class="secondary-btn"><Icon name="calendar"/> Book a demo</a></div></div>
      <div class="lead-board app-window" aria-label="AI CRM lead pipeline demonstration"><header><div><small>AI CRM</small><b>Lead opportunity workspace</b></div><span>Live</span></header><div class="lead-kpis"><article><small>New leads</small><b>128</b><em>+18%</em></article><article><small>Qualified</small><b>64</b><em>+12%</em></article><article><small>Demo requests</small><b>29</b><em>+8%</em></article></div><div class="pipeline-mini"><div class="pipeline-head"><b>Priority leads</b><span>View pipeline</span></div>{[['EC','Emily Carter','MapleWave Solutions','Enterprise demo','High'],['NL','Noah Laurent','Cedar Health Group','AI Phone Receptionist','Qualified'],['SP','Sophie Patel','Northern Stay Hotels','Website Chatbot','New']].map(([initials,name,company,interest,status],i)=><article><i class={`avatar a${i+1}`}>{initials}</i><div><b>{name}</b><small>{company}</small></div><span>{interest}</span><em>{status}</em></article>)}</div><footer><span>Conversation</span><Icon name="arrow-right"/><span>Qualified lead</span><Icon name="arrow-right"/><span>Sales action</span></footer></div>
    </div></section>

    <section class="section intro"><div class="support-shell narrow center"><span class="eyebrow">From interest to action</span><h2>Don’t let high-intent customers stop at <em>“Contact us.”</em></h2><p>A prospect may ask a question, call after hours, request information, or submit a form when they are ready to act. Ralvie answers, captures the lead, understands the requirement, qualifies the opportunity, and offers the appropriate next step.</p><div class="crm-path"><span>Conversation</span><i>→</i><span>Capture</span><i>→</i><span>Qualify</span><i>→</i><span>Book</span><i>→</i><span>CRM follow-up</span></div></div></section>

    <section class="section soft-mesh"><div class="support-shell"><div class="section-head center"><span class="eyebrow">Omnichannel lead capture</span><h2>Capture leads wherever <em>conversations happen.</em></h2><p>Do not make lead capture depend on someone being available or a prospect finding the right form.</p></div><div class="channel-grid crm-channels">{channels.map(([icon,name,copy],i)=><article class={`feature-card tone-${i+1}`}><span><Icon name={icon}/></span><h3>{name}</h3><p>{copy}</p></article>)}</div></div></section>

    <section class="section"><div class="support-shell split"><div class="copy"><span class="eyebrow">AI lead qualification</span><h2>Ask the right questions <em>before sales gets involved.</em></h2><p>Qualification adapts to the conversation, so a multi-location healthcare group does not receive the same discovery flow as a small SaaS company.</p><ul><li>Company, industry, size, and locations</li><li>Requirement, expected usage, and timeline</li><li>Current system and preferred next step</li></ul></div><div class="qualify-chat app-window"><header><span class="ralvie-logo-tile"><img src={ralvieLogoIcon.src} alt="Ralvie AI" /></span><div><small>Qualification assistant</small><b>Healthcare opportunity</b></div><em>In progress</em></header><div class="q-bubble ai">How many locations does your business operate?</div><div class="q-bubble prospect">We have 22 clinics.</div><div class="q-bubble ai">Are you planning to implement this quarter?</div><div class="q-bubble prospect">Yes, within the next six weeks.</div><footer><b>Lead context captured</b><span>22 locations</span><span>Healthcare</span><span>6-week timeline</span></footer></div></div></section>

    <section class="section profile-band"><div class="support-shell"><div class="section-head center light"><span class="eyebrow">AI CRM</span><h2>Turn conversations into <em>organized customer records.</em></h2><p>Useful CRM context should not depend on someone manually entering every detail after a conversation.</p></div><div class="contact-detail app-window"><aside><header><button aria-label="Back">←</button><div><b>Emily Carter</b><small>+1 (416) 555-0142</small><small>emily.carter@maplewave.ca</small></div></header><button class="sequence">Enroll in sequence</button><dl><div><dt>Name</dt><dd>Emily Carter</dd></div><div><dt>Phone number</dt><dd>🇨🇦 &nbsp; +1 (416) 555-0142</dd></div><div><dt>Email</dt><dd>emily.carter@maplewave.ca</dd></div><div><dt>Assignee</dt><dd class="muted">Unassigned</dd></div></dl><h4>Properties</h4><dl><div><dt>Lead created</dt><dd>Aug 13, 4:30 PM</dd></div><div><dt>Company name</dt><dd>MapleWave Solutions</dd></div><div><dt>Lead source</dt><dd><i></i> Chatbot</dd></div></dl></aside><main><nav><b>◷ &nbsp; Activity</b><span>⌕ &nbsp; Calls</span><span>□ &nbsp; Messages</span><span>◯ &nbsp; Chat</span></nav><section class="notes"><header><b>Notes</b><span>0</span></header><div>Add a note. Use @ to mention a teammate.</div><small>No notes yet. Add the first one above.</small></section><h4>Activity timeline</h4><div class="activity-list">{[['Interested solution','Ralvie AI Frontdesk'],['Requested plan change','Business'],['Type of plan action','Upgrade'],['Reason for plan change','More voice minutes'],['Company name','MapleWave Solutions']].map(([label,value])=><article><i></i><p><b>{label}</b> changed to <strong>{value}</strong></p><time>Aug 13, 4:32 PM</time></article>)}</div></main><aside class="related"><header><b>Related records</b><button>+</button></header><small>0 linked</small><div><span>◇</span><b>No linked records</b><button>＋ Link record</button></div></aside></div></div></section>

    <section class="section soft-mesh"><div class="support-shell"><div class="section-head center"><span class="eyebrow">Conversational booking</span><h2>Move qualified prospects directly toward <em>the right appointment.</em></h2><p>Reduce scheduling back-and-forth by connecting qualification with an appropriate calendar workflow while buying intent is still high.</p></div><div class="journey-line">{[['chat','Conversation','Interest identified'],['target','Qualification','Fit confirmed'],['users','Lead context','Details structured'],['calendar','Availability','Times presented'],['check','Appointment','Meeting booked'],['database','CRM','Context updated']].map(([icon,title,copy],i)=><><article><span><Icon name={icon}/></span><b>{title}</b><small>{copy}</small></article>{i<5&&<i>→</i>}</>)}</div></div></section>

    <section class="section"><div class="support-shell split"><div class="copy"><span class="eyebrow">Smart booking routes</span><h2>Book the right meeting—<em>not simply any meeting.</em></h2><p>Use product interest, geography, business size, customer type, and technical requirements to guide qualified prospects toward the right team or calendar.</p><strong class="closing">Better qualification. Clearer ownership. Faster scheduling.</strong></div><div class="route-board app-window"><div class="route-source"><span><Icon name="calendar"/></span><b>Appointment-ready lead</b><small>MapleWave Solutions · 12 locations</small></div><div class="route-rules"><article><small>Lead type</small><b>Enterprise</b></article><article><small>Region</small><b>Canada</b></article><article><small>Meeting</small><b>Product demo</b></article></div><div class="route-result"><span>Book with</span><b>Enterprise Sales — Canada</b><em>Times available today</em></div></div></div></section>

    <section class="section dashboard-band"><div class="support-shell"><div class="section-head center light"><span class="eyebrow">Pipeline visibility</span><h2>Know what is moving—and <em>what needs attention.</em></h2><p>See lead volume, qualification, source, follow-up requirements, and active opportunities in one sales view.</p></div><div class="contacts-screen app-window"><nav><b>♙ &nbsp; Contacts</b><span>▣ &nbsp; Tickets</span><span>＋ New object</span><i></i><button>⇧ &nbsp; Import</button><button>⇩ &nbsp; Export</button></nav><div class="saved"><small>Saved views</small><b>All</b></div><div class="contact-tools"><label>⌕ &nbsp; Search customers...</label><button>↕ Sort</button><button>▽ Filters</button><button>▤ Pipeline</button><button>☷ Table</button><button class="add">＋ Add</button></div><div class="contacts-table"><header><span>□ &nbsp; Customer</span><span>Customer details</span><span>Actions</span></header>{[['Emily Carter','+1 (416) 555-0142','emily.carter@maplewave.ca','Company: MapleWave Solutions','Lead source: Chatbot'],['Noah Laurent','+1 (514) 555-0168','noah.laurent@cedarhealth.ca','Company: Cedar Health Group','Lead source: Phone'],['Sophie Patel','+1 (604) 555-0119','sophie.patel@northernstay.ca','Company: Northern Stay Hotels','Lead source: Website voice'],['Liam Bennett','+1 (403) 555-0175','liam.bennett@prairietech.ca','Company: PrairieTech Systems','Lead source: Email']].map(([name,phone,email,company,source])=><article><span><i>□</i><b>{name}</b><small>⌕ {phone}</small><small>✉ {email}</small></span><span><em>{company}</em><em>{source}</em></span><span>♲</span></article>)}</div><footer>1–30 of 30 customers &nbsp; ‹ &nbsp; <b>1</b> &nbsp; ›</footer></div></div></section>

    <section class="section"><div class="support-shell"><div class="section-head center"><span class="eyebrow">How it works</span><h2>From first interest to <em>a booked opportunity.</em></h2></div><div class="steps-grid crm-steps">{['Connect customer channels','Define qualification questions','Connect scheduling','Prospect starts naturally','Understand the need','Capture and qualify','Offer the right next step','Book the appointment','Update connected systems'].map((x,i)=><article><span>{String(i+1).padStart(2,'0')}</span><h3>{x}</h3></article>)}</div></div></section>

    <section class="section comparison soft-mesh"><div class="support-shell"><div class="section-head center"><span class="eyebrow">Capture and booking before & after</span><h2>Fewer dead ends. <em>More opportunities moving forward.</em></h2></div><div class="compare-table">{[['Visitor submits a basic form','Conversational lead capture'],['Sales qualifies later','AI begins qualification immediately'],['After-hours leads wait','24/7 AI engagement'],['Appointment needs email exchange','Conversational booking workflow'],['Same booking link for everyone','Qualification-based calendar routing'],['Sales starts from zero','Pre-meeting context is available']].map(([a,b])=><div class="compare-row"><span><Icon name="x-mark"/>{a}</span><span><Icon name="check"/>{b}</span></div>)}</div></div></section>

    <section class="section faq crm-faq"><div class="support-shell faq-layout"><div class="faq-column faq-column-left"><div class="section-head"><span class="eyebrow">Frequently asked questions</span><h2>Lead capture and appointment booking, <em>explained.</em></h2><p>Capture richer context, qualify naturally, route intelligently, and book faster.</p></div><div class="faq-list">{faqs.slice(0,4).map(([q,a],i)=><details open={i===0}><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></div><div class="faq-column"><div class="faq-list">{faqs.slice(4).map(([q,a])=><details><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></div></div></section>

    <section class="final-cta" id="get-started"><div class="cta-mesh" aria-hidden="true"><i></i><i></i><i></i></div><div class="support-shell center"><span class="eyebrow">From first question to booked appointment</span><h2>Don’t Just Capture Leads.<br/><em>Move Them Forward.</em></h2><p>Capture leads 24/7, qualify naturally, collect richer context, route opportunities intelligently, and move ready customers toward the right appointment.</p><div class="cta-actions"><a class="primary-btn" href="#">Book a demo <Icon name="arrow-right"/></a><a class="secondary-btn" href="#">Talk to Ralvie AI</a></div><small>Turn customer conversations into qualified leads—and qualified leads into booked opportunities.</small></div></section>
  </main>
  <Footer theme="light" />
</Layout>
