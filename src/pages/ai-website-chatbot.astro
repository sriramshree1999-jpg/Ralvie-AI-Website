---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import OtherFrontdeskFeatures from '../components/OtherFrontdeskFeatures.astro';
import ralvieLogoIcon from '../assets/Ralvie-logo-icon.svg';

const title = 'AI Website Chatbot for Business | Ralvie AI Frontdesk';
const description = 'Turn website visitors into conversations with Ralvie AI Frontdesk. Answer questions instantly, capture and qualify leads, book appointments, and connect visitors with your team 24/7.';
const features = [
  ['chat','Instant answers','Give visitors useful answers about your products, services, policies, pricing, and approved business knowledge.'],
  ['sparkles','Natural conversations','Understand follow-ups, changing topics, buying intent, and what visitors mean—not only keywords.'],
  ['target','Lead qualification','Collect requirements, timelines, company details, and intent while interest is at its highest.'],
  ['calendar','Appointment booking','Move a qualified visitor from enquiry to an available meeting without leaving the conversation.'],
  ['users','Human handover','Bring in sales or support with the conversation context intact when a person adds the most value.'],
  ['globe','Multilingual, 24/7','Keep helping visitors across languages, time zones, evenings, weekends, and peak periods.'],
];
const steps = [
  ['01','Engage','Welcome visitors at the right moment with a helpful greeting based on the page they are viewing and how they arrived.'],
  ['02','Understand','Interpret each question, follow-up, language, and buying signal to understand what the visitor actually needs.'],
  ['03','Respond','Retrieve accurate information from approved business knowledge and deliver a clear, natural, context-aware answer instantly.'],
  ['04','Qualify & Act','Ask useful follow-up questions, capture key details, and then book, route, notify, or trigger the right workflow.'],
  ['05','Escalate','Bring in the right team member when human help adds value, preserving the full conversation and every detail already collected.'],
];
const chatbotWorkflow: [string, string, string, [string, string, string][]][] = [
  ['01', 'A visitor lands on your site', 'Meet visitors at the right moment', [['globe', 'Look and placement', 'Light theme · Bottom right'], ['bolt', 'Open automatically', 'After 30 seconds']]],
  ['02', 'They open the chat', 'Start with a natural welcome', [['chat', 'Greeting and identity', 'Hi! How can we help you today?']]],
  ['03', 'Ralvie answers', 'Respond using trusted knowledge', [['sparkles', 'Chat instructions', 'Connected to your AI Frontdesk knowledge']]],
  ['04', 'It brings in a human', 'Hand over with full context', [['users', 'Human handoff', 'Configured scenarios active'], ['phone', 'Contact preference', 'Route to the right team']]],
  ['05', 'Your team gets notified', 'Keep every opportunity moving', [['mail', 'Alerts and follow-up', 'Dashboard notifications on']]],
];
const sources = [['globe','Websites'],['document','Documents'],['link','APIs'],['database','Databases'],['users','CRMs'],['squares','Business systems']];
const actions = [['target','Capture','Collect useful visitor details naturally.'],['sparkles','Qualify','Understand fit, urgency, and intent.'],['database','Retrieve','Access approved connected information.'],['calendar','Book','Move visitors into scheduling workflows.'],['bolt','Trigger','Start automations, APIs, and webhooks.'],['users','Route','Send context to the right human team.']];
const industries = [['sparkles','SaaS & technology'],['building','Hotels & hospitality'],['heart','Healthcare & clinics'],['home','Real estate'],['briefcase','Retail & ecommerce'],['academic-cap','Education']];
const faqs = [
 ['What is an AI website chatbot?','An intelligent conversational assistant embedded into a website that understands visitor questions and responds using configured business knowledge and workflows.'],
 ['Can Ralvie answer questions about our products and services?','Yes. Ralvie can use approved information about your organization, products, services, policies, and processes.'],
 ['Can it capture and qualify leads?','Yes. It can collect visitor details and ask configured qualification questions around needs, location, timeline, or other criteria.'],
 ['Can visitors book appointments through the chatbot?','Ralvie can connect with supported calendar and scheduling workflows to move visitors from enquiry to appointment.'],
 ['Does it work outside business hours?','Yes. The AI chatbot can remain available 24/7, even when your team is offline.'],
 ['Can it connect to our CRM and business systems?','Ralvie supports workflows through APIs, webhooks, Zapier, CRMs, databases, calendars, and other supported integrations.'],
 ['Can it hand a conversation to a person?','Human handover workflows can be configured for conversations that need assistance from your team.'],
 ['Does Ralvie support multiple languages?','Yes. Ralvie supports multilingual interactions across the AI Frontdesk experience.'],
];
const faqSchema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---

<Layout title={title} description={description}>
  <Header title="Ralvie AI" theme="light" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  <main class="chat-page pt-(--header-height)">
    <section class="hero">
      <div class="mesh" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="container-page hero-grid">
        <div class="hero-copy reveal">
          <span class="eyebrow"><i></i> AI website chatbot</span>
          <h1>Turn Every Website Visit Into a <span>Conversation.</span></h1>
          <p class="lead">Answer instantly. Understand intent. Take action in real time.</p>
          <p>Ralvie AI Frontdesk answers questions, captures and qualifies leads, books appointments, accesses business knowledge, and guides every visitor toward the right next step—24/7.</p>
          <div class="hero-actions"><a href="https://app.frontdesk.ralvie.ai/login" target="_blank" rel="noopener noreferrer" class="primary">Start your free trial <Icon name="arrow-right" /></a><a href="#demo" class="secondary"><Icon name="calendar" /> Book a demo</a></div>
          <div class="proof"><span>24/7 conversations</span><span>Lead capture</span><span>Multilingual</span><span>Human handover</span></div>
        </div>
        <div class="chat-shell reveal" id="live-demo">
          <div class="chat-head"><span class="avatar"><img src={ralvieLogoIcon.src} alt="" /></span><div><b>Ralvie AI Frontdesk</b><small><i></i> Online now</small></div></div>
          <div class="chat-body" data-chat-body aria-live="polite" aria-label="Live conversation demonstration">
            <div class="bubble visitor" data-message data-conversation="0" data-kind="visitor">Do you offer solutions for enterprise teams?</div>
            <div class="bubble ai" data-message data-conversation="0" data-kind="ai">Yes. What are you looking to automate?</div>
            <div class="bubble visitor" data-message data-conversation="0" data-kind="visitor">Customer support and incoming enquiries. Around 8,000 a month.</div>
            <div class="bubble ai" data-message data-conversation="0" data-kind="ai" data-stage="qualify">That sounds like an enterprise setup. Shall I find a time with our team?</div>
            <div class="bubble visitor" data-message data-conversation="0" data-kind="visitor">Yes, please.</div>
            <div class="booking" data-message data-conversation="0" data-kind="ai" data-stage="book"><span><Icon name="calendar" /></span><div><b>Demo availability found</b><small>Tomorrow · 10:30 AM</small></div><Icon name="check" /></div>
            <div class="bubble ai" data-message data-conversation="1" data-kind="ai">Hi! Welcome to Ralvie AI. How can I help you today?</div>
            <div class="bubble visitor" data-message data-conversation="1" data-kind="visitor">Hola, necesito ayuda para reservar una demostración.</div>
            <div class="bubble ai" data-message data-conversation="1" data-kind="ai">¡Claro! Con gusto te ayudo. ¿Para cuántas personas sería la demostración?</div>
            <div class="bubble visitor" data-message data-conversation="1" data-kind="visitor">Para nuestro equipo de ventas de 25 personas.</div>
            <div class="bubble ai" data-message data-conversation="1" data-kind="ai" data-stage="qualify">Perfecto. ¿Te gustaría reservar una demostración para mañana?</div>
            <div class="bubble visitor" data-message data-conversation="1" data-kind="visitor">Sí, por favor.</div>
            <div class="booking" data-message data-conversation="1" data-kind="ai" data-stage="book"><span><Icon name="calendar" /></span><div><b>Demostración disponible</b><small>Mañana · 10:30 AM</small></div><Icon name="check" /></div>
            <div class="typing" data-typing aria-label="Ralvie is typing"><i></i><i></i><i></i></div>
          </div>
          <div class="intent"><span data-status="understand">Understanding request</span><span data-status="qualify">Qualifying lead</span><span data-status="book">Booking demo</span></div>
          <div class="composer" data-composer><span data-composer-text>Ask Ralvie anything…</span><button aria-label="Send message"><Icon name="arrow-right" /></button></div>
        </div>
      </div>
    </section>

    <section class="section statement"><div class="container-page narrow reveal"><span class="eyebrow">Your most responsive page</span><h2>Your website should do <span class="heading-accent">more than display information.</span></h2><p>A contact form asks a visitor to submit and wait. Ralvie starts a conversation immediately—understanding what they want,<br/>answering in context, and moving them toward an outcome while their intent is still high.</p><strong>From website traffic to real conversations.</strong></div></section>

    <section class="section soft"><div class="container-page"><div class="section-title reveal"><span class="eyebrow">Part of your team</span><h2>Meet the AI chatbot that gets things done.</h2></div><div class="feature-grid">{features.map(([icon,name,copy],i)=><article class:list={['card reveal',i<2&&'wide']}><span class="icon"><Icon name={icon}/></span><h3>{name}</h3><p>{copy}</p></article>)}</div></div></section>

    <section class="section flow-section"><div class="container-page"><div class="section-title reveal"><span class="eyebrow">One continuous journey</span><h2>From first message to next action.</h2></div><div class="steps" data-journey-steps>{steps.map(([number,label,description],i)=><button class:list={['step reveal',i===0&&'active']} type="button" data-journey-step aria-pressed={i===0?'true':'false'}><b>{number}</b><span>{label}</span><p>{description}</p>{i < steps.length - 1 ? <i></i> : null}</button>)}</div></div></section>

    <section class="section workflow-section"><div class="container-page"><div class="section-title reveal"><span class="eyebrow">Designed around the customer journey</span><h2><span>Configure</span><span>every step of</span><span>the conversation.</span></h2><p>Shape how Ralvie appears, greets visitors, answers questions, involves your team, and keeps everyone informed.</p></div><div class="workflow-board reveal">{chatbotWorkflow.map(([number,title,note,rows])=><article class="workflow-step"><header><div><small>Step {number}</small><h3>{title}</h3></div><p>{note}</p></header><div class="workflow-rows">{rows.map(([icon,label,value])=><div class="workflow-row"><span><Icon name={icon}/></span><b>{label}</b><p>{value}</p><Icon name="chevron-down"/></div>)}</div></article>)}</div></div></section>

    <section class="section knowledge"><div class="container-page split"><div class="reveal"><span class="eyebrow">Connected intelligence</span><h2>Give your chatbot real business knowledge.</h2><p class="large">Bring static website and document knowledge together with live information from APIs, calendars, databases, and business systems.</p><div class="knowledge-example"><span>Static</span><p>“What services do you offer?”</p><span>Dynamic</span><p>“What times are available tomorrow?”</p></div></div><div class="source-grid">{sources.map(([icon,label],i)=><article class="source reveal" style={`--delay:${i*.06}s`}><span class="source-icon"><Icon name={icon}/></span><b>{label}</b><small>Approved knowledge</small></article>)}</div></div></section>

    <section class="section action-section"><div class="container-page"><div class="section-title reveal"><span class="eyebrow">Conversation → understanding → action</span><h2>Don’t just answer questions. Take action.</h2><p>A useful AI chatbot can turn a conversation into the next business workflow.</p></div><div class="action-grid">{actions.map(([icon,name,copy])=><article class="action reveal"><span><Icon name={icon}/></span><div><h3>{name}</h3><p>{copy}</p></div></article>)}</div></div></section>

    <section class="section lead-section"><div class="container-page split"><div class="lead-card reveal"><div class="mini-title"><span><Icon name="chat"/></span><div><b>Qualified website lead</b><small>Just now</small></div></div><dl><div><dt>Interested in</dt><dd>Enterprise support automation</dd></div><div><dt>Company size</dt><dd>500+ employees</dd></div><div><dt>Volume</dt><dd>8,000 enquiries / month</dd></div><div><dt>Timeline</dt><dd>Within 60 days</dd></div><div><dt>Next action</dt><dd class="success">Demo booked</dd></div></dl></div><div class="reveal"><span class="eyebrow">Better than another form</span><h2>Capture leads while they’re interested.</h2><p class="large">Ralvie collects the details your team needs naturally inside the conversation. Sales receives context—not another anonymous “new website lead.”</p><div class="checks"><span><Icon name="check"/> Requirements understood</span><span><Icon name="check"/> Prospect automatically qualified</span><span><Icon name="check"/> Next action already clear</span></div></div></div></section>

    <section class="section omnichannel"><div class="container-page"><div class="section-title reveal"><span class="eyebrow">One AI Frontdesk</span><h2><span>One business. One intelligence layer.</span><span>Multiple ways to communicate.</span></h2></div><div class="channels reveal"><a href="/ai-phone-receptionist"><Icon name="phone"/><div><small>Voice channel</small><h3>AI Phone Receptionist</h3><p>Natural AI conversations for every incoming call.</p></div></a><a href="/ai-website-chatbot" aria-current="page"><Icon name="chat"/><div><small>Web channel</small><h3>AI Website Chatbot</h3><p>Real-time conversations for every website visitor.</p></div></a><a href="/ai-web-voicebot"><Icon name="microphone"/><div><small>Voice on web</small><h3>AI Web Voicebot</h3><p>Natural voice conversations directly on your website.</p></div></a><a href="/ai-website-forms"><Icon name="form"/><div><small>Web forms</small><h3>Website Forms</h3><p>Intelligent forms that capture, qualify, and route leads.</p></div></a><span class="core"><img src={ralvieLogoIcon.src} alt="Ralvie AI"/></span></div></div></section>

    <section class="section industries"><div class="container-page"><div class="section-title reveal"><span class="eyebrow">Built for your business</span><h2>Where website conversations matter.</h2></div><div class="industry-grid">{industries.map(([icon,name])=><article class="industry reveal"><span class="industry-icon"><Icon name={icon}/></span><h3>{name}</h3><span>Explore use case <Icon name="arrow-right"/></span></article>)}</div></div></section>

    <section class="section comparison soft"><div class="container-page split"><div class="reveal"><span class="eyebrow">A more useful website</span><h2>From a static website to an interactive front desk.</h2><p class="large">Give visitors a place to simply ask, “Can you help me?”—and let your website answer.</p></div><div class="comparison-list reveal">{[['Wait for a form reply','Immediate answers'],['Static fields','Conversational qualification'],['Business hours','Available 24/7'],['Separate booking page','Book in the conversation'],['Disconnected widget','Connected business workflows'],['Start over with an agent','Context-aware handover']].map(([oldWay,newWay])=><div><span><Icon name="x-mark"/>{oldWay}</span><b><Icon name="check"/>{newWay}</b></div>)}</div></div></section>

    <OtherFrontdeskFeatures current="chatbot" />
    <section class="section faq"><div class="container-page faq-grid"><div class="reveal"><span class="eyebrow">Questions, answered</span><h2>Everything you need to know.</h2><p>See how Ralvie fits your website, knowledge, and customer workflows.</p><a href="#demo" class="text-link">Talk to our team <Icon name="arrow-right"/></a></div><div>{faqs.map(([q,a],i)=><details class="reveal" open={i===0}><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></div></section>

    <section class="final-cta" id="demo"><div class="cta-orb" aria-hidden="true"></div><div class="container-page reveal"><span class="eyebrow">Meet Ralvie AI Frontdesk</span><h2>Turn Every Customer Conversation <span class="cta-keep">Into Action.</span></h2><p class="cta-description">Ralvie AI Frontdesk helps your business answer, understand, and act across every customer channel<br/>—voice calls, website chat, web voice, email, SMS, forms, and CRM. Be available 24/7. Respond instantly.<br/>Capture more opportunities. Connect every conversation to the right next step.</p><div class="cta-actions"><a href="https://app.frontdesk.ralvie.ai/login" target="_blank" rel="noopener noreferrer" class="primary">Try Ralvie AI Frontdesk <Icon name="arrow-right"/></a><a href="#" class="secondary dark-button"><Icon name="calendar"/> Book a Demo</a></div><small>One AI Frontdesk. Every customer channel. Always ready.</small></div></section>
  </main>
  <Footer theme="light" />
</Layout>

<script>
  const setup = () => {
    const body = document.querySelector<HTMLElement>('[data-chat-body]');
    const messages = [...document.querySelectorAll<HTMLElement>('[data-message]')];
    const typing = document.querySelector<HTMLElement>('[data-typing]');
    const composer = document.querySelector<HTMLElement>('[data-composer]');
    const composerText = document.querySelector<HTMLElement>('[data-composer-text]');
    const statuses = [...document.querySelectorAll<HTMLElement>('[data-status]')];
    if (!body || !typing || !messages.length || body.dataset.ready) return;
    body.dataset.ready = 'true';

    let run = 0;
    const wait = (ms: number) => new Promise<void>((resolve) => window.setTimeout(resolve, ms));
    const updateStatus = (stage: string) => {
      const order = ['understand', 'qualify', 'book'];
      const current = order.indexOf(stage);
      statuses.forEach((status, index) => {
        status.classList.toggle('done', index < current);
        status.classList.toggle('active', index === current);
      });
    };
    const reveal = (message: HTMLElement) => {
      message.classList.add('show');
      body.scrollTo({ top: body.scrollHeight, behavior: 'smooth' });
    };
    const typeVisitorMessage = async (text: string, currentRun: number) => {
      if (!composer || !composerText) return;
      composer.classList.add('is-typing');
      composerText.textContent = '';
      for (const character of text) {
        if (currentRun !== run) return;
        composerText.textContent += character;
        await wait(character === ' ' ? 16 : 28);
      }
      await wait(260);
      composer.classList.add('is-sending');
      await wait(180);
      composer.classList.remove('is-typing', 'is-sending');
      composerText.textContent = 'Ask Ralvie anything…';
    };
    const play = async (conversation = 0) => {
      const currentRun = ++run;
      messages.forEach((message) => message.classList.remove('show'));
      typing.classList.remove('show');
      composer?.classList.remove('is-typing', 'is-sending');
      if (composerText) composerText.textContent = 'Ask Ralvie anything…';
      statuses.forEach((status) => status.classList.remove('done', 'active'));
      body.scrollTop = 0;
      await wait(500);

      const conversationMessages = messages.filter((message) => message.dataset.conversation === String(conversation));
      for (const [index, message] of conversationMessages.entries()) {
        if (currentRun !== run) return;
        if (message.dataset.kind === 'ai') {
          typing.classList.add('show');
          body.append(typing);
          body.scrollTo({ top: body.scrollHeight, behavior: 'smooth' });
          await wait(index === conversationMessages.length - 1 ? 850 : 1100);
          if (currentRun !== run) return;
          typing.classList.remove('show');
          await wait(180);
        } else {
          await typeVisitorMessage(message.textContent?.trim() || '', currentRun);
          if (currentRun !== run) return;
        }
        reveal(message);
        if (index === 0) updateStatus('understand');
        if (message.dataset.stage) updateStatus(message.dataset.stage);
        await wait(message.dataset.kind === 'visitor' ? 750 : 1050);
      }
      if (currentRun !== run) return;
      statuses.forEach((status) => status.classList.add('done'));
      statuses.forEach((status) => status.classList.remove('active'));
      await wait(2200);
      if (currentRun !== run) return;
      play((conversation + 1) % 2);
    };

    play();
  };

  const setupJourney = () => {
    const root = document.querySelector<HTMLElement>('[data-journey-steps]');
    if (!root || root.dataset.ready) return;
    const journeySteps = [...root.querySelectorAll<HTMLButtonElement>('[data-journey-step]')];
    if (!journeySteps.length) return;
    root.dataset.ready = 'true';
    let activeIndex = 0;
    let timer = 0;

    const selectStep = (index: number) => {
      activeIndex = index;
      journeySteps.forEach((step, stepIndex) => {
        step.classList.remove('active');
        step.classList.toggle('completed', stepIndex < activeIndex);
        step.setAttribute('aria-pressed', 'false');
      });
      void root.offsetWidth;
      journeySteps[activeIndex]?.classList.add('active');
      journeySteps[activeIndex]?.setAttribute('aria-pressed', 'true');
    };
    const startTimer = () => {
      window.clearInterval(timer);
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      timer = window.setInterval(() => selectStep((activeIndex + 1) % journeySteps.length), 3000);
    };

    journeySteps.forEach((step, index) => step.addEventListener('click', () => {
      selectStep(index);
      startTimer();
    }));
    selectStep(0);
    startTimer();
  };

  setup(); setupJourney();
  document.addEventListener('astro:page-load', () => { setup(); setupJourney(); });
</script>

<style>
