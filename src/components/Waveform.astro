---
interface Props {
  bars?: number;
  class?: string;
}

const { bars = 5, class: className = "" } = Astro.props;
---

<span class={`waveform ${className}`} aria-hidden="true">
  {Array.from({ length: bars }).map(() => <span />)}
</span>

<script>
  import gsap from 'gsap';

  document.querySelectorAll<HTMLElement>('.waveform').forEach((waveform) => {
    const bars = waveform.querySelectorAll<HTMLElement>('span');
    bars.forEach((bar) => {
      const loop = () => {
        gsap.to(bar, {
          scaleY: 0.25 + Math.random() * 1,
          duration: 0.35 + Math.random() * 0.35,
          ease: 'sine.inOut',
          onComplete: loop,
        });
      };
      gsap.set(bar, { transformOrigin: 'center', scaleY: 0.3 + Math.random() * 0.7 });
      loop();
    });
  });
</script>
