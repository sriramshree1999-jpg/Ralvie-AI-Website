---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import femaleSupportAgent from '../../assets/female-customer-support-agent-2.jpg';

const scatteredTools = [
  { label: 'Phone system', offset: 'sm:-rotate-2' },
  { label: 'Email inbox', offset: 'sm:rotate-1' },
  { label: 'Booking tool', offset: 'sm:rotate-2' },
  { label: 'Spreadsheet', offset: 'sm:-rotate-1' },
];
---

<section class="section relative">
  <div class="container-page">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <div class="reveal">
        <Image
          src={femaleSupportAgent}
          alt="Female customer support agent working at a digital front office"
          class="platform-agent-image mx-auto aspect-[4/5] w-full max-w-sm rounded-3xl object-cover object-[42%_center]"
          loading="lazy"
        />
      </div>

      <div class="reveal text-center lg:text-left">
        <p class="chip text-label-sm">A connected front office</p>
        <h2 class="text-headline-lg mt-6 text-on-surface">
          Replace Disconnected Front-Office Tools With One Intelligent Platform
        </h2>

        <div class="mt-8 space-y-5">
          <p class="text-body-lg text-on-surface-variant">
            Traditional front-office systems separate calls, messages, emails, forms and follow-ups across different
            tools. Customer information becomes fragmented, employees spend time switching between platforms and
            opportunities can be lost during busy or after-hours periods.
          </p>
          <p class="text-body-lg text-on-surface-variant">
            Ralvie brings every channel into one connected AI front desk. It understands natural conversations,
            provides accurate answers, collects customer information and completes the next action without
            unnecessary delays.
          </p>
          <p class="text-body-lg text-on-surface-variant">
            Your team remains available when human support is important, while Ralvie manages repetitive and
            high-volume work that would otherwise slow them down.
          </p>
        </div>
      </div>
    </div>

    <div class="mt-16 grid grid-cols-1 gap-8 lg:grid-cols-2">
      <div class="glass-card reveal">
        <p class="text-label-sm text-on-surface-variant">The traditional way</p>
        <div class="mt-6 grid grid-cols-2 gap-3">
          {scatteredTools.map((tool) => (
            <div class={`rounded-lg border border-dashed border-outline-variant bg-surface-container-high/40 p-3 ${tool.offset}`}>
              <div class="flex gap-1">
                <span class="h-1.5 w-1.5 rounded-full bg-on-surface-variant/30"></span>
                <span class="h-1.5 w-1.5 rounded-full bg-on-surface-variant/30"></span>
                <span class="h-1.5 w-1.5 rounded-full bg-on-surface-variant/30"></span>
              </div>
              <p class="text-label-sm mt-2 text-on-surface-variant">{tool.label}</p>
            </div>
          ))}
        </div>
        <p class="text-body-md mt-6 text-on-surface-variant/70">
          Disconnected tools, fragmented customer information and repeated data entry.
        </p>
      </div>

      <div
        class="glass-card reveal"
        style="border-color: color-mix(in srgb, var(--color-primary) 35%, var(--color-outline-variant));"
      >
        <p class="text-label-sm text-secondary">Ralvie AI Frontdesk</p>
        <div class="mt-6 flex flex-col items-center gap-2 text-center">
          <span class="chip text-label-sm normal-case tracking-normal">Customer reaches out</span>
          <div class="flow-line--v h-6"></div>
          <span class="node-dot flex h-14 w-14 items-center justify-center" style="box-shadow: 0 0 32px -6px color-mix(in srgb, var(--color-primary) 70%, transparent);">
            <Icon name="sparkles" class="h-5 w-5 text-secondary" />
          </span>
          <div class="flow-line--v h-6"></div>
          <span class="chip text-label-sm normal-case tracking-normal">Booked, routed and followed up</span>
        </div>
        <p class="text-body-md mt-6 text-on-surface-variant">
          One connected journey, complete customer context and a team that stays available for what matters most.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .platform-agent-image {
    border: 1px solid rgb(143 159 255 / 42%);
    box-shadow:
      0 0 34px rgb(72 101 255 / 17%),
      0 0 58px rgb(171 63 255 / 8%),
      0 22px 55px rgb(2 5 18 / 38%);
  }
</style>
