---
import ralvieLogoIcon from '../../assets/Ralvie-logo-icon.svg';
import calComIcon from '../../assets/cal-com.svg';
import calendlyIcon from '../../assets/calendly.svg';
import gmailIcon from '../../assets/gmail.svg';
import zapierIcon from '../../assets/zapier.svg';
import googleMeetIcon from '../../assets/Google_Meet.svg';
import zoomIcon from '../../assets/zoom.svg';
import outlookIcon from '../../assets/outlook.svg';
import webhookIcon from '../../assets/webhooks.svg';

const integrations = [
  { name: 'Cal.com', mark: 'Cal', tone: 'cal', side: 'left', slot: 1 },
  { name: 'Calendly', mark: 'C', tone: 'calendly', side: 'left', slot: 2 },
  { name: 'Gmail', mark: 'M', tone: 'gmail', side: 'left', slot: 3 },
  { name: 'Zapier', mark: '✳', tone: 'zapier', side: 'left', slot: 4 },
  { name: 'Google Meet', mark: '▶', tone: 'meet', side: 'right', slot: 1 },
  { name: 'Zoom', mark: '▰', tone: 'zoom', side: 'right', slot: 2 },
  { name: 'Outlook', mark: 'O', tone: 'outlook', side: 'right', slot: 3 },
  { name: 'Webhook', mark: '⌘', tone: 'webhook', side: 'right', slot: 4 },
];

const serviceIcons: Record<string, typeof calComIcon> = {
  cal: calComIcon,
  calendly: calendlyIcon,
  gmail: gmailIcon,
  zapier: zapierIcon,
  meet: googleMeetIcon,
  zoom: zoomIcon,
  outlook: outlookIcon,
  webhook: webhookIcon,
};
---

<section id="integrations" class="frontdesk-integrations section relative">
  <div class="container-page">
    <div class="frontdesk-integrations-copy reveal">
      <p class="chip text-label-sm">Connected to your business</p>
      <h2 class="text-headline-lg mt-6 text-on-surface">Connect Ralvie With the Tools You Already Use</h2>
      <p class="text-body-lg mt-6 text-on-surface-variant">
        Ralvie AI Frontdesk can connect with more than 3,000 applications through APIs, webhooks and Zapier. It can
        work with your CRM, calendar, help desk, reservation platform, property management system, database,
        messaging applications and internal business tools.
      </p>
    </div>

    <div class="frontdesk-integration-network reveal" aria-label="Ralvie Frontdesk integrations">
      <svg class="frontdesk-integration-paths" viewBox="0 0 1200 400" aria-hidden="true" preserveAspectRatio="none">
        <g fill="none" stroke="currentColor" stroke-width="1.5">
          <path id="fd-path-1" d="M430 145 C365 145 380 50 170 50" /><path id="fd-path-2" d="M430 170 C355 170 375 135 170 135" /><path id="fd-path-3" d="M430 205 C355 205 375 265 170 265" /><path id="fd-path-4" d="M430 230 C365 230 380 350 170 350" />
          <path id="fd-path-5" d="M770 145 C835 145 820 50 1030 50" /><path id="fd-path-6" d="M770 170 C845 170 825 135 1030 135" /><path id="fd-path-7" d="M770 205 C845 205 825 265 1030 265" /><path id="fd-path-8" d="M770 230 C835 230 820 350 1030 350" />
        </g>
        {Array.from({ length: 8 }, (_, index) => <circle r="5" class="integration-particle"><animateMotion dur={`${3.2 + (index % 3) * .45}s`} begin={`${index * -.42}s`} repeatCount="indefinite" keyPoints="1;0" keyTimes="0;1" calcMode="linear"><mpath href={`#fd-path-${index + 1}`} /></animateMotion></circle>)}
      </svg>
      {integrations.map((integration) => <article class:list={['frontdesk-service', integration.side, `slot-${integration.slot}`]}><span class="service-mark"><img src={serviceIcons[integration.tone].src} alt="" /></span><b>{integration.name}</b></article>)}
      <article class="frontdesk-integration-hub">
        <span class="hub-ring ring-one"></span><span class="hub-ring ring-two"></span>
        <img src={ralvieLogoIcon.src} alt="Ralvie" />
        <div><small>RALVIE</small><strong>Frontdesk</strong><p>Connected customer operations</p></div>
      </article>
    </div>
  </div>
</section>

<style>
  .frontdesk-integrations{overflow:hidden;background:radial-gradient(circle at 10% 82%,rgba(102,74,230,.18),transparent 34%),radial-gradient(circle at 90% 18%,rgba(63,118,242,.2),transparent 32%),#070a1a}
  .frontdesk-integrations-copy{max-width:820px;margin-inline:auto;text-align:center}
  .frontdesk-integrations :global(.text-on-surface){color:#f4f6ff}.frontdesk-integrations :global(.text-on-surface-variant){color:#aeb9d5}.frontdesk-integrations :global(.chip){border-color:rgba(164,178,255,.42);background:rgba(131,146,245,.18);color:#bac5ff}
  .frontdesk-integration-network{position:relative;isolation:isolate;min-height:400px;margin-top:4rem;overflow:hidden;border:1px solid rgba(145,161,237,.16);border-radius:28px;background:radial-gradient(circle at 50% 50%,rgba(67,94,218,.18),transparent 28%),linear-gradient(145deg,rgba(20,27,61,.72),rgba(8,12,31,.9));box-shadow:inset 0 1px rgba(255,255,255,.06),0 28px 72px rgba(0,0,0,.25)}
  .frontdesk-integration-network:before{position:absolute;inset:0;background:linear-gradient(rgba(154,169,255,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(154,169,255,.04) 1px,transparent 1px);background-size:42px 42px;content:''}
  .frontdesk-integration-paths{position:absolute;z-index:1;inset:0;width:100%;height:100%;color:rgba(161,176,255,.52)}
  .integration-particle{fill:#aebcff;filter:drop-shadow(0 0 8px #879dff)}
  .frontdesk-service{position:absolute;z-index:2;display:flex;align-items:center;gap:.6rem;min-width:130px;padding:.6rem .75rem;border:1px solid rgba(159,174,247,.25);border-radius:14px;background:rgba(13,19,47,.88);box-shadow:inset 0 1px rgba(255,255,255,.05),0 10px 28px rgba(0,0,0,.18);color:#dce3ff}
  .frontdesk-service b{font-size:.7rem;letter-spacing:.02em}.frontdesk-service.left{left:4%}.frontdesk-service.right{right:4%;justify-content:flex-end}.frontdesk-service.slot-1{top:8%}.frontdesk-service.slot-2{top:30%}.frontdesk-service.slot-3{bottom:30%}.frontdesk-service.slot-4{bottom:8%}
  .service-mark{display:grid;place-items:center;flex:0 0 30px;width:30px;height:30px;border-radius:9px;background:rgba(255,255,255,.96);padding:5px}.service-mark img{display:block;width:100%;height:100%;object-fit:contain}
  .frontdesk-integration-hub{position:absolute;z-index:3;top:50%;left:50%;display:flex;align-items:center;justify-content:center;gap:1rem;width:min(340px,36vw);height:160px;padding:1.25rem;border:1px solid rgba(172,185,255,.38);border-radius:28px;background:linear-gradient(145deg,rgba(253,253,255,.98),rgba(238,240,255,.94));box-shadow:0 24px 60px rgba(42,54,130,.32);color:#171b39;transform:translate(-50%,-50%)}
  .frontdesk-integration-hub:before{position:absolute;inset:-1px;border-radius:inherit;background:linear-gradient(125deg,rgba(132,151,255,.6),transparent 38%,transparent 64%,rgba(133,213,255,.55));content:'';mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);mask-composite:exclude;padding:1px}
  .frontdesk-integration-hub img{position:relative;z-index:1;width:58px;height:58px}.frontdesk-integration-hub div{position:relative;z-index:1}.frontdesk-integration-hub small,.frontdesk-integration-hub strong{display:block}.frontdesk-integration-hub small{color:#6a70a0;font-size:.57rem;font-weight:850;letter-spacing:.13em}.frontdesk-integration-hub strong{margin-top:.2rem;color:#4d55d5;font-size:1.9rem;line-height:1}.frontdesk-integration-hub p{margin-top:.45rem;color:#717895;font-size:.66rem}
  .hub-ring{position:absolute;inset:50%;border:1px solid rgba(143,159,255,.35);border-radius:50%;transform:translate(-50%,-50%);animation:hub-ring 3s ease-out infinite}.ring-one{width:190px;height:190px}.ring-two{width:250px;height:250px;animation-delay:1.3s}@keyframes hub-ring{0%{opacity:.78;transform:translate(-50%,-50%) scale(.78)}75%,100%{opacity:0;transform:translate(-50%,-50%) scale(1.08)}}
  @media(max-width:760px){.frontdesk-integration-network{min-height:540px;margin-top:3rem}.frontdesk-service{min-width:112px;padding:.48rem .58rem}.frontdesk-service.left{left:3%}.frontdesk-service.right{right:3%}.frontdesk-service b{font-size:.6rem}.frontdesk-integration-hub{width:250px;height:135px}.frontdesk-integration-hub strong{font-size:1.45rem}.frontdesk-integration-paths{opacity:.48}.hub-ring{display:none}}
  @media(max-width:520px){.frontdesk-integration-network{min-height:620px}.frontdesk-service{min-width:95px}.frontdesk-service b{display:none}.frontdesk-service.slot-1{top:6%}.frontdesk-service.slot-2{top:24%}.frontdesk-service.slot-3{bottom:24%}.frontdesk-service.slot-4{bottom:6%}.frontdesk-integration-hub{width:220px;height:122px}.frontdesk-integration-hub p{display:none}}
  @media(prefers-reduced-motion:reduce){.integration-particle animateMotion,.hub-ring{animation:none}}
</style>
