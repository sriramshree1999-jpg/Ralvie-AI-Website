---
import { Image } from 'astro:assets';
import aiReceptionist from '../../assets/ai-receptionist.jpg';
---

<section class="section relative">
  <div class="container-page grid grid-cols-1 items-center gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
    <div class="reveal text-center lg:text-left">
      <p class="chip text-label-sm">One connected AI receptionist</p>
      <h2 class="text-headline-lg mt-6 text-on-surface">Your Complete AI Receptionist</h2>

      <ul class="intro-points mt-6" aria-label="AI receptionist benefits">
        <li class="text-body-lg text-on-surface-variant">
          Meet customers wherever they reach you—calls, website chat, email, forms, or text.
        </li>
        <li class="text-body-lg text-on-surface-variant">
          Give every customer an immediate, consistent experience with accurate answers and the right next step.
        </li>
        <li class="text-body-lg text-on-surface-variant">
          Manage every interaction through one connected AI receptionist instead of separate tools.
        </li>
      </ul>
    </div>

    <div class="reveal">
      <Image
        src={aiReceptionist}
        alt="AI receptionist wearing a headset"
        class="front-office-image aspect-[6/5] w-full rounded-3xl object-cover object-top"
        loading="lazy"
      />
    </div>
  </div>
</section>

<style>
  .front-office-image {
    width: min(100%, 42vw);
    max-width: 42vw;
    margin-left: auto;
    border: 1px solid rgb(143 159 255 / 42%);
    box-shadow:
      0 0 0 1px rgb(143 159 255 / 10%),
      0 22px 55px rgb(2 5 18 / 38%);
  }

  @media (max-width: 1024px) {
    .front-office-image {
      width: 100%;
      max-width: 100%;
    }
  }

  .intro-points {
    display: grid;
    gap: 1.1rem;
    padding: 0;
    list-style: none;
  }

  .intro-points li {
    position: relative;
    padding-left: 1.65rem;
  }

  .intro-points li::before {
    content: '';
    position: absolute;
    top: 0.72em;
    left: 0.2rem;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: linear-gradient(135deg, #6f8cff, #b66dff);
    box-shadow: 0 0 12px rgb(111 140 255 / 55%);
  }
</style>
