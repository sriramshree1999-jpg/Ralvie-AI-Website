---
import Icon from '../Icon.astro';

const tabs = [
  { name: 'Voice', icon: 'phone', active: true },
  { name: 'Chat', icon: 'chat', active: false },
  { name: 'Email', icon: 'mail', active: false },
  { name: 'SMS', icon: 'chat', active: false },
  { name: 'Web Voice', icon: 'microphone', active: false },
  { name: 'Forms', icon: 'form', active: false },
];

const conversations = [
  { title: 'New enquiry via website chat', channel: 'chat', time: '2m ago', sentiment: 'Neutral', tone: 'var(--accent-blue)' },
  { title: 'Appointment request for Thursday', channel: 'phone', time: '11m ago', sentiment: 'Positive', tone: 'var(--accent-teal)' },
  { title: 'Question about service pricing', channel: 'mail', time: '24m ago', sentiment: 'Neutral', tone: 'var(--accent-blue)' },
  { title: 'Callback requested — needs attention', channel: 'phone', time: '38m ago', sentiment: 'Attention', tone: 'var(--accent-coral)' },
  { title: 'Follow-up confirmed via SMS', channel: 'chat', time: '1h ago', sentiment: 'Positive', tone: 'var(--accent-teal)' },
];

const appointments = [
  { when: 'Thu · 2:30 PM', what: 'Consultation' },
  { when: 'Fri · 10:00 AM', what: 'Site visit' },
  { when: 'Mon · 9:15 AM', what: 'Follow-up call' },
];

// Decorative, relative bar heights only — no claimed figures.
const activityBars = [40, 65, 50, 80, 60, 35, 25];
const dayLabels = ['M', 'T', 'W', 'T', 'F', 'S', 'S'];
---

<section id="dashboard" class="section relative">
  <div class="container-page">
    <div class="section-head dashboard-preview-head reveal">
      <p class="chip text-label-sm">One central workspace</p>
      <h2 class="text-headline-lg text-on-surface">Manage Every Conversation From One Dashboard</h2>
      <p class="text-body-lg text-on-surface-variant">
        Ralvie gives your team a central view of customer activity across calls, chat, email, SMS, web voice and
        forms. Authorised users can review conversations, recordings, transcripts, summaries, appointments,
        transfers and captured leads — making it easier to spot unresolved enquiries that need employee follow-up.
      </p>
    </div>

    <div class="glass-card reveal overflow-hidden p-0!">
      <div class="flex items-center gap-2 border-b border-outline-variant px-5 py-3">
        <span class="h-2.5 w-2.5 rounded-full" style="background:var(--accent-coral)"></span>
        <span class="h-2.5 w-2.5 rounded-full" style="background:var(--accent-amber)"></span>
        <span class="h-2.5 w-2.5 rounded-full" style="background:var(--accent-teal)"></span>
        <span class="text-label-sm ml-2 text-on-surface-variant">Ralvie Dashboard</span>
      </div>

      <div class="flex flex-wrap gap-2 border-b border-outline-variant px-5 py-3" role="tablist" aria-label="Conversation channels">
        {tabs.map((tab) => (
          <span
            role="tab"
            aria-selected={tab.active}
            class={`chip text-label-sm normal-case tracking-normal ${tab.active ? 'text-on-surface' : 'text-on-surface-variant/70'}`}
            style={tab.active ? 'border-color: color-mix(in srgb, var(--color-primary) 50%, var(--color-outline-variant));' : ''}
          >
            <Icon name={tab.icon} class="h-3.5 w-3.5" />
            {tab.name}
          </span>
        ))}
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-[1.4fr_1fr]">
        <div class="divide-y divide-outline-variant border-outline-variant lg:border-r">
          {conversations.map((c) => (
            <div class="flex items-center justify-between gap-4 px-5 py-4">
              <div class="flex items-center gap-3">
                <span class="icon-tile h-9 w-9" style={`--tint: ${c.tone}`}>
                  <Icon name={c.channel} class="h-4 w-4" />
                </span>
                <div>
                  <p class="text-body-md text-on-surface">{c.title}</p>
                  <p class="text-label-sm mt-0.5 text-on-surface-variant/60">{c.time}</p>
                </div>
              </div>
              <span class="text-label-sm shrink-0" style={`color: ${c.tone}`}>{c.sentiment}</span>
            </div>
          ))}
        </div>

        <div class="space-y-6 p-5">
          <div>
            <p class="text-label-sm text-on-surface-variant">Appointment activity</p>
            <div class="mt-3 space-y-2">
              {appointments.map((a) => (
                <div class="flex items-center justify-between gap-3 rounded-lg bg-surface-container-high p-2.5">
                  <span class="text-body-md text-on-surface">{a.what}</span>
                  <span class="text-label-sm text-on-surface-variant/70">{a.when}</span>
                </div>
              ))}
            </div>
          </div>

          <div>
            <p class="text-label-sm text-on-surface-variant">Conversation activity</p>
            <div class="mt-4 flex h-24 items-end gap-2">
              {activityBars.map((h) => (
                <div class="w-full flex-1 rounded-t-md bg-linear-to-t from-primary to-secondary" style={`height:${h}%`}></div>
              ))}
            </div>
            <div class="mt-2 flex gap-2">
              {dayLabels.map((d) => (
                <span class="flex-1 text-center text-label-sm text-on-surface-variant/50">{d}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="section-head reveal mt-16" hidden>
      <p class="chip text-label-sm">Understand what your customers need</p>
      <h3 class="text-headline-md text-on-surface">Understand What Your Customers Need</h3>
      <p class="text-body-lg text-on-surface-variant">
        Every conversation provides useful information about customer expectations and business demand. Ralvie
        helps you identify common questions, popular services, peak enquiry periods, lead sources and conversation
        outcomes — turning customer conversations into actionable information for operational and strategic
        decisions.
      </p>
    </div>
  </div>
</section>

<style>
  @media (min-width: 1024px) {
    .dashboard-preview-head {
      max-width: 1720px;
      margin-inline: auto;
      text-align: center;
    }
  }
</style>
