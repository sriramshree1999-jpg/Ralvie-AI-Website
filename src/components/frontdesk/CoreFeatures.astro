---
import Icon from '../Icon.astro';

const features = [
  {
    name: 'AI Phone Receptionist',
    description: 'Answer calls, understand customer intent, capture details and route each conversation to the right next step.',
    icon: 'phone',
    href: '/ai-phone-receptionist',
    accent: 'var(--accent-blue)',
  },
  {
    name: 'AI Website Chatbot',
    description: 'Give website visitors immediate, helpful answers and turn conversations into qualified enquiries.',
    icon: 'chat',
    href: '/ai-website-chatbot',
    accent: 'var(--accent-violet)',
  },
  {
    name: 'AI Email Manager',
    description: 'Organise incoming email, identify intent and help your team respond to customers faster.',
    icon: 'mail',
    href: '/ai-email-manager',
    accent: 'var(--accent-coral)',
  },
  {
    name: 'AI CRM',
    description: 'Keep customer records, conversations and follow-up context connected in one intelligent workspace.',
    icon: 'database',
    href: '/ai-crm',
    accent: 'var(--accent-teal)',
  },
  {
    name: 'AI Web Voicebot',
    description: 'Let visitors speak naturally with your business from your website, at any time.',
    icon: 'microphone',
    href: '/ai-web-voicebot',
    accent: 'var(--accent-amber)',
  },
  {
    name: 'Website Forms',
    description: 'Turn structured customer requests into complete, actionable information for your team.',
    icon: 'form',
    href: '/ai-website-forms',
    accent: 'var(--accent-magenta)',
  },
];
---

<section id="core-features" class="frontdesk-core-features section relative">
  <div class="container-page">
    <div class="section-head centered reveal">
      <p class="chip text-label-sm">Core features</p>
      <h2 class="text-headline-lg mt-6 text-on-surface">Everything Your Frontdesk Needs to Keep Work Moving</h2>
      <p class="text-body-lg mt-6 text-on-surface-variant">
        Give every customer interaction a useful next step across phone, chat, email, web voice, CRM and forms.
      </p>
    </div>

    <div class="core-features-grid reveal">
      {features.map((feature) => (
        <a href={feature.href} class="core-feature-card">
          <span class="icon-tile" style={`--tint: ${feature.accent}`}>
            <Icon name={feature.icon} class="h-5 w-5" />
          </span>
          <h3 class="text-body-lg mt-5 font-semibold text-on-surface">{feature.name}</h3>
          <p class="text-body-md mt-3 text-on-surface-variant">{feature.description}</p>
          <span class="core-feature-link" style={`color: ${feature.accent}`}>
            Explore more <Icon name="arrow-right" class="h-4 w-4" />
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .frontdesk-core-features{overflow:hidden;background:radial-gradient(circle at 10% 78%,rgba(85,71,224,.16),transparent 31%),radial-gradient(circle at 91% 10%,rgba(45,149,235,.14),transparent 30%),#080c23}
  .frontdesk-core-features :global(.text-on-surface){color:#f5f7ff}.frontdesk-core-features :global(.text-on-surface-variant){color:#aeb9d5}.frontdesk-core-features :global(.chip){border-color:rgba(164,178,255,.42);background:rgba(131,146,245,.18);color:#bac5ff}
  .core-features-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
  .core-feature-card{display:flex;min-height:270px;flex-direction:column;padding:28px;border:1px solid rgba(157,174,247,.2);border-radius:20px;background:linear-gradient(145deg,rgba(28,35,75,.77),rgba(12,17,45,.88));box-shadow:inset 0 1px rgba(255,255,255,.05),0 20px 42px rgba(0,0,0,.18);transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease}
  .core-feature-card:hover{transform:translateY(-5px);border-color:rgba(159,174,255,.54);box-shadow:inset 0 1px rgba(255,255,255,.08),0 25px 52px rgba(10,16,52,.42)}
  .core-feature-card :global(.icon-tile){background:color-mix(in srgb,var(--tint) 14%,rgba(255,255,255,.04));border-color:color-mix(in srgb,var(--tint) 40%,rgba(178,190,255,.17));color:var(--tint)}
  .core-feature-link{display:inline-flex;align-items:center;gap:.55rem;margin-top:auto;padding-top:1.5rem;font-size:.9rem;font-weight:700}.core-feature-link :global(svg){transition:transform .2s ease}.core-feature-card:hover .core-feature-link :global(svg){transform:translateX(4px)}
  @media(max-width:900px){.core-features-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:620px){.core-features-grid{grid-template-columns:1fr}.core-feature-card{min-height:0;padding:24px}}
</style>
