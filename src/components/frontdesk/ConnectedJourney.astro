---
import Icon from '../Icon.astro';
import ralvieLogoIcon from '../../assets/Ralvie-logo-icon.svg';

const channels = [
  { name: 'Voice', icon: 'phone' },
  { name: 'Chat', icon: 'chat' },
  { name: 'Email', icon: 'mail' },
  { name: 'SMS', icon: 'chat' },
  { name: 'Web voice', icon: 'microphone' },
  { name: 'Forms', icon: 'form' },
];

const actions = ['Booking', 'Routing', 'Lead capture', 'Follow-up', 'Automation', 'Support'];
---

<section class="section relative">
  <div class="container-page">
    <div class="section-head connected-journey-head reveal">
      <p class="chip text-label-sm">Unified customer experience</p>
      <h2 class="text-headline-lg text-on-surface lg:whitespace-nowrap">
        Six Customer Channels. One Connected Experience.
      </h2>
    </div>

    <div class="grid grid-cols-1 items-center gap-16 lg:grid-cols-2 lg:gap-12">
      <div class="reveal">
        <div class="space-y-5">
          <p class="text-body-lg text-on-surface-variant">
            Every Ralvie channel works with the same business knowledge, customer context and automation rules.
            A customer may begin by submitting a form, continue through SMS, speak with Ralvie over the phone and
            later receive an email confirmation. Each interaction can remain connected instead of becoming a
            separate and disconnected conversation.
          </p>
          <p class="text-body-lg text-on-surface-variant">
            Ralvie identifies the customer's intent, provides the relevant information and determines the most
            appropriate next action. It can book an appointment, share a link, create a request, update a
            connected system or transfer the conversation to your team.
            The complete customer journey is recorded in one platform, giving your business better visibility into
            every interaction.
          </p>
        </div>
      </div>

      <div class="reveal glass-card intelligence-card">
        <div class="intelligence-map">
          <svg class="intelligence-connections" viewBox="0 0 1000 600" preserveAspectRatio="none" aria-hidden="true">
            {[50, 150, 250, 350, 450, 550].map((y) => <><line x1="0" y1={y} x2="500" y2="300" /><line x1="1000" y1={y} x2="500" y2="300" /></>)}
          </svg>
          <div class="intelligence-stack intelligence-channels">
            {channels.map((channel) => (
              <span class="chip text-label-sm justify-start normal-case tracking-normal">
                <Icon name={channel.icon} class="h-3.5 w-3.5 text-secondary" />
                {channel.name}
              </span>
            ))}
          </div>

          <div class="intelligence-core">
            <div
              class="node-dot h-20 w-20 shrink-0 text-on-surface"
              style="box-shadow: 0 0 32px -6px color-mix(in srgb, var(--color-primary) 70%, transparent);"
            >
              <img src={ralvieLogoIcon.src} alt="" class="h-10 w-10 object-contain" aria-hidden="true" />
            </div>
          </div>

          <div class="intelligence-stack intelligence-actions">
            {actions.map((action) => (
              <span class="chip text-label-sm justify-start normal-case tracking-normal">{action}</span>
            ))}
          </div>
        </div>
        <p class="text-label-sm mt-6 text-center text-on-surface-variant/60">
          One shared intelligence, every channel, every action
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .connected-journey-head {
    max-width: none;
  }

  .intelligence-card {
    min-height: 540px;
    padding: 2.25rem;
    box-shadow:
      inset 0 0 34px rgb(72 101 255 / 15%),
      inset 0 0 72px rgb(171 63 255 / 9%),
      0 0 36px rgb(72 101 255 / 17%),
      0 0 62px rgb(171 63 255 / 8%),
      0 18px 50px rgb(2 5 18 / 24%);
  }

  .intelligence-map {
    position: relative;
    display: grid;
    grid-template-columns: minmax(120px, 1fr) 150px minmax(120px, 1fr);
    min-height: 420px;
    gap: 1rem;
    isolation: isolate;
  }

  .intelligence-connections {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .intelligence-connections line {
    stroke: rgb(145 163 255 / 30%);
    stroke-width: 1.5;
    stroke-linecap: round;
    filter: drop-shadow(0 0 5px rgb(108 118 255 / 22%));
  }

  .intelligence-stack {
    display: grid;
    grid-template-rows: repeat(6, 1fr);
    align-items: center;
    gap: 0.7rem;
  }

  .intelligence-stack .chip {
    width: max-content;
    max-width: 100%;
    position: relative;
    z-index: 1;
    background: rgb(14 22 58 / 74%);
  }

  .intelligence-actions {
    justify-items: end;
  }

  .intelligence-core {
    display: grid;
    place-items: center;
    position: relative;
    z-index: 2;
  }

  .intelligence-core::before {
    content: '';
    position: absolute;
    width: 118px;
    height: 118px;
    border: 1px solid rgb(145 163 255 / 19%);
    border-radius: 50%;
    box-shadow: 0 0 36px rgb(96 105 255 / 15%), inset 0 0 22px rgb(119 91 237 / 11%);
  }

  .intelligence-core .node-dot {
    position: relative;
    z-index: 1;
  }

  @media (max-width: 640px) {
    .intelligence-card { min-height: 0; padding: 1.25rem; }
    .intelligence-map { grid-template-columns: 1fr; min-height: 0; gap: 1.4rem; }
    .intelligence-connections { display: none; }
    .intelligence-stack { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: none; }
    .intelligence-stack .chip { width: 100%; }
    .intelligence-actions { justify-items: start; }
    .intelligence-core { order: -1; min-height: 140px; }
  }
</style>
