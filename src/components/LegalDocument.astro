---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Icon from './Icon.astro';

interface Section {
  id: string;
  title: string;
  start: string;
}

interface Props {
  title: string;
  description: string;
  document: string;
  sections: Section[];
  product: 'productivity' | 'frontdesk';
  productivityHref: string;
  frontdeskHref: string;
}

const { title, description, document, sections, product, productivityHref, frontdeskHref } = Astro.props;
const firstSection = document.indexOf(sections[0].start);
const body = document.slice(firstSection).trim();
const renderedSections = sections.map((section, index) => {
  const start = body.indexOf(section.start);
  const next = index < sections.length - 1 ? body.indexOf(sections[index + 1].start, start + section.start.length) : body.length;
  return { ...section, content: body.slice(start, next).trim() };
});
---

<Layout title={`${title} | Ralvie AI`} description={description}>
  <Header title="Ralvie AI" theme="light" />
  <main class="legal-page pt-(--header-height)">
    <section class="legal-hero">
      <div class="mesh" aria-hidden="true"></div>
      <div class="container-page legal-hero__inner">
        <span class="eyebrow"><Icon name="shield-check" /> Legal</span>
        <h1>{title}</h1>
        <p>{description}</p>
        <div class="legal-product-switch" aria-label="Choose a Ralvie product">
          <a href={productivityHref} class:list={[product === 'productivity' && 'is-active']}><Icon name="chart-bar" />Ralvie AI Productivity</a>
          <a href={frontdeskHref} class:list={[product === 'frontdesk' && 'is-active']}><Icon name="headset" />Ralvie AI Frontdesk</a>
        </div>
      </div>
    </section>

    <section class="legal-content">
      <div class="container-page legal-layout">
        <aside class="legal-toc" aria-label={`${title} sections`}>
          <p>On this page</p>
          <nav>
            {sections.map((section, index) => <a href={`#${section.id}`}><span>{String(index + 1).padStart(2, '0')}</span>{section.title}</a>)}
          </nav>
        </aside>
        <article class="legal-document">
          {renderedSections.map((section, index) => (
            <section id={section.id} class="legal-section">
              <h2><span>{String(index + 1).padStart(2, '0')}</span>{section.title}</h2>
              <div class="legal-copy">{section.content}</div>
            </section>
          ))}
        </article>
      </div>
    </section>
  </main>
  <Footer theme="light" />
</Layout>

<style>
  .legal-page { background: #f7f9fd; color: #212744; }
  .legal-hero { position: relative; overflow: hidden; padding: 76px 0 60px; background: #f8faff; border-bottom: 1px solid #e3e8f3; }
  .mesh { position: absolute; inset: 0; pointer-events: none; opacity: .65; background-image: linear-gradient(rgba(100, 114, 166, .08) 1px, transparent 1px), linear-gradient(90deg, rgba(100, 114, 166, .08) 1px, transparent 1px); background-size: 52px 52px; mask-image: linear-gradient(to bottom, #000, transparent); }
  .legal-hero__inner { position: relative; max-width: 940px; margin: 0 auto; text-align: center; }
  .eyebrow { display: inline-flex; align-items: center; gap: 8px; color: #5269cf; font-size: .72rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .eyebrow :global(svg) { width: 17px; }
  h1 { max-width: 760px; margin: 17px auto; font-size: 3rem; letter-spacing: -.065em; line-height: .99; }
  .legal-hero p { max-width: 650px; margin: 0 auto; color: #68718e; font-size: 1.08rem; line-height: 1.75; }
  .legal-product-switch { display: inline-grid; grid-template-columns: 1fr 1fr; width: min(100%, 390px); margin-top: 20px; padding: 5px; border-radius: 14px; background: rgba(255,255,255,.78); box-shadow: 0 10px 24px rgba(53,63,124,.09); }
  .legal-product-switch a { display: flex; align-items: center; justify-content: center; gap: 6px; min-height: 44px; padding: 7px 8px; border-radius: 9px; color: #4d5268; font-size: clamp(.64rem, .9vw, .74rem); font-weight: 750; text-decoration: none; transition: background .2s ease, color .2s ease, box-shadow .2s ease; }
  .legal-product-switch a :global(svg) { width: 14px; }
  .legal-product-switch a.is-active { color: #fff; background: linear-gradient(110deg, #3e63f4, #785bea); box-shadow: 0 14px 28px rgba(68,83,216,.26); }
  .legal-content { padding: 72px 0 112px; }
  .legal-layout { display: grid; grid-template-columns: 350px minmax(0, 1fr); gap: 5rem; align-items: start; }
  .legal-toc { position: sticky; top: calc(var(--header-height) + 26px); padding: 22px; border: 1px solid #dfe5f0; border-radius: 16px; background: rgba(255,255,255,.82); box-shadow: 0 16px 42px rgba(46,55,104,.08); }
  .legal-toc p { margin-bottom: 13px; color: #252d52; font-size: .72rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .legal-toc nav { display: grid; gap: 3px; max-height: calc(100vh - var(--header-height) - 88px); overflow-y: auto; }
  .legal-toc a { display: block; padding: 10px 12px; border-left: 2px solid transparent; color: #707993; font-size: .9rem; line-height: 1.38; text-decoration: none; transition: .2s ease; }
  .legal-toc a span { display: inline-block; width: 1.65em; color: #586fd1; font-size: .85em; font-weight: 800; letter-spacing: .06em; line-height: 1; vertical-align: .08em; }
  .legal-toc a:hover { border-color: #5b76d4; color: #334eae; background: #f1f4ff; }
  .legal-toc nav { scrollbar-color: #4360f1 #f1f3f7; scrollbar-width: thin; }
  .legal-toc nav::-webkit-scrollbar { width: 10px; }
  .legal-toc nav::-webkit-scrollbar-track { background: #f1f3f7; border-radius: 999px; }
  .legal-toc nav::-webkit-scrollbar-thumb { background: #4360f1; border-radius: 999px; border: 2px solid #f1f3f7; }
  .legal-document { min-width: 0; }
  .legal-section { scroll-margin-top: calc(var(--header-height) + 28px); padding: 0 0 42px; margin-bottom: 42px; border-bottom: 1px solid #e0e5ee; }
  .legal-section:last-child { border: 0; margin-bottom: 0; }
  .legal-section h2 { margin-bottom: 20px; color: #283258; font-size: clamp(1.2rem, 2.45vw, 2.2rem); letter-spacing: -.04em; line-height: 1.15; }
  .legal-section h2 span { display: inline-block; margin-right: .42em; color: #586fd1; font-size: 1em; font-weight: 800; letter-spacing: .05em; line-height: 1; vertical-align: .04em; white-space: nowrap; }
  .legal-copy { color: #626b84; font-size: .98rem; line-height: 1.8; white-space: pre-line; }
  @media (max-width: 850px) { .legal-hero { padding: 56px 0 44px; } .legal-content { padding: 48px 0 76px; } .legal-layout { grid-template-columns: 1fr; gap: 32px; } .legal-toc { position: relative; top: auto; } .legal-toc nav { grid-template-columns: repeat(2, minmax(0, 1fr)); max-height: none; } }
  @media (max-width: 520px) { .legal-product-switch { grid-template-columns: 1fr; border-radius: 18px; } .legal-product-switch a { min-height: 58px; } .legal-toc nav { grid-template-columns: 1fr; } .legal-toc { padding: 16px; } .legal-copy { font-size: .93rem; } }
</style>
