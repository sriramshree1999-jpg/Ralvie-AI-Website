---
import Icon from './Icon.astro';
interface Props { id?: string; }
const { id = 'demo' } = Astro.props;
---
<section class="frontdesk-shared-cta" id={id}><div class="cta-orb orb-one"></div><div class="cta-orb orb-two"></div><div class="cta-content"><span class="cta-pill">MEET RALVIE AI FRONTDESK</span><h2>Turn Every Customer Conversation <span>Into Action.</span></h2><p>Ralvie AI Frontdesk helps your business answer, understand, and act across every customer channel—voice calls, website chat, web voice, email, SMS, forms, and CRM. Be available 24/7. Respond instantly. Capture more opportunities. Connect every conversation to the right next step.</p><div class="cta-actions"><a href="#" class="cta-primary">Try Ralvie AI Frontdesk <Icon name="arrow-right"/></a><a href="#" class="cta-secondary"><Icon name="calendar"/> Book a Demo</a></div><small>One AI Frontdesk. Every customer channel. Always ready.</small></div></section>
<style>
.frontdesk-shared-cta{position:relative;isolation:isolate;overflow:hidden;padding:7.5rem 1.5rem;background:#141b46;color:#fff;text-align:center}.cta-orb{position:absolute;z-index:-1;border-radius:50%;filter:blur(80px)}.orb-one{width:38rem;height:38rem;left:-14rem;bottom:-20rem;background:rgba(105,73,236,.34)}.orb-two{width:34rem;height:34rem;right:-10rem;top:-18rem;background:rgba(56,131,229,.28)}.cta-content{width:min(1060px,100%);margin:auto}.cta-pill{display:inline-flex;padding:.95rem 2rem;border-radius:999px;border:1px solid rgba(139,157,255,.36);background:linear-gradient(135deg,rgba(93,126,255,.24),rgba(151,88,231,.2));color:#b8c4ff;font:700 .75rem/1 var(--font-label);letter-spacing:.13em}.frontdesk-shared-cta h2{font-size:clamp(2.7rem,5vw,4.8rem);line-height:1.05;letter-spacing:-.05em;margin:1.6rem 0}.frontdesk-shared-cta h2 span{background:linear-gradient(90deg,#91a9ff,#a77af3,#58c5ec);background-clip:text;-webkit-background-clip:text;color:transparent}.frontdesk-shared-cta p{max-width:940px;margin:auto;color:#bac2df;font-size:1.02rem;line-height:1.75}.cta-actions{display:flex;justify-content:center;gap:.8rem;margin:2.2rem 0}.cta-actions a{display:inline-flex;align-items:center;justify-content:center;gap:.55rem;padding:.95rem 1.3rem;border-radius:12px;font-weight:700}.cta-primary{background:linear-gradient(135deg,#315bea,#7f6cf7);color:#fff;box-shadow:0 14px 32px rgba(61,99,245,.25)}.cta-secondary{color:#fff;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.16)}.cta-actions svg{width:17px}.frontdesk-shared-cta small{color:#8f99bd;font-weight:700}
@media(max-width:620px){.frontdesk-shared-cta{padding:5.5rem 1.25rem}.cta-actions{flex-direction:column;max-width:330px;margin:2rem auto}.cta-actions a{width:100%}}
</style>
