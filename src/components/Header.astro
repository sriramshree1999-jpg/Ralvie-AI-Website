---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import ralvieLogoWhite from '../assets/Ralvie-logo-white.svg';
import ralvieLogo from '../assets/Ralvie-logo.svg';

interface Props {
  title?: string;
  theme?: 'dark' | 'light';
  darkScrolledHeader?: boolean;
}

const { title = 'ralvie', theme = 'dark', darkScrolledHeader = false } = Astro.props;

const products = [
  {
    id: 'productivity',
    name: 'Ralvie AI Productivity',
    description: 'Boost productivity with smarter, faster workflows.',
    icon: 'chart-bar',
    href: '/productivity',
    features: [
      { name: 'Automatic tracking', icon: 'target', href: '/productivity/automatic-activity-tracking' },
      { name: 'Time logs', icon: 'clock', href: '/productivity/time-logs' },
      { name: 'Screen captures', icon: 'monitor', href: '/productivity/screen-captures' },
      { name: 'Projects', icon: 'folder', href: '/productivity/projects' },
      { name: 'Tasks', icon: 'list-check', href: '/productivity/tasks' },
      { name: 'Dashboards', icon: 'squares', href: '/productivity/dashboard' },
    ],
  },
  {
    id: 'frontdesk',
    name: 'Ralvie AI Frontdesk',
    description: 'Simplify reception tasks with intelligent automation.',
    icon: 'headset',
    href: '/frontdesk',
    features: [
      { name: 'AI Phone Receptionist', icon: 'phone', href: '/ai-phone-receptionist' },
      { name: 'AI Website Chatbot', icon: 'chat', href: '/ai-website-chatbot' },
      { name: 'AI Email Manager', icon: 'mail', href: '/ai-email-manager' },
      { name: 'AI CRM', icon: 'database', href: '/ai-crm' },
      { name: 'AI Web Voicebot', icon: 'microphone', href: '/ai-web-voicebot' },
      { name: 'Website Forms', icon: 'form', href: '/ai-website-forms' },
    ],
  },
];

const solutions = [
  {
    name: 'Ralvie AI Productivity',
    icon: 'chart-bar',
    useCases: [
      'Employee Productivity',
      'Time Tracking',
      'Project Management',
      'Task Management',
      'Dashboards & Reports',
    ],
    industries: ['Enterprise', 'SaaS', 'Agency', 'Consultancy', 'Professional Services'],
  },
  {
    name: 'Ralvie AI Frontdesk',
    icon: 'headset',
    useCases: [
      '24/7 Customer Support',
      'Capture Leads & Book Appointments',
      'Human-Like AI Call & Chat Handling',
      'Multilingual Support',
      'Smart Call Routing',
    ],
    industries: [
      'Healthcare & Clinics',
      'Hotels & Hospitality',
      'Real estate offices',
      'Education institutions',
      'Financial services',
    ],
  },
];

const signInOptions = [
  { name: 'Ralvie AI Productivity', icon: 'chart-bar', href: 'https://me.ralvie.ai/auth/login', target: '_blank' },
  { name: 'Ralvie AI Frontdesk', icon: 'headset', href: 'https://app.frontdesk.ralvie.ai/login', target: '_blank' },
];

const solutionHref = (item: string) =>
  item === 'Healthcare & Clinics'
    ? '/frontdesk/industries/healthcare-clinics'
    : item === 'Hotels & Hospitality'
      ? '/frontdesk/industries/hotels-hospitality'
    : item === 'Real estate offices'
      ? '/frontdesk/industries/real-estate'
    : item === 'Education institutions'
      ? '/frontdesk/industries/education-institutions'
    : item === 'Financial services'
      ? '/frontdesk/industries/financial-services'
    :
  item === 'Enterprise'
    ? '/productivity/industries/enterprise'
    : item === 'SaaS'
      ? '/productivity/industries/saas'
    : item === 'Agency'
      ? '/productivity/industries/agency'
    : item === 'Consultancy'
      ? '/productivity/industries/consultancy'
    : item === 'Professional Services'
      ? '/productivity/industries/professional-services'
    : item === '24/7 Customer Support'
    ? '/frontdesk/use-cases/24-7-customer-support'
    : item === 'Capture Leads & Book Appointments'
      ? '/frontdesk/use-cases/crm-lead-management'
    : item === 'Human-Like AI Call & Chat Handling'
      ? '/frontdesk/use-cases/human-like-ai-call-chat-handling'
    : item === 'Multilingual Support'
      ? '/frontdesk/use-cases/multilingual-support'
    : item === 'Smart Call Routing'
      ? '/frontdesk/use-cases/smart-call-routing'
    : item === 'Employee Productivity'
    ? '/productivity/use-cases/employee-productivity'
    : item === 'Time Tracking'
      ? '/productivity/use-cases/time-tracking'
      : item === 'Project Management'
        ? '/productivity/use-cases/project-management'
        : item === 'Task Management'
          ? '/productivity/use-cases/task-management'
          : item === 'Dashboards & Reports'
            ? '/productivity/use-cases/dashboards-reports'
        : '#';

const solutionItemIcon = (item: string, category: string) => {
  if (category === 'industries') {
    if (item.includes('Healthcare')) return 'heart';
    if (item.includes('Hotels')) return 'building';
    if (item.includes('Real estate')) return 'home';
    if (item.includes('Education')) return 'academic-cap';
    if (item.includes('Financial')) return 'currency-coin';
    if (item.includes('Consultancy')) return 'chart-bar';
    if (item.includes('Professional Services')) return 'wrench';
    if (item.includes('Enterprise')) return 'briefcase';
    if (item.includes('SaaS')) return 'monitor';
    if (item.includes('Agency')) return 'users';
    if (item.includes('Finance')) return 'currency-coin';
    if (item.includes('Insurance')) return 'shield-check';
    return 'globe';
  }
  if (item.includes('Employee')) return 'users';
  if (item.includes('Time')) return 'clock';
  if (item.includes('Project')) return 'folder';
  if (item.includes('Task')) return 'list-check';
  if (item.includes('Dashboard')) return 'chart-bar';
  if (item.includes('Customer')) return 'headset';
  if (item.includes('Lead')) return 'target';
  if (item.includes('Call')) return 'phone';
  if (item.includes('Multilingual')) return 'globe';
  if (item.includes('Tickets')) return 'list-check';
  if (item.includes('Chat')) return 'chat';
  if (item.includes('Email')) return 'mail';
  return 'sparkles';
};
---

<header
  id="site-header"
  data-theme={theme}
  class:list={[
    'fixed top-0 z-50 w-full border-b border-transparent transition-colors duration-300',
    theme === 'light' && 'header-light',
    darkScrolledHeader && 'header-dark-scrolled',
  ]}
>
  <nav class="site-header-nav container-page flex h-(--header-height) items-center justify-between">
    <a href="/" class="header-brand flex items-center" aria-label={title}>
      <Image
        src={theme === 'light' ? ralvieLogo : ralvieLogoWhite}
        alt={title}
        class="h-8 w-auto"
      />
    </a>

    <div class="hidden items-center justify-center gap-6 lg:flex">
      <div class="relative" data-dropdown>
        <button type="button" data-dropdown-trigger aria-expanded="false" class="nav-trigger">
          Products
          <Icon name="chevron-down" class="h-4 w-4 transition-transform" />
        </button>
        <div data-dropdown-panel class="dropdown-panel mega-wide hidden">
          <div class="mega-products-layout">
            <div class="flex mega-products-main">
            <div class="mega-rail">
              {
                products.map((product, i) => (
                  <button
                    type="button"
                    data-product-tab={product.id}
                    class={`product-tab mega-tab ${i === 0 ? 'is-active' : ''}`}
                  >
                    <span class="icon-frame mega-tab-icon">
                      <Icon name={product.icon} class="h-5 w-5" />
                    </span>
                    <span class="text-body-md font-semibold text-on-surface">{product.name}</span>
                  </button>
                ))
              }
            </div>

            <div class="mega-body mega-product-pane">
              {
                products.map((product, i) => (
                  <div data-product-panel={product.id} class={i === 0 ? '' : 'hidden'}>
                    <a href={product.href} class="mega-head" aria-label={`Explore ${product.name}`}>
                      <div>
                        <h3 class="text-body-lg font-semibold text-on-surface">{product.name}</h3>
                        <p class="text-body-md mega-head-sub text-on-surface-variant">
                          {product.description}
                        </p>
                      </div>
                      <span class="mega-cta" aria-hidden="true">
                        <Icon name="arrow-right" class="h-4 w-4" />
                      </span>
                    </a>

                    <div class="mega-grid">
                      {product.features.map((feature) => (
                        <a href={feature.href} class="mega-item">
                          <span class="mega-item-icon">
                            <Icon name={feature.icon} class="h-4 w-4" />
                          </span>
                          <span class="text-body-md text-on-surface-variant">{feature.name}</span>
                        </a>
                      ))}
                    </div>
                  </div>
                ))
              }
            </div>
            </div>

            <div class="mega-talk-banner">
              <p class="mega-talk-copy">
                <strong>Let&rsquo;s talk!</strong>
                <span>Empower your business with smarter productivity and intelligent customer communication.</span>
              </p>
              <a href="/book-demo" class="mega-talk-button">
                Book a demo
                <Icon name="arrow-right" class="h-4 w-4" />
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="relative" data-dropdown>
        <button type="button" data-dropdown-trigger aria-expanded="false" class="nav-trigger">
          Solutions
          <Icon name="chevron-down" class="h-4 w-4 transition-transform" />
        </button>
        <div data-dropdown-panel class="dropdown-panel mega-wide hidden">
          <div class="mega-products-layout">
            <div class="flex mega-solutions-main">
              <div class="mega-rail mega-solution-rail">
                <button type="button" data-solution-tab="useCases" class="mega-tab solution-tab is-active">
                  <span class="icon-frame mega-tab-icon"><Icon name="squares" class="h-5 w-5" /></span>
                  <span class="text-body-md font-semibold text-on-surface">Use cases</span>
                  <Icon name="arrow-right" class="solution-tab-arrow h-4 w-4" />
                </button>
                <button type="button" data-solution-tab="industries" class="mega-tab solution-tab">
                  <span class="icon-frame mega-tab-icon"><Icon name="folder" class="h-5 w-5" /></span>
                  <span class="text-body-md font-semibold text-on-surface">Industries</span>
                  <Icon name="arrow-right" class="solution-tab-arrow h-4 w-4" />
                </button>
              </div>

              <div class="mega-body mega-product-pane mega-solution-pane">
                {['useCases', 'industries'].map((category, categoryIndex) => (
                  <div data-solution-panel={category} class={categoryIndex === 0 ? 'solution-platforms' : 'solution-platforms hidden'}>
                    {solutions.map((solution) => (
                      <div class="solution-platform">
                        <div class="mega-col-head">
                          <span class="mega-col-icon"><Icon name={solution.icon} class="h-4 w-4" /></span>
                          <span class="solution-platform-title">{solution.name}</span>
                        </div>
                        <p class="solution-category-label">{category === 'useCases' ? 'Use cases' : 'Industries'}</p>
                        <ul class="mega-list solution-list">
                          {(category === 'useCases' ? solution.useCases : solution.industries).map((item) => (
                            <li>
                              <a href={solutionHref(item)}>
                                <span class="solution-item-icon">
                                  <Icon name={solutionItemIcon(item, category)} class="h-4 w-4" />
                                </span>
                                <span>{item}</span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                ))}
              </div>
            </div>

            <div class="mega-talk-banner">
              <p class="mega-talk-copy">
                <strong>Let&rsquo;s talk!</strong>
                <span>Empower your business with smarter productivity and intelligent customer communication.</span>
              </p>
              <a href="/book-demo" class="mega-talk-button">
                Book a demo
                <Icon name="arrow-right" class="h-4 w-4" />
              </a>
            </div>
          </div>
        </div>
      </div>

      <a href="/pricing" class="nav-trigger">Pricing</a>
      <a href="/contact" class="nav-trigger">Contact us</a>
    </div>

    <div class="hidden items-center gap-4 lg:flex">
      <div class="relative" data-dropdown>
        <button type="button" data-dropdown-trigger aria-expanded="false" class="nav-trigger">
          Sign in
          <Icon name="chevron-down" class="h-4 w-4 transition-transform" />
        </button>
        <div data-dropdown-panel class="dropdown-panel mega-menu hidden right-0 left-auto w-64">
          <p class="text-label-sm mega-menu-label text-on-surface-variant/70">Sign in to</p>
          {
            signInOptions.map((item) => (
              <a href={item.href} target={item.target} rel={item.target ? 'noopener noreferrer' : undefined} class="mega-item">
                <span class="mega-item-icon">
                  <Icon name={item.icon} class="h-4 w-4" />
                </span>
                <span class="text-body-md text-on-surface">{item.name}</span>
              </a>
            ))
          }
        </div>
      </div>

      <a href="/book-demo" class="btn-primary header-demo-button px-6! py-2! text-sm">Book a demo</a>
    </div>

    <button
      type="button"
      class="mobile-menu-trigger text-on-surface lg:hidden"
      data-mobile-menu-trigger
      aria-label="Open menu"
      aria-controls="mobile-site-menu"
      aria-expanded="false"
    >
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </nav>
  <div id="mobile-site-menu" class="mobile-site-menu lg:hidden" data-mobile-menu hidden>
    {products.map((product) => (
      <details class="mobile-menu-group">
        <summary>
          <span>{product.name}</span>
          <Icon name="chevron-down" class="h-4 w-4" />
        </summary>
        <div class="mobile-menu-list">
          <a href={product.href}>Overview</a>
          {product.features.map((feature) => <a href={feature.href}>{feature.name}</a>)}
        </div>
      </details>
    ))}
    <a href="/pricing">Pricing</a>
    <a href="/contact">Contact us</a>
    <a href="/book-demo" class="mobile-menu-demo">Book a demo</a>
  </div>
</header>

<style>
  #site-header {
    z-index: 1000;
    padding: 0;
    background: transparent;
    transition: padding 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .site-header-nav {
    width: min(76.25rem, calc(100% - 2.5rem));
    border: 1px solid transparent;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    transition:
      width 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      height 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      padding 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.3s ease,
      border-radius 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.3s ease,
      box-shadow 0.3s ease,
      backdrop-filter 0.3s ease;
  }
  #site-header.is-scrolled {
    padding-top: 0.75rem;
  }
  #site-header.is-scrolled .site-header-nav {
    width: min(76.25rem, calc(100% - 2rem));
    height: calc(var(--header-height) - 0.5rem);
    padding-inline: clamp(1rem, 2.2vw, 2rem);
    border-color: rgba(255, 255, 255, 0.78);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.76);
    box-shadow: 0 18px 46px rgba(45, 50, 100, 0.15), inset 0 1px rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(22px) saturate(135%);
    -webkit-backdrop-filter: blur(22px) saturate(135%);
  }
  .header-brand,
  .header-brand img {
    border: 0 !important;
    outline: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    border-radius: 0 !important;
  }
  #site-header.header-dark-scrolled.is-scrolled .site-header-nav {
    border-color: rgba(157, 171, 255, 0.28);
    background: rgba(9, 14, 43, 0.86);
    box-shadow: 0 18px 46px rgba(2, 5, 24, 0.42), inset 0 1px rgba(255, 255, 255, 0.08);
  }
  .header-demo-button {
    background: linear-gradient(100deg, #4568f5 0%, #7659e8 100%);
    box-shadow: 0 12px 28px rgba(78, 89, 228, 0.28);
  }
  .header-demo-button:hover {
    background: linear-gradient(100deg, #3f60eb 0%, #6f51dc);
  }
  @media (max-width: 640px) {
    .site-header-nav { width: calc(100% - 1rem); }
    #site-header.is-scrolled { padding-top: 0.5rem; }
    #site-header.is-scrolled .site-header-nav {
      width: calc(100% - 1rem);
      padding-inline: 1rem;
    }
    .mobile-site-menu {
      position: fixed;
      z-index: 1001;
      top: calc(var(--header-height) - 0.2rem);
      right: 0.5rem;
      left: 0.5rem;
      display: grid;
      gap: 0.25rem;
      padding: 0.75rem;
      border: 1px solid rgba(255, 255, 255, 0.78);
      border-radius: 1rem;
      background: rgba(255, 255, 255, 0.96);
      box-shadow: 0 22px 48px rgba(25, 32, 77, 0.2);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
    }
    .mobile-site-menu[hidden] { display: none; }
    .mobile-menu-group {
      border-radius: 0.7rem;
    }
    .mobile-menu-group summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.8rem 0.9rem;
      border-radius: 0.7rem;
      color: #17204a;
      cursor: pointer;
      font-size: 0.95rem;
      font-weight: 700;
      list-style: none;
    }
    .mobile-menu-group summary::-webkit-details-marker { display: none; }
    .mobile-menu-group summary svg { transition: transform 0.2s ease; }
    .mobile-menu-group[open] summary { background: #f0f3ff; }
    .mobile-menu-group[open] summary svg { transform: rotate(180deg); }
    .mobile-menu-list {
      display: grid;
      gap: 0.15rem;
      padding: 0.25rem 0 0.45rem 0.6rem;
    }
    .mobile-site-menu .mobile-menu-list a {
      padding: 0.6rem 0.9rem;
      color: #59617d;
      font-size: 0.85rem;
      font-weight: 600;
    }
    .mobile-site-menu a {
      padding: 0.8rem 0.9rem;
      border-radius: 0.7rem;
      color: #17204a;
      font-size: 0.95rem;
      font-weight: 700;
    }
    .mobile-site-menu a:hover { background: #f0f3ff; }
    .mobile-site-menu .mobile-menu-demo {
      margin-top: 0.25rem;
      background: linear-gradient(135deg, #4666f3, #7b63e8);
      color: #fff;
      text-align: center;
    }
  }
  .header-light {
    --color-on-surface: #17204a;
    --color-on-surface-variant: #59617d;
    --color-surface-container-low: #fefaff;
    --color-surface-container: #f7f8ff;
    --color-surface-container-high: #edf0ff;
    --color-outline-variant: rgba(39, 48, 97, 0.12);
  }
  .nav-trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs); /* 4px — label ↔ chevron */
    border-radius: var(--radius-full);
    padding: var(--space-xs) var(--space-sm); /* 8px 12px */
    font-family: var(--font-label);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-on-surface-variant);
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }
  .nav-trigger:hover {
    color: var(--color-on-surface);
  }
  [data-dropdown-trigger][aria-expanded='true'] {
    background-color: var(--color-surface-container-high);
    color: var(--color-on-surface);
  }
  [data-dropdown-trigger][aria-expanded='true'] :global(svg) {
    transform: rotate(180deg);
  }
  [data-dropdown]:hover > [data-dropdown-trigger] :global(svg) {
    transform: rotate(180deg);
  }
  [data-dropdown] > [data-dropdown-trigger] :global(svg) {
    transition: transform 0.2s ease;
  }

  .dropdown-panel {
    position: absolute;
    left: 0;
    top: calc(100% + 0.75rem);
    background:
      radial-gradient(
        circle at 8% 8%,
        color-mix(in srgb, var(--color-primary) 11%, transparent),
        transparent 32%
      ),
      radial-gradient(
        circle at 88% 4%,
        color-mix(in srgb, var(--color-secondary) 13%, transparent),
        transparent 35%
      ),
      radial-gradient(
        circle at 72% 100%,
        color-mix(in srgb, #36d9ff 8%, transparent),
        transparent 38%
      ),
      var(--color-surface-container-low);
    border: 1px solid var(--color-outline-variant);
    border-top-color: color-mix(in srgb, var(--color-on-surface) 18%, transparent);
    border-radius: var(--radius-lg);
    box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(28px) saturate(125%);
    -webkit-backdrop-filter: blur(28px) saturate(125%);
  }
  .mega-wide {
    position: fixed;
    top: calc(var(--header-height) + 0.75rem);
    left: 50%;
    width: min(74rem, calc(100vw - 3rem));
    transform: translateX(-50%);
  }
  .mega-products-layout {
    padding: 0.75rem;
  }
  .mega-products-main {
    min-height: 23rem;
  }
  .mega-solutions-main {
    min-height: 22rem;
  }
  .header-light .dropdown-panel {
    background: radial-gradient(circle at 88% 10%, #fdfdff 0 18%, transparent 48%), #ffffff;
  }

  /* Mega menu runs a notch smaller than the rest of the type scale */
  .dropdown-panel .text-body-lg {
    font-size: 1rem; /* 18px -> 16px */
  }
  .dropdown-panel .text-body-md {
    font-size: 0.875rem; /* 16px -> 14px */
  }
  .dropdown-panel .text-label-sm {
    font-size: 0.6875rem; /* 12px -> 11px */
  }

  /* ==========================================================
     Mega menu — every value maps to the --space-* scale
     ========================================================== */

  /* Left rail: 288px wide, 12px inset, 4px between tabs */
  .mega-rail {
    width: 20rem;
    flex-shrink: 0;
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  /* Rail tab: 12px inset, 12px icon↔label */
  .mega-tab {
    display: flex;
    width: 100%;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md);
    border-radius: var(--radius-md);
    text-align: left;
    transition: background-color 0.2s ease;
  }
  .mega-tab:hover {
    background-color: var(--color-surface-container-high);
  }
  .mega-tab-icon {
    display: flex;
    height: 2.5rem;
    width: 2.5rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    background-color: var(--color-surface-container-high);
    color: var(--color-on-surface-variant);
  }

  /* Right pane: 24px inset */
  .mega-body {
    flex: 1;
    padding: 2rem;
  }
  .mega-product-pane {
    margin-left: 0.75rem;
    border: 1px solid rgba(120, 131, 238, 0.28);
    border-radius: calc(var(--radius-lg) - 0.15rem);
    background:
      radial-gradient(circle at 6% 8%, rgba(226, 216, 255, 0.46), transparent 38%),
