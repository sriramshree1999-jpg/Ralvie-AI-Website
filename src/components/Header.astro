      radial-gradient(circle at 92% 10%, rgba(218, 227, 255, 0.5), transparent 42%),
      radial-gradient(circle at 55% 108%, rgba(221, 243, 255, 0.42), transparent 46%),
      linear-gradient(145deg, rgba(251, 249, 255, 0.99), rgba(245, 248, 255, 0.99));
  }
