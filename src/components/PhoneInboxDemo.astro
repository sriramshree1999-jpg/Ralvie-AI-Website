---
const channels = [['all','All Inbox'],['calls','Calls'],['voicemails','Voicemails'],['manual','Manual Calls'],['omnichannel','Omnichannel'],['chatbot','Chatbot']];
---
<div class="inbox reveal" data-inbox>
  <nav>{channels.map(([id,label],i)=><button class:list={[i===0&&'active']} data-channel={id} type="button">{id==='chatbot'?<svg class="tab-chat-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5.5h14v10H9l-4 3v-13Z"/><path d="M8 9h8M8 12h5"/></svg>:id==='calls'?'☎ ':id==='voicemails'?'◉ ':id==='manual'?'↗ ':id==='omnichannel'?'◌ ':''}{label}{['all','calls','chatbot'].includes(id)&&<i></i>}</button>)}</nav>
  <div class="body">
    <aside>
      <label class="search">⌕<input disabled placeholder="Search all logs…" /></label>
      <div class="items" data-items></div>
    </aside>
    <section>
      <header><div><strong data-name>Daniel Carter</strong><p data-meta></p></div><button disabled>⌯<small>Share</small></button></header>
      <div class="tabs"><button class="active" disabled>Recording &amp; Transcript</button><button disabled>Summary &amp; Analysis</button><button disabled>Smart Call Analysis</button></div>
      <div data-content></div>
    </section>
  </div>
</div>
<script>
const data={
 all:[['Daniel Carter','Call completed','8/4/2026, 12:50 PM'],['Ethan Walker','Chat · Asked about integrations','8/4/2026, 10:18 AM'],['Emma Thompson','Voicemail · Callback requested','8/3/2026, 5:16 PM'],['Ryan Cooper','Manual call · Demo follow-up','8/3/2026, 8:11 PM'],['Olivia Martin','SMS · Pricing and availability','7/30/2026, 6:40 AM'],['Amelia Scott','Email · Support request','7/29/2026, 3:22 PM']],
 calls:[['Ryan Cooper','Inbound call · 4m 12s','8/3/2026, 8:11 PM'],['Michael Brooks','Call completed · 2m 48s','7/30/2026, 6:40 AM'],['Ashley Miller','Transferred to sales · 6m 04s','7/29/2026, 4:18 PM']],
 voicemails:[['David Chen','New voicemail · 0m 42s','Today, 9:24 AM'],['Emma Thompson','Callback requested · 1m 08s','Yesterday, 5:16 PM'],['Sarah Wilson','Service enquiry · 0m 37s','Jul 28, 11:02 AM'],['Noah Williams','Pricing enquiry · 0m 54s','Jul 27, 4:38 PM'],['Grace Kim','Appointment change · 1m 16s','Jul 26, 10:15 AM']],
 manual:[['Maya Patel','Outbound follow-up · Completed','Today, 10:45 AM'],['Robert James','Sales callback · No answer','Yesterday, 3:30 PM'],['Elena Garcia','Appointment confirmation','Jul 30, 1:05 PM'],['Henry Clark','Demo follow-up · Completed','Jul 29, 11:40 AM']],
 omnichannel:[['Living Water Resorts','Email · Booking enquiry','Today, 11:17 AM'],['Jordan Lee','SMS · Product question','Today, 8:52 AM'],['Ava Robinson','Web voice · Qualified','Yesterday, 6:03 PM'],['Mason Hall','Chat · Integration enquiry','Yesterday, 2:46 PM'],['Chloe Adams','Call · Transferred to support','Jul 30, 9:14 AM'],['Liam Mitchell','Voicemail · Follow-up requested','Jul 29, 4:37 PM']],
 chatbot:[['Ethan Walker','Asked about integrations','Today, 12:08 PM'],['Isabella Moore','Requested a product demo','Today, 9:42 AM'],['Lucas Anderson','Support question resolved','Yesterday, 7:31 PM'],['Mia Harris','Asked about multilingual support','Yesterday, 4:18 PM'],['Benjamin Young','Pricing question answered','Jul 30, 2:06 PM']]
};
const numbers={all:['+1 (801) 784-1398','Chat ID #RC-1048','+1 (801) 784-1398','+1 (647) 555-0182','SMS · +1 (437) 555-0180','Email · amelia@example.com'],calls:['+1 (647) 555-0143','+1 (905) 555-0188','+1 (416) 555-0171'],voicemails:['+1 (289) 555-0134','+1 (801) 784-1398','+1 (647) 555-0196','+1 (416) 555-0178','+1 (905) 555-0124'],manual:['+1 (416) 555-0157','+1 (905) 555-0119','+1 (647) 555-0164','+1 (289) 555-0185'],omnichannel:['Email · booking@livingwater.ca','SMS · +1 (437) 555-0180','Web voice · Session #7392','Chat ID #RC-1074','+1 (416) 555-0191','+1 (289) 555-0176'],chatbot:['Chat ID #RC-1048','Chat ID #RC-1052','Chat ID #RC-1039','Chat ID #RC-1061','Chat ID #RC-1068']};
const kinds={all:['call','chat','voicemail','manual','sms','email'],calls:['call','call','call'],voicemails:['voicemail','voicemail','voicemail','voicemail','voicemail'],manual:['manual','manual','manual','manual'],omnichannel:['email','sms','voice','chat','call','voicemail'],chatbot:['chat','chat','chat','chat','chat']};
const topic={
 all:[`Hi! This is Ralvie AI Frontdesk. How can I help you today?`,`Can you tell me about the Ralvie AI Frontdesk solution?`,`Ralvie answers every call, books appointments, handles enquiries 24/7, and integrates with your business tools.`,`How would it work for my business?`],
 calls:[`Thanks for calling Northstar Dental. How may I help?`,`I need to reschedule my appointment for Friday.`,`I found an opening Monday at 10:30 AM. Would you like me to move your appointment?`,`Yes, Monday works perfectly.`],
 voicemails:[`You have reached Ralvie-powered reception. Please leave your message.`,`Hi, this is David. Could someone call me about the enterprise plan?`,`Your request has been captured and routed to the sales team for a priority callback.`,`Callback requested · Contact details verified.`],
 manual:[`Hi Maya, I’m following up on your product demonstration request.`,`Yes, I would like to see the appointment booking workflow.`,`Great. I can schedule a tailored demo with our product specialist tomorrow at 2 PM.`,`Please book that time for me.`],
 omnichannel:[`Your booking enquiry moved from email to this conversation seamlessly.`,`Can you confirm availability for two rooms this weekend?`,`Two rooms are available. I’ve also sent the rates and booking link by SMS.`,`Perfect, I received the text.`],
 chatbot:[`Welcome! I’m Ralvie’s AI assistant. What would you like to explore?`,`Does Ralvie connect with our CRM and calendar?`,`Yes. Ralvie connects with CRMs, calendars, APIs, webhooks, and supported business systems.`,`I’d like to request an integration demo.`]
};
const transcript=(lines)=>`<div class="recording"><button disabled>▷</button><b>${lines[3].includes('Callback')?'Voicemail Recording':'Call Recording & Transcript'}</b></div><div class="messages"><p class="ai">${lines[0]}<b>AI</b></p><p>${lines[1]}</p><p class="ai">${lines[2]}<b>AI</b></p><p>${lines[3]}</p></div>`;
document.querySelectorAll('[data-inbox]').forEach(root=>{let channel='all';const items=root.querySelector('[data-items]'),name=root.querySelector('[data-name]'),meta=root.querySelector('[data-meta]'),content=root.querySelector('[data-content]');const chatIcon='<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5.5h14v10H9l-4 3v-13Z"/><path d="M8 9h8M8 12h5"/></svg>';const render=()=>{const rows=data[channel];items.dataset.channel=channel;items.innerHTML=rows.map((r,i)=>{const kind=kinds[channel][i],icon=kind==='chat'?chatIcon:kind==='voicemail'?'◉':kind==='email'?'✉':kind==='sms'?'SMS':kind==='voice'?'◌':kind==='manual'?'↗':'☎',badge=kind==='chat'?'Web chat':kind==='email'?'Email':kind==='sms'?'SMS':kind==='voice'?'Web voice':kind==='voicemail'?'Voicemail':kind==='manual'?'Outbound':'↓ Inbound';return `<div class="item ${i?'':'selected'}"><em class="kind-${kind}">${icon}</em><span><b>${r[0]}</b><small>${r[2]}</small><p class="number">${numbers[channel][i]}</p><p>${r[1]}</p></span><mark>${badge}</mark></div>`}).join('');name.textContent=rows[0][0];meta.textContent=`${numbers[channel][0]} · ${rows[0][1]} · ${rows[0][2]}`;content.innerHTML=transcript(topic[channel])};root.querySelectorAll('[data-channel]').forEach(b=>b.onclick=()=>{root.querySelector('[data-channel].active')?.classList.remove('active');b.classList.add('active');channel=b.dataset.channel;render()});render()});
</script>
<style is:global>
.inbox{position:relative;overflow:hidden;border:1px solid rgba(255,255,255,.9);border-radius:26px;background:rgba(255,255,255,.7);box-shadow:0 35px 90px rgba(48,62,120,.17),inset 0 1px 0 #fff;color:#17203b;text-align:left;backdrop-filter:blur(24px)}.inbox:before{content:"";position:absolute;z-index:-1;inset:-30%;background:radial-gradient(circle at 12% 5%,rgba(103,151,255,.2),transparent 25%),radial-gradient(circle at 88% 88%,rgba(163,111,244,.16),transparent 28%)}.inbox>nav{display:flex;gap:7px;min-height:74px;align-items:center;padding:10px 14px;border-bottom:1px solid rgba(65,79,137,.1);overflow:auto;background:rgba(255,255,255,.4)}.inbox>nav button{display:flex;align-items:center;gap:8px;padding:13px 18px;border:1px solid transparent;border-radius:999px;white-space:nowrap;font-size:12px;font-weight:700;color:#59627a;transition:.2s}.inbox>nav button:hover{color:#3555c8;background:rgba(238,242,255,.7)}.inbox>nav button.active{color:#344fc2;border-color:rgba(80,105,215,.13);background:linear-gradient(135deg,rgba(230,238,255,.95),rgba(243,235,255,.9));box-shadow:0 8px 22px rgba(73,91,172,.1)}.inbox>nav i{width:7px;height:7px;background:#f04c65;border-radius:50%;box-shadow:0 0 0 4px rgba(240,76,101,.09)}.body{display:grid;grid-template-columns:330px 1fr;height:590px}.body>aside{border-right:1px solid rgba(65,79,137,.1);overflow:hidden;background:rgba(249,250,255,.48)}.actions{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;padding:14px 10px}.actions button{display:grid;place-items:center;min-height:60px;border:1px solid rgba(74,89,151,.07);border-radius:14px;background:rgba(244,246,252,.82);color:#58627b;transition:.2s}.actions button:hover{transform:translateY(-1px);background:#eef2ff;color:#4160cf}.actions small{font-size:10px}.search{display:flex;align-items:center;gap:10px;margin:0 10px 12px;padding:12px 15px;border:1px solid rgba(67,82,143,.13);border-radius:99px;background:rgba(255,255,255,.72);box-shadow:inset 0 1px #fff;color:#7b8498}.search input{width:100%;outline:0;background:transparent;font-size:12px}.items{height:470px;overflow:auto;border-top:1px solid rgba(65,79,137,.09)}.item{position:relative;display:grid;width:100%;grid-template-columns:39px minmax(0,1fr);gap:10px;padding:13px 12px;text-align:left;border-bottom:1px solid rgba(65,79,137,.08);transition:.2s}.item:hover{background:rgba(240,244,255,.65)}.item.selected{background:linear-gradient(90deg,rgba(229,237,255,.92),rgba(247,245,255,.7));box-shadow:inset 4px 0 #5b74ee}.item em{display:grid;width:38px;height:38px;place-items:center;border-radius:12px;background:linear-gradient(145deg,#24d397,#0dbd70);box-shadow:0 8px 18px rgba(19,190,115,.2);color:#fff;font-style:normal}.item span{min-width:0}.item span>b{font-size:12px;color:#25304a}.item small{float:right;font-size:8px;color:#8991a4}.item p{margin-top:7px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:10px;color:#697389}.item mark{position:absolute;right:11px;bottom:8px;padding:2px 6px;border-radius:99px;background:#eaf8f1;color:#1f9561;font-size:7px}.empty{padding:30px;text-align:center;color:#828ba0}.body>section{min-width:0;background:rgba(255,255,255,.42)}.body header{height:72px;display:flex;align-items:center;justify-content:space-between;padding:10px 20px;border-bottom:1px solid rgba(65,79,137,.09)}.body header strong{font-size:14px}.body header p{margin-top:3px;font-size:9px;color:#7d869b}.body header button{display:grid;place-items:center;color:#697386}.body header small{font-size:8px}.tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:5px;margin:12px 16px;padding:5px;background:rgba(235,238,246,.74);border:1px solid rgba(255,255,255,.8);border-radius:13px}.tabs button{padding:10px;border-radius:9px;font-size:10px;font-weight:750;color:#536078;transition:.2s}.tabs button.active{background:linear-gradient(135deg,#315ee9,#756cf4);box-shadow:0 8px 20px rgba(59,80,210,.2);color:#fff}.body section>[data-content]{padding:0 16px}.recording{display:flex;align-items:center;gap:13px;padding:14px;border:1px solid rgba(65,79,137,.1);border-radius:13px;background:rgba(255,255,255,.68);box-shadow:0 8px 25px rgba(55,67,119,.05)}.recording button{width:44px;height:44px;border-radius:11px;background:linear-gradient(135deg,#346cec,#6a68ef);box-shadow:0 9px 22px rgba(55,87,218,.22);color:#fff}.recording b{font-size:12px}.messages{display:flex;height:385px;flex-direction:column;gap:14px;margin-top:14px;padding:18px;overflow:auto;border:1px solid rgba(255,255,255,.75);border-radius:14px;background:linear-gradient(145deg,rgba(238,242,250,.83),rgba(245,240,252,.75))}.messages p{position:relative;max-width:68%;padding:12px 14px;border:1px solid rgba(255,255,255,.9);border-radius:13px;background:rgba(255,255,255,.88);box-shadow:0 6px 18px rgba(55,68,118,.06);font-size:11px;line-height:1.5}.messages .ai{align-self:flex-end;border:0;background:linear-gradient(135deg,#3166e8,#6568ef);box-shadow:0 10px 24px rgba(54,80,206,.18);color:#fff}.messages .ai b{position:absolute;right:-34px;top:0;padding:6px;border-radius:8px;background:#4267e7;font-size:8px}.panel{margin-top:14px;padding:28px;border:1px solid rgba(65,79,137,.1);border-radius:15px;background:rgba(255,255,255,.68);box-shadow:0 12px 30px rgba(55,67,119,.06)}.panel>span{color:#536ad8;font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.12em}.panel h4{margin:10px 0;font-size:19px}.panel>p{color:#6c7588;font-size:11px;line-height:1.8}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:25px}.cards div{padding:17px;border:1px solid rgba(255,255,255,.9);border-radius:13px;background:linear-gradient(145deg,#f1f5ff,#f7f2ff);font-size:9px;color:#7a8499}.cards b{display:block;margin-top:6px;font-size:11px;color:#293650}.scores{display:grid;gap:18px;margin-top:28px}.scores label{display:grid;grid-template-columns:100px 1fr 35px;align-items:center;gap:12px;font-size:10px}.scores i{height:8px;border-radius:8px;background:linear-gradient(90deg,#5576ed var(--s),#e8ebf2 var(--s))}
@media(max-width:800px){.body{grid-template-columns:1fr;height:auto}.body>aside{border-right:0}.items{height:260px}.body>section{border-top:1px solid #ddd}.messages{height:320px}.cards{grid-template-columns:1fr}.inbox{border-radius:16px}}
.inbox>nav button:hover{color:#59627a;background:transparent}.inbox>nav button.active:hover{color:#344fc2;background:linear-gradient(135deg,rgba(230,238,255,.95),rgba(243,235,255,.9))}.actions button:hover{transform:none;background:rgba(244,246,252,.82);color:#58627b}.item:hover{background:transparent}.item.selected:hover{background:linear-gradient(90deg,rgba(229,237,255,.92),rgba(247,245,255,.7))}.item .number{margin-top:4px;color:#4e5c79;font-size:9px}
.inbox>nav{flex-wrap:wrap;overflow-x:hidden}.messages{overflow:hidden;padding-right:20px}.messages .ai{max-width:calc(68% - 38px);margin-right:38px}.messages .ai b{right:-34px}.body,.body>section,.body section>[data-content]{max-width:100%;overflow-x:hidden}
.inbox,.inbox *{scrollbar-width:none}.inbox::-webkit-scrollbar,.inbox *::-webkit-scrollbar{display:none;width:0;height:0}.body,.body>section,.body section>[data-content]{overflow:hidden}
.body>aside>.search{margin-top:14px}.items{height:525px;overflow:hidden}
.item em svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.item em.kind-email{background:linear-gradient(145deg,#8b6df2,#665ee9)}.item em.kind-sms{background:linear-gradient(145deg,#28bde9,#427ce9);font-size:8px;font-weight:800}.item em.kind-voice{background:linear-gradient(145deg,#ec7eb9,#9a64e8)}.item em.kind-manual{background:linear-gradient(145deg,#f0a256,#e26c78)}
.items[data-channel="all"] .item,.items[data-channel="omnichannel"] .item{min-height:105px}
.tab-chat-icon{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
@media(max-width:800px){.inbox>nav{justify-content:flex-start}.items{height:260px}.messages .ai{max-width:calc(82% - 34px);margin-right:34px}.messages p{max-width:82%}}
</style>
