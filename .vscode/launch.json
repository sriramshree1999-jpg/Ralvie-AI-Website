{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Astro Dev Server",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm",
      "args": ["run", "dev"],
      "isBackground": true
    },
    {
      "name": "Chrome - Attach",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "pathMapping": {
        "/": "${workspaceRoot}/",
        "/src/": "${workspaceRoot}/src/"
      }
    }
  ]
}
